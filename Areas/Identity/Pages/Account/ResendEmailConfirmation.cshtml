@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "إعادة إرسال رسالة التأكيد";
}
<section class="zh-page">
    <div class="zh-auth-form">
        <div class="zh-card zh-auth-card text-center">
            <div class="zh-empty p-0 mb-2"><div class="icon" style="color:#1D7AA8"><i class="bi bi-arrow-repeat"></i></div></div>
            <h1>إعادة إرسال رسالة التأكيد</h1>
            <p class="lead">أدخل بريدك الإلكتروني وسنرسل لك رابط تأكيد جديد.</p>
            <form method="post" class="text-start" novalidate>
                <div asp-validation-summary="All" class="zh-alert zh-alert-danger mb-3 empty-hide" role="alert"></div>
                <div class="zh-field">
                    <label class="zh-label" asp-for="Input.Email">البريد الإلكتروني</label>
                    <input asp-for="Input.Email" class="zh-input zh-ltr" autofocus placeholder="name@example.com" />
                </div>
                <button type="submit" class="zh-btn zh-btn-primary zh-btn-block" style="padding:.85rem"><i class="bi bi-send-fill"></i> إرسال</button>
            </form>
            <p class="mt-4 mb-0"><a asp-page="./Login" class="fw-bold text-decoration-none" style="color:var(--zh-emerald-700)"><i class="bi bi-arrow-right"></i> العودة لتسجيل الدخول</a></p>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AuthScripts" />
}