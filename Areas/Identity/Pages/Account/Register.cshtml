@page
@using ZekrHakeem_v11.Resources
@model RegisterModel
@{
    ViewData["Title"] = "انشاء حساب جديد";
}

<section class="login-page mb-4" id="registerfrm" style="background-image: linear-gradient(to bottom , #FBF8EF, #B1F0F7);">
    <div class="login-wrapper">
        <div class="login-card">
            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <div class="text-center mb-4">
                    <img src="~/images/zekr.png"
                         alt="zh"
                         style="height:120px;width:120px;object-fit:contain"
                         class="mx-auto d-block" />

                    <h2 class="mt-2">@ResourceApp_Ar.Register_MainLoginTitle_lbl</h2>
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert"></div>

                <!-- Full Name -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.FullName"
                           id="FullName"
                           class="form-control"
                           placeholder=" "
                           autocomplete="name" autofocus/>
                    <label dir="rtl">
                        @ResourceApp_Ar.Register_FullName_lbl
                    </label>
                </div>
                <span asp-validation-for="Input.FullName" class="text-danger"></span>

                <!-- Identity Number -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.IdentityNum"
                           id="IdentityNum"
                           class="form-control"
                           placeholder=" " />
                    <label dir="rtl">
                        @ResourceApp_Ar.Register_IdentityNum_lbl
                    </label>
                </div>
                <span asp-validation-for="Input.IdentityNum" class="text-danger"></span>

                <!-- Phone Number -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.PhoneNumber"
                           id="PhoneNumber"
                           class="form-control"
                           placeholder=" "
                           autocomplete="tel" />
                    <label dir="rtl">
                        @ResourceApp_Ar.Register_PhoneNum_lbl
                    </label>
                </div>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>

                <!-- Gender -->
                <div class="form-floating mb-3">
                    <select asp-for="Input.Gender"
                            id="Gender"
                            class="form-select text-center">
                        <option value="" disabled selected></option>
                        <option value="male">ذكــر</option>
                        <option value="female">أنثـى</option>
                    </select>
                    <label dir="rtl">
                        @ResourceApp_Ar.Register_Gender_lbl
                    </label>
                </div>
                <span asp-validation-for="Input.Gender" class="text-danger"></span>

                <!-- Email -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           id="Email"
                           class="form-control"
                           placeholder=" "
                           autocomplete="email" />
                    <label dir="rtl">
                        @ResourceApp_Ar.Register_Email_lbl
                    </label>
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>

                <!-- Password -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password"
                           id="Password"
                           type="password"
                           class="form-control"
                           placeholder=" "
                           autocomplete="new-password" />
                    <label dir="rtl">
                        @ResourceApp_Ar.Register_Password_lbl
                    </label>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <!-- Confirm Password -->
                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword"
                           id="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder=" "
                           autocomplete="new-password" />
                    <label dir="rtl">
                        @ResourceApp_Ar.Register_ConfirmPassword_lbl
                    </label>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

                <button type="submit"
                        class="btn btn-login w-100">
                    @ResourceApp_Ar.Register_btn
                </button>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener("load", () => {
            const input = document.getElementById("FullName");
            setTimeout(() => {
                input.focus();
                input.select();
            }, 100);
        });
    </script>
}
<style>

    /* Page */
    .login-page {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    /* Wrapper */
    .login-wrapper {
        position: relative;
        z-index: 3;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    /* Card */
    .login-card {
        direction: rtl;
        text-align: right;
        background: #fff;
        width: 100%;
        max-width: 460px;
        padding: 2rem;
        border-radius: 14px;
        border: 1px solid #e6e8eb;
        box-shadow: 0 20px 40px rgba(0,0,0,.15), 0 2px 8px rgba(0,0,0,.08);
        animation: slideFade .45s ease-out;
    }

    /* Fields */
    .auth-field {
        margin-bottom: 1rem;
    }

    .form-control,
    .form-select {
        height: 46px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #328E6E;
            box-shadow: 0 0 0 .15rem rgba(50,142,110,.25);
        }

    /* Button */
    .btn-login {
        background-color: #328E6E;
        color: #fff;
        border: none;
        padding: .6rem;
        font-weight: 600;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .btn-login:hover {
            box-shadow: 0 8px 18px rgba(0,0,0,.15);
        }

        .btn-login:active {
            transform: scale(.97);
        }

   
   
</style>