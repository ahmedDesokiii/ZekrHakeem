@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "تم تغيير كلمة المرور";
}
<section class="zh-page">
    <div class="zh-auth-form">
        <div class="zh-card zh-auth-card text-center">
            <div class="zh-empty p-0 mb-2"><div class="icon" style="color:#15B392"><i class="bi bi-patch-check-fill"></i></div></div>
            <h1>تم تغيير كلمة المرور</h1>
            <p class="lead">يمكنك الآن تسجيل الدخول بكلمة المرور الجديدة.</p>
            <a asp-page="./Login" class="zh-btn zh-btn-primary"><i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول</a>
        </div>
    </div>
</section>
