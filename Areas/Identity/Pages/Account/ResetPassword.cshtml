@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "تعيين كلمة مرور جديدة";
}
<section class="zh-page">
    <div class="zh-auth-form">
        <div class="zh-card zh-auth-card text-center">
            <div class="zh-empty p-0 mb-2"><div class="icon" style="color:#0F5E4F"><i class="bi bi-shield-lock-fill"></i></div></div>
            <h1>كلمة مرور جديدة</h1>
            <p class="lead">اختر كلمة مرور قوية لم تستخدمها من قبل.</p>
            <form method="post" class="text-start" novalidate>
                <div asp-validation-summary="ModelOnly" class="zh-alert zh-alert-danger mb-3 empty-hide" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                <div class="zh-field">
                    <label class="zh-label" asp-for="Input.Email">البريد الإلكتروني</label>
                    <input asp-for="Input.Email" class="zh-input zh-ltr" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="zh-field">
                    <label class="zh-label" asp-for="Input.Password">كلمة المرور الجديدة</label>
                    <div class="zh-input-group">
                        <input asp-for="Input.Password" class="zh-input zh-ltr" autocomplete="new-password" data-strength />
                        <button type="button" class="zh-input-action" data-toggle-pw aria-label="إظهار"><i class="bi bi-eye"></i></button>
                    </div>
                    <div class="zh-strength" id="pwStrength"><span></span><span></span><span></span><span></span></div>
                    <div class="zh-pw-rules">
                        <span data-rule="len"><i class="bi bi-circle"></i> 6 خانات على الأقل</span>
                        <span data-rule="upper"><i class="bi bi-circle"></i> حرف إنجليزي كبير</span>
                        <span data-rule="lower"><i class="bi bi-circle"></i> حرف إنجليزي صغير</span>
                        <span data-rule="digit"><i class="bi bi-circle"></i> رقم</span>
                        <span data-rule="sym"><i class="bi bi-circle"></i> رمز مثل $ @@ #</span>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="zh-field">
                    <label class="zh-label" asp-for="Input.ConfirmPassword">تأكيد كلمة المرور</label>
                    <input asp-for="Input.ConfirmPassword" class="zh-input zh-ltr" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="zh-btn zh-btn-primary zh-btn-block" style="padding:.85rem"><i class="bi bi-check2-circle"></i> حفظ كلمة المرور</button>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AuthScripts" />
}