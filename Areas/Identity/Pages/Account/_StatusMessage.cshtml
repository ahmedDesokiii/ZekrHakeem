@model string
@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error") || Model.StartsWith("خطأ") || Model.StartsWith("تعذر");
    <div class="zh-alert @(isError ? "zh-alert-danger" : "zh-alert-success") mb-3 alert-dismissible fade show" role="alert">
        <i class="bi @(isError ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill")"></i>
        <div class="flex-grow-1">@Model</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}
