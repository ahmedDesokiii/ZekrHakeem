@page
@model LoginModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<section class="zh-auth">
    <partial name="_AuthArt" model="@string.Empty" />

    <div class="zh-auth-form">
        <div class="zh-card zh-auth-card">
            <h1>أهلاً بعودتك 👋</h1>
            <p class="lead">سجّل دخولك لمتابعة الحلقات والطلاب.</p>

            @if (TempData["AuthNotice"] is string notice)
            {
                <div class="zh-alert zh-alert-success mb-3"><i class="bi bi-check-circle-fill"></i><div>@notice</div></div>
            }
            <div asp-validation-summary="ModelOnly" class="zh-alert zh-alert-danger mb-3 empty-hide" role="alert"></div>

            <form method="post" id="account" novalidate>
                <div class="zh-field">
                    <label class="zh-label" asp-for="Input.Email">اسم المستخدم أو البريد الإلكتروني</label>
                    <div class="zh-input-group">
                        <input asp-for="Input.Email" class="zh-input zh-ltr" autocomplete="username" autofocus placeholder="name@example.com" />
                        <span class="zh-input-action d-grid place-items-center" style="pointer-events:none"><i class="bi bi-person"></i></span>
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="zh-field">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="zh-label" asp-for="Input.Password">كلمة المرور</label>
                        <a asp-page="./ForgotPassword" class="small fw-bold text-decoration-none" style="color:var(--zh-emerald-700)">نسيت كلمة المرور؟</a>
                    </div>
                    <div class="zh-input-group">
                        <input asp-for="Input.Password" class="zh-input zh-ltr" autocomplete="current-password" placeholder="••••••••" />
                        <button type="button" class="zh-input-action" data-toggle-pw aria-label="إظهار كلمة المرور"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    <div class="zh-hint text-warning fw-bold" id="capsWarn" hidden><i class="bi bi-capslock-fill"></i> زر Caps Lock مفعل</div>
                </div>

                <label class="zh-switch mb-4">
                    <input asp-for="Input.RememberMe" />
                    <span class="track"></span>
                    <span>تذكرني على هذا الجهاز</span>
                </label>

                <button id="login-submit" type="submit" class="zh-btn zh-btn-primary zh-btn-block" style="padding:.85rem">
                    <i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول
                </button>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="zh-divider">أو الدخول بواسطة</div>
                <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr))">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        var ic = provider.Name switch { "Google" => "bi-google", "Facebook" => "bi-facebook", "Microsoft" => "bi-microsoft", _ => "bi-box-arrow-in-left" };
                        <button type="submit" class="zh-btn zh-btn-light" name="provider" value="@provider.Name" title="@provider.DisplayName">
                            <i class="bi @ic"></i> @provider.DisplayName
                        </button>
                    }
                </form>
            }

            <p class="text-center mt-4 mb-0 zh-muted">
                ليس لديك حساب؟
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none" style="color:var(--zh-emerald-700)">أنشئ حسابًا جديدًا</a>
            </p>
            <p class="text-center mt-2 mb-0 small">
                <a asp-page="./ResendEmailConfirmation" class="zh-muted">لم يصلك بريد التأكيد؟</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AuthScripts" />
}
