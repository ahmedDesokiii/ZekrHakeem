@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="profile-form" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-6">

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
             <div class="form-floating mb-3">
            <input asp-for="Input.FullName" class="form-control" aria-required="true" placeholder="name" />
            <label asp-for="Input.FullName"></label>
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
            <input asp-for="Input.IdentityNum" class="form-control" aria-required="true" placeholder="Identity number" />
            <label asp-for="Input.IdentityNum"></label>
            <span asp-validation-for="Input.IdentityNum" class="text-danger"></span>
            </div> 
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
              <div class="form-floating mb-3">
            <input asp-for="Input.Gender" class="form-control" aria-required="true" placeholder="Gender" />
            <label asp-for="Input.Gender"></label>
            <span asp-validation-for="Input.Gender" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
            <input asp-for="Input.Nationality" class="form-control" aria-required="true" placeholder="Nationality " />
            <label asp-for="Input.Nationality"></label>
            <span asp-validation-for="Input.Nationality" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
            <input asp-for="Input.Adress" class="form-control" aria-required="true" placeholder="Adress " />
            <label asp-for="Input.Adress"></label>
            <span asp-validation-for="Input.Adress" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
            <input asp-for="Input.Notes" class="form-control" aria-required="true" placeholder="Notes " />
            <label asp-for="Input.Notes"></label>
            <span asp-validation-for="Input.Notes" class="text-danger"></span>
            </div> 

            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Save</button>

        </div>
        <div class="col-md-6">
        @* <label asp-for="Input.ProfilePicture" class="w-100"></label> *@
        @if (Model.Input.ProfilePicture != null)
        {
                <img id="profilePicture" alt="profile" style="height:300px;width:300px;object-fit:contain" src="data:image/*;base64,@(Convert.ToBase64String(Model.Input.ProfilePicture))" />
        }
        else
        {
                <img id="profilePicture" alt="profile" style="height:300px;width:300px;object-fit:contain" src="~/images/avatar.png" />
        }
            <div class="custom-file mt-2">
                <input type="file"
                       accept="image/*"
                       asp-for="Input.ProfilePicture"
                       class="custom-file-input"
                       onchange="document.getElementById('profilePicture').src = window.URL.createObjectURL(this.files[0])" />
               @*  <label class="custom-file-label" asp-for="Input.ProfilePicture"></label> *@
                <span asp-validation-for="Input.ProfilePicture" class="text-danger"></span>
            </div>
        </div> 
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
