@page
@model IndexModel
@{
    ViewData["Title"] = "الملف الشخصي";
    ViewData["ActivePage"] = ManageNavPages.Index;
    var initials = string.Concat((Model.Input.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
    <div>
        <h3 class="mb-1">الملف الشخصي</h3>
        <p class="zh-muted mb-0">حدّث بياناتك وصورتك الشخصية.</p>
    </div>
    <div class="zh-chips">
        @foreach (var r in Model.RoleNames)
        {
            <span class="zh-chip"><i class="bi bi-shield-check"></i> @r</span>
        }
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="zh-alert zh-alert-danger mb-3 empty-hide" role="alert"></div>

    <div class="d-flex flex-wrap align-items-center gap-3 p-3 mb-4 rounded-4" style="background:var(--zh-sand)">
        <span class="zh-avatar" style="--s:96px" id="avatarPreview">
            @if (Model.HasPicture)
            {
                <img src="@Url.Action("Avatar", "Users", new { area = "", id = Model.UserId })?v=@DateTime.UtcNow.Ticks" alt="" />
            }
            else
            {
                @initials
            }
        </span>
        <div class="flex-grow-1">
            <div class="fw-bold fs-5">@Model.Input.FullName</div>
            <div class="zh-muted zh-ltr text-end d-inline-block">@@@Model.Username · @Model.Email</div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <label class="zh-btn zh-btn-light zh-btn-sm mb-0">
                    <i class="bi bi-camera-fill"></i> تغيير الصورة
                    <input type="file" asp-for="Picture" accept="image/png,image/jpeg,image/webp,image/gif" hidden id="pictureInput" />
                </label>
                @if (Model.HasPicture)
                {
                    <label class="zh-btn zh-btn-ghost zh-btn-sm mb-0"><input type="checkbox" asp-for="RemovePicture" class="form-check-input ms-1" /> حذف الصورة</label>
                }
            </div>
            <span asp-validation-for="Picture" class="text-danger small"></span>
            <div class="zh-hint">JPG أو PNG — بحد أقصى 2 ميجابايت</div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="zh-label" asp-for="Input.FullName">الاسم الكامل <span class="req">*</span></label>
            <input asp-for="Input.FullName" class="zh-input" />
            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="zh-label" asp-for="Input.IdentityNum">رقم الهوية <span class="req">*</span></label>
            <input asp-for="Input.IdentityNum" class="zh-input zh-ltr" />
            <span asp-validation-for="Input.IdentityNum" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="zh-label" asp-for="Input.PhoneNumber">الجوال</label>
            <input asp-for="Input.PhoneNumber" class="zh-input zh-ltr" type="tel" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="zh-label">النوع</label>
            <select asp-for="Input.Gender" class="zh-select">
                <option value="">—</option>
                <option value="male">ذكر</option>
                <option value="female">أنثى</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="zh-label" asp-for="Input.Nationality">الجنسية</label>
            <input asp-for="Input.Nationality" class="zh-input" />
        </div>
        <div class="col-md-6">
            <label class="zh-label" asp-for="Input.Adress">العنوان</label>
            <input asp-for="Input.Adress" class="zh-input" />
        </div>
        <div class="col-12">
            <label class="zh-label" asp-for="Input.Notes">نبذة / ملاحظات</label>
            <textarea asp-for="Input.Notes" class="zh-textarea" rows="3"></textarea>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4">
        <span class="zh-muted small"><i class="bi bi-calendar3"></i> عضو منذ @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</span>
        <button id="update-profile-button" type="submit" class="zh-btn zh-btn-primary"><i class="bi bi-check2-circle"></i> حفظ التغييرات</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('pictureInput')?.addEventListener('change', e => {
            const f = e.target.files[0]; if (!f) return;
            if (f.size > 2 * 1024 * 1024) { ZH.toast('الصورة كبيرة', 'الحد الأقصى 2 ميجابايت', 'warning'); e.target.value = ''; return; }
            document.getElementById('avatarPreview').innerHTML = `<img src="${URL.createObjectURL(f)}" alt="">`;
        });
    </script>
}
