@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var me = await UserManager.GetUserAsync(User);
    var initials = string.Concat((me?.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
    var active = ViewData["ActivePage"] as string ?? System.IO.Path.GetFileNameWithoutExtension(ViewContext.ActionDescriptor.DisplayName);
    string Cls(string page) => string.Equals(active, page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<div class="me">
    <span class="zh-avatar" style="--s:84px">
        @if (me?.ProfilePicture != null)
        {
            <img src="@Url.Action("Avatar", "Users", new { area = "", id = me.Id })" alt="" />
        }
        else
        {
            @initials
        }
    </span>
    <h5>@me?.FullName</h5>
    <small>@me?.Email</small>
</div>
<nav>
    <a class="@Cls(ManageNavPages.Index)" asp-page="./Index"><i class="bi bi-person-circle"></i> الملف الشخصي</a>
    <a class="@Cls(ManageNavPages.Email)" asp-page="./Email"><i class="bi bi-envelope-at"></i> البريد الإلكتروني</a>
    <a class="@Cls(ManageNavPages.ChangePassword)" asp-page="./ChangePassword"><i class="bi bi-key"></i> كلمة المرور</a>
    <a class="@Cls(ManageNavPages.TwoFactorAuthentication)" asp-page="./TwoFactorAuthentication"><i class="bi bi-shield-lock"></i> التحقق بخطوتين</a>
    @if (hasExternalLogins)
    {
        <a class="@Cls(ManageNavPages.ExternalLogins)" asp-page="./ExternalLogins"><i class="bi bi-link-45deg"></i> الحسابات المرتبطة</a>
    }
    <a class="@Cls("Activity")" asp-page="./Activity"><i class="bi bi-clock-history"></i> نشاط حسابي</a>
    <a class="@Cls(ManageNavPages.PersonalData)" asp-page="./PersonalData"><i class="bi bi-database-lock"></i> بياناتي</a>
</nav>
