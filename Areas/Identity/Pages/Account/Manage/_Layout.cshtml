@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<section class="zh-page">
    <div class="zh-container" style="max-width:1200px">
        <div class="zh-hero">
            <div class="zh-crumb"><a href="/">الرئيسية</a><i class="bi bi-chevron-left"></i><span>حسابي</span></div>
            <h1><i class="bi bi-person-gear ms-2"></i>إعدادات الحساب</h1>
            <p>بياناتك الشخصية، الأمان، وسجل نشاط حسابك.</p>
        </div>
        <div class="zh-manage">
            <div class="zh-card zh-manage-nav">
                <partial name="_ManageNav" />
            </div>
            <div class="zh-card zh-manage-body">
                @RenderBody()
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <style>.empty-hide.validation-summary-valid{display:none}.zh-alert ul{list-style:none;padding:0;margin:0}</style>
    @RenderSection("Scripts", required: false)
}
