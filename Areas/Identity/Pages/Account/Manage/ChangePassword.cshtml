@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="mb-1">تغيير كلمة المرور</h3>
<p class="zh-muted mb-4">بعد التغيير سيتم تسجيل خروجك من الأجهزة الأخرى تلقائيًا.</p>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" style="max-width:520px" novalidate>
    <div asp-validation-summary="ModelOnly" class="zh-alert zh-alert-danger mb-3 empty-hide" role="alert"></div>
    <div class="zh-field">
        <label class="zh-label" asp-for="Input.OldPassword">كلمة المرور الحالية</label>
        <div class="zh-input-group">
            <input asp-for="Input.OldPassword" class="zh-input zh-ltr" autocomplete="current-password" />
            <button type="button" class="zh-input-action" data-toggle-pw><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
    </div>
    <div class="zh-field">
        <label class="zh-label" asp-for="Input.NewPassword">كلمة المرور الجديدة</label>
        <div class="zh-input-group">
            <input asp-for="Input.NewPassword" class="zh-input zh-ltr" autocomplete="new-password" data-strength />
            <button type="button" class="zh-input-action" data-toggle-pw><i class="bi bi-eye"></i></button>
        </div>
        <div class="zh-strength" id="pwStrength"><span></span><span></span><span></span><span></span></div>
        <div class="zh-pw-rules">
            <span data-rule="len"><i class="bi bi-circle"></i> 6 خانات على الأقل</span>
            <span data-rule="upper"><i class="bi bi-circle"></i> حرف إنجليزي كبير</span>
            <span data-rule="lower"><i class="bi bi-circle"></i> حرف إنجليزي صغير</span>
            <span data-rule="digit"><i class="bi bi-circle"></i> رقم</span>
            <span data-rule="sym"><i class="bi bi-circle"></i> رمز مثل $ @@ #</span>
        </div>
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
    </div>
    <div class="zh-field">
        <label class="zh-label" asp-for="Input.ConfirmPassword">تأكيد كلمة المرور الجديدة</label>
        <input asp-for="Input.ConfirmPassword" class="zh-input zh-ltr" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="zh-btn zh-btn-primary"><i class="bi bi-shield-check"></i> تحديث كلمة المرور</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AuthScripts" />
}
