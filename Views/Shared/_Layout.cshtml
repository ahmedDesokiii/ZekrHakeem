@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - الذكر الحكيم</title>
    <link rel="icon" type="image/x-icon" href="~/zk.ico">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/location.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZekrHakeem_v11.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootswatchtheme.css" />

    <!-- SweetAlert2 -->
    <link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Beiruti:wght@200..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.2/css/boxicons.min.css' rel='stylesheet'>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/columncontrol/1.1.1/css/columnControl.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.5/css/buttons.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/select/3.1.3/css/select.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/datetime/1.6.1/css/dataTables.dateTime.min.css" />

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="css/swiper-bundle.min.css">

    <!-- Scroll Reveal -->
    <link rel="stylesheet" href="css/scrollreveal.min.js">

    <!-- CoreUI -->
    <script defer src="https://cdn.jsdelivr.net/npm/coreui/coreui-pro@5.10.0/dist/js/coreui.bundle.min.js"></script>
</head>
<body class="p-0" style="background-image: linear-gradient(to bottom, #FBF8EF, #B1F0F7);">

    <!-- Header / Navbar -->
    <header dir="rtl">
        <div class="p-0" style="background-image: linear-gradient(to top , #FBF8EF, #B1F0F7);">
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-0 mb-0 pb-0">
                <div class="container-fluid bg-transparent">
                    <a class="navbar-brand mt-2 mb-0" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/zekr.png" alt="zh Logo" style="height:80px !important;" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1 fw-bold">

                            <!-- Home link -->
                            <li class="nav-item">
                                <a class="nav-link fw-bold" style="color:darkgoldenrod;font-size:20px;" asp-area="" asp-controller="Home" asp-action="Index">
                                    @ResourceApp_Ar.LayoutPage_NavHome_lnk
                                </a>
                            </li>

                            @* Admin links *@
                            @if (User.IsInRole(Roles.Admin.ToString()))
                            {
                                @await Html.PartialAsync("_Nav_Admin")
                            }
                            @* Supervisor links *@
                            else if (User.IsInRole(Roles.Supervisor.ToString()) || User.IsInRole(Roles.SupervisorWomen.ToString()))
                            {
                                @await Html.PartialAsync("_Nav_Supervisor")
                            }
                            @* Teacher links *@
                            else if (User.IsInRole(Roles.Teacher.ToString()) || User.IsInRole(Roles.TeacherWomen.ToString()))
                            {
                                @await Html.PartialAsync("_Nav_Teacher")
                            }
                            @* Parent links *@
                            else if (User.IsInRole(Roles.Parent.ToString()))
                            {
                                @await Html.PartialAsync("_Nav_Parent")
                            }

                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- Wave image -->
    <div class="p-0" style="background-image: linear-gradient(to bottom , #FBF8EF, #B1F0F7);">
        <img src="~/images/msqwv.png" alt="wave" class="mb-0" style="width:100%" />
    </div>

    <main role="main" class="p-0" style="background-image: linear-gradient(to bottom , #FBF8EF, #B1F0F7);">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/columncontrol/1.1.1/js/dataTables.columnControl.js"></script>
    <script src="https://cdn.datatables.net/plug-ins/2.3.4/api/sum().js"></script>
    <script src="https://cdn.datatables.net/datetime/1.5.6/js/dataTables.dateTime.min.js"></script>

    <!-- Highcharts -->
    <script src="https://code.highcharts.com/highcharts.js"></script>

    <!-- SweetAlert2 -->
    <script src="~/sweetalert2/sweetalert2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom scripts -->
    <script src="~/js/script.js"></script>
    <script src="~/js/Users.js"></script>
    <script src="~/js/Roles.js"></script>
    <script src="~/js/Centers.js"></script>
    <script src="~/js/Districts.js"></script>
    <script src="~/js/Locations.js"></script>
    <script src="~/js/Students.js"></script>
    <script src="~/js/Episodes.js"></script>
    <script src="~/js/SelectedEpisode.js"></script>

    <!-- Google Maps -->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDy2BMMMCDn3JczdO1y8hZRYQkf8dDS4x0&callback=initMap" async defer></script>

    <script>
        document.addEventListener("scroll", () => {
            const navbar = document.querySelector("header nav.navbar");
            if (!navbar) return;
            navbar.classList.toggle("scrolled", window.scrollY > 10);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
