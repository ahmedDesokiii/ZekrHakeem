@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isHome = controller == "Home";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0F5E4F" />
    <title>@ViewData["Title"] - الذكر الحكيم</title>
    <link rel="icon" type="image/x-icon" href="~/zk.ico">

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Beiruti:wght@200..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.2/css/boxicons.min.css' rel='stylesheet'>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/location.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZekrHakeem_v11.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootswatchTheme.css" />

    <!-- SweetAlert2 -->
    <link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/columncontrol/1.1.1/css/columnControl.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.5/css/buttons.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/select/3.1.3/css/select.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/datetime/1.6.1/css/dataTables.dateTime.min.css" />

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="~/css/swiper-bundle.min.css">

    <!-- Zekr Hakeem design system (last = wins) -->
    <link rel="stylesheet" href="~/css/zh-design.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="zh-body p-0">

    <!-- Header / Navbar -->
    <header class="zh-header" id="zhHeader">
        <nav class="navbar zh-container">
            <button class="zh-menu-toggle" type="button" id="zhMenuToggle" aria-label="القائمة">
                <i class="bi bi-list"></i>
            </button>

            <a class="navbar-brand zh-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/zekr.png" alt="الذكر الحكيم" />
            </a>

            <div class="zh-nav-backdrop" id="zhNavBackdrop"></div>
            <div class="zh-nav-wrap" id="zhNav">
                <div class="zh-nav-panel-head">
                    <span><i class="bi bi-moon-stars-fill ms-2"></i> الذكر الحكيم</span>
                    <button type="button" id="zhMenuClose" aria-label="إغلاق"><i class="bi bi-x-lg"></i></button>
                </div>

                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link @(isHome ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                            @ResourceApp_Ar.LayoutPage_NavHome_lnk
                        </a>
                    </li>

                    @if (User.IsInRole(Roles.Admin.ToString()))
                    {
                        @await Html.PartialAsync("_Nav_Admin")
                    }
                    else if (User.IsInRole(Roles.Supervisor.ToString()) || User.IsInRole(Roles.SupervisorWomen.ToString()))
                    {
                        @await Html.PartialAsync("_Nav_Supervisor", Model as object)
                    }
                    else if (User.IsInRole(Roles.Teacher.ToString()) || User.IsInRole(Roles.TeacherWomen.ToString()))
                    {
                        @await Html.PartialAsync("_Nav_Teacher")
                    }
                    else if (User.IsInRole(Roles.Parent.ToString()))
                    {
                        @await Html.PartialAsync("_Nav_Parent")
                    }

                    @if (signedIn)
                    {
                        @await Html.PartialAsync("_Nav_Management")
                    }
                </ul>
            </div>

            <div class="zh-nav-end ms-0 me-auto me-xl-0 d-flex align-items-center gap-2">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    @if (isHome)
    {
        <div class="p-0">
            <img src="~/images/msqwv.png" alt="" class="mb-0" style="width:100%" />
        </div>
    }

    <main role="main" class="p-0">
        @RenderBody()
    </main>

    <div class="zh-toasts" id="zhToasts" aria-live="polite"></div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/columncontrol/1.1.1/js/dataTables.columnControl.js"></script>
    <script src="https://cdn.datatables.net/plug-ins/2.3.4/api/sum().js"></script>
    <script src="https://cdn.datatables.net/datetime/1.5.6/js/dataTables.dateTime.min.js"></script>

    <!-- Highcharts -->
    <script src="https://code.highcharts.com/highcharts.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom scripts -->
    <script src="~/js/script.js"></script>
    <script src="~/js/Users.js"></script>
    <script src="~/js/Roles.js"></script>
    <script src="~/js/Centers.js"></script>
    <script src="~/js/Districts.js"></script>
    <script src="~/js/Locations.js"></script>
    <script src="~/js/Students.js"></script>
    <script src="~/js/Episodes.js"></script>
    <script src="~/js/SelectedEpisode.js"></script>

    <!-- Google Maps -->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDy2BMMMCDn3JczdO1y8hZRYQkf8dDS4x0&callback=initMap" async defer></script>

    <!-- UI core + realtime (SignalR) -->
    <script src="~/js/zh-ui.js" asp-append-version="true"></script>
    @if (signedIn)
    {
        <script src="~/lib/signalr/signalr.min.js"></script>
        <script src="~/js/zh-realtime.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
