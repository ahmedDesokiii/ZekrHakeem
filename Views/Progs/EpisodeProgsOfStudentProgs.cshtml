        let lbEdit = '@Html.Raw(ResourceApp_Ar.Modal_SaveEdit_btn)';

        let lbAddNewStudent = '@Html.Raw(ResourceApp_Ar.StudentsModal_AddNewStudent_lbl)';
        let lbAddNewStudentNat = '@Html.Raw(ResourceApp_Ar.StudentNationalitiesModal_AddNewStNationality_lbl)';
        let lbAddNewStudentHealth = '@Html.Raw(ResourceApp_Ar.StudentHealthModal_AddNewStHealth_lbl)';
        let lbbtnSave = '@Html.Raw(ResourceApp_Ar.Modal_Save_btn)';
        let lbTitleMsgDelete = '@Html.Raw("Delete Student")';
        let lbTitleMsgDeleteNat = '@Html.Raw("Delete Student Nationality")';
        let lbTitleMsgDeleteHealth = '@Html.Raw("Delete Student Health Condition")';
        let lbTitleMsgDeleteLog = '@Html.Raw("Delete StudentLog")';
        let lbTextMsgDelete = '@Html.Raw("Are you sure to delete Student ?")';
        let lbTextMsgDeleteNat = '@Html.Raw("Are you sure to delete Student ?")';
        let lbTextMsgDeleteHealth = '@Html.Raw("Are you sure to delete Student ?")';
        let lbTextMsgDeleteLog = '@Html.Raw("Are you sure to delete Student log ?")';
        let lbconfirmButtonText = '@Html.Raw("Yes,Delete it")';
        let lbcancelButtonText = '@Html.Raw(ResourceApp_Ar.Modal_Cancle_btn)';
