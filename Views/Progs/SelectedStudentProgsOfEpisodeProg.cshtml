<!-- Modal StudentProg -->
<div class="modal fade" id="exampleModalst" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog card card-success card-outline">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h5 class="modal-title" id="title">@ResourceApp_Ar.StudentsModal_AddNewStudent_lbl</h5>
                <img id="stPhoto" alt="profile" class="rounded-circle mx-auto d-block bg-transparent" style="height:100px;width:100px;object-fit:contain" src="~/images/stu.svg" />

                <a href="#" class="btn-close ms-1" data-bs-dismiss="modal" aria-label="Close"></a>
            </div>
            <div class="modal-body">
                <form asp-action="SaveStudentProg" asp-controller="Progs" method="post" enctype="multipart/form-data">

                    <div><input type="text" hidden class="input-group" asp-for="@Model.StProgVM.NewStudentProg.Id" id="stId"></div>

                    <div class="form-group mb-2 ">
                        <div class="row">
                            <div class="col-sm-4 col-4">
                                <span class="input-group-text bg-info-subtle ps-2">@ResourceApp_Ar.StudentsModel_StudentName_lbl</span>
                            </div>
                            <div class="col-sm-8 col-8">
                                <input type="text" class="form-control text-center" asp-for="@Model.StProgVM.NewStudentProg.Name" id="stName" style="border-left:solid 3px red" placeholder="@ResourceApp_Ar.StudentsModel_StudentName_txt" />
                                <span asp-validation-for="@Model.StProgVM.NewStudentProg.Name" class="text-danger"></span>
                            </div>
                        </div>
                    </div>


                    <div class="form-group mb-2">
                        <div class="row">
                            <div class="col-sm-4 col-4">
                                <span class="input-group-text ps-2 bg-info-subtle">@ResourceApp_Ar.StudentsModel_ParentPhoneNum_lbl</span>
                            </div>
                            <div class="col-sm-8 col-8">
                                <input type="text" class="form-control text-center" asp-for="@Model.StProgVM.NewStudentProg.ParentPhoneNumber" style="border-left:solid 3px red" id="stParentPhonenum" placeholder="@ResourceApp_Ar.StudentsModel_ParentPhoneNum_txt" />
                                <span asp-validation-for="@Model.StProgVM.NewStudentProg.ParentPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-2">
                        <div class="row">
                            <div class="col-sm-4 col-4">
                                <label class="input-group-text bg-info-subtle" for="stNationalityId">@ResourceApp_Ar.StudentsModel_StudentNationality_lbl</label>
                            </div>
                            <div class="col-sm-8 col-8">
                                <select class="form-select text-center" asp-items="@Model.StProgVM.AvilableNationalities" id="stNationalityId" asp-for="@Model.StProgVM.NewStudentProg.NationalityId" onchange="" style="border-left:solid 3px red">
                                    <option selected disabled value="">@ResourceApp_Ar.StudentsModel_StudentNationality_select</option>
                                </select>
                                <span asp-validation-for="@Model.StProgVM.NewStudentProg.NationalityId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-2">
                        <div class="row">
                            <div class="col-sm-4 col-4">
                                <label class="input-group-text bg-info-subtle" for="stGender">@ResourceApp_Ar.StudentsModel_StudentGender_lbl</label>
                            </div>
                            <div class="col-sm-8 col-8">
                                <select class="form-select text-center" id="stGender" asp-for="@Model.StProgVM.NewStudentProg.Gender" onchange="" style="border-left:solid 3px red">
                                    @*  <option selected disabled value="">@ResourceApp_Ar.StudentsModel_StudentGender_select</option> *@
                                    <option value="male">ذكر </option>
                                    <option value="female">انثي </option>
                                </select>
                                <span asp-validation-for="@Model.StProgVM.NewStudentProg.Gender" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-2 ">
                        <div class="row">
                            <div class="col-sm-4 col-4">
                                <span class="input-group-text ps-2 bg-info-subtle">@ResourceApp_Ar.StudentsModel_StudentNotes_lbl</span>
                            </div>
                            <div class="col-sm-8 col-8 ">
                                <textarea class="form-control" asp-for="StProgVM.NewStudentProg.Notes" id="stNotes" placeholder=" @ResourceApp_Ar.StudentsModel_StudentNotes_txt" rows="3" cols="50"></textarea>
                                <span asp-validation-for="StProgVM.NewStudentProg.Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <input type="text" class="form-control text-center" hidden asp-for="StProgVM.NewStudentProg.StEpisodeProgId" id="stEpProgId" placeholder="" />
                    </div>

                    <div class="modal-footer mt-2" style="padding:0 15px 15px 0">
                        <input type="submit" class="btn btn-success" value="@ResourceApp_Ar.Modal_Save_btn" id="btnSave" onclick="getHijriDate()" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@ResourceApp_Ar.Modal_Cancle_btn</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>





@section Scripts {
    <script>

        $(document).ready(function(){
            GetVersesBySurah_CTP();
            GetVersesBySurah_PTC();
        })
        $("#surahId_ctp").change(function(){
            GetVersesBySurah_CTP();

        });
         var GetVersesBySurah_CTP = function(){
          $.ajax({
                url: '@Url.Action("GetVersesBySurah", "StudentProgs")',
                type : 'GET',
                data:{
                    surahId:$('#surahId_ctp').val(),
                },
                success: function(data){
                    $('#verseId_ctp').find('option').remove()
                    $(data).each(
                        function(index , item){
                            $("#verseId_ctp").append('<option value = "'+item.Id+'">'+item.num + '</option>')
                        }
                    )
                }
          })
        }


        $("#surahId_ptc").change(function(){
            GetVersesBySurah_PTC();

        });
        var GetVersesBySurah_PTC = function(){
          $.ajax({
                url: '@Url.Action("GetVersesBySurah", "StudentProgs")',
                type : 'GET',
                data:{
                    surahId:$('#surahId_ptc').val(),
                },
                success: function(data){
                    $('#verseId_ptc').find('option').remove()
                    $(data).each(
                        function(index , item){
                            $("#verseId_ptc").append('<option value = "'+item.Id+'">'+item.num + '</option>')
                        }
                    )
                }
          })
        }



    </script>
    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        if (Context.Session.GetString(Helper.MsgType) == Helper.Success)
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'success'
                });
            </script>

        }
        else
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'error'
                });
            </script>
        }
        Context.Session.SetString(Helper.MsgType, "");
    }
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/StudentsWithEpisodeProgs.js"></script>
    <script src="~/js/filesize-validator.js"></script>

    <script>
        let lbTitleEditStudentProg = '@Html.Raw(ResourceApp_Ar.StudentsModal_EditStudent_lbl)';
        let lbEdit = '@Html.Raw(ResourceApp_Ar.Modal_SaveEdit_btn)';

        let lbAddNewStudentProg = '@Html.Raw(ResourceApp_Ar.StudentsModal_AddNewStudent_lbl)';
       
        let lbbtnSave = '@Html.Raw(ResourceApp_Ar.Modal_Save_btn)';
        let lbTitleMsgDelete = '@Html.Raw("Delete StudentProg")';
       
        let lbTitleMsgDeleteLog = '@Html.Raw("Delete StudentProgLog")';
        let lbTextMsgDelete = '@Html.Raw("Are you sure to delete StudentProg ?")';
        
        let lbTextMsgDeleteLog = '@Html.Raw("Are you sure to delete StudentProg log ?")';
        let lbconfirmButtonText = '@Html.Raw("Yes,Delete it")';
        let lbcancelButtonText = '@Html.Raw(ResourceApp_Ar.Modal_Cancle_btn)';
        let lbTitleDeletedOk = '@Html.Raw("Done")';
        let lbMsgDeletedOkStudentProg = '@Html.Raw("StudentProg is delete")';
       
        let lbMsgDeletedOkStudentProgLog = '@Html.Raw("StudentProgLog is delete")';
        let lbSuccess = '@Html.Raw(Helper.Success)';

    </script>



}
