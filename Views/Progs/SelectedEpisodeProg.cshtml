@model MasterViewModel
@{
    ViewData["Title"] = "Episodes";
    int ev = 0;
    int i = 0;
}

<div class="wrapper" dir="rtl">
    <!--Content-Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">

                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </div>
    <!--End Content-Header-->
    <!-- Main content -->
    <section class="content" dir="rtl">

        @if (Model.EpProgVM.NewEpisodeProg.Period == null)
        { }
        else if (Model.EpProgVM.NewEpisodeProg.Period.Contains(PrayerTimesPeriods.الفجر.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI?.EndFajrTime)" />
        }
        else if (Model.EpProgVM.NewEpisodeProg.Period.Contains(PrayerTimesPeriods.الظهر.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI?.EndZohrTime)" />
        }
        else if (Model.EpProgVM.NewEpisodeProg.Period.Contains(PrayerTimesPeriods.العصر.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI?.EndAsrTime)" />
        }
        else if (Model.EpProgVM.NewEpisodeProg.Period.Contains(PrayerTimesPeriods.المغرب.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI?.EndMghrbTime)" />
        }
        else if (Model.EpProgVM.NewEpisodeProg.Period.Contains(PrayerTimesPeriods.العشاء.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI?.EndIshaTime)" />
        }

        <div class="d-flex">
            @if (!User.IsInRole(Roles.Teacher.ToString()) || !User.IsInRole(Roles.TeacherWomen.ToString()))
            {
                @if (Model?.EpProgVM.NewEpisodeProg?.Status == true)
                {
                    <div class="mb-2 col-3 align-items-center" dir="ltr">
                        <button type="button"
                                class="btn text-success bg-transparent  border-0" disabled data-bs-toggle="modal" data-bs-target="#exampleModal">
                            ... حلقة جارية الآن
                        </button>
                    </div>
                }
                else if (Model?.EpProgVM.NewEpisodeProg?.Status == false)
                {
                    <div class="mb-2 col-3 align-items-center" dir="ltr">
                        <button type="button"
                                class="btn text-danger bg-transparent  border-0" disabled data-bs-toggle="modal" data-bs-target="#exampleModal">
                            ... غير جارية الآن
                        </button>
                    </div>
                }
            }
            else
            {

            }

        </div>
        <div class="row mb-2">
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-header py-2">
                        <div class="row ">
                            <div class="col-sm-12 ">
                                <div class=" shadow" id="accordionExamplen">
                                    <div class="accordion-item  bg-light ">
                                        <div class="accordion-header bg-danger-subtle d-flex rounded-2 py-1" id="header_n">
                                            <div class="col-sm-10 col-8 ">
                                                <button type="button" class="accordion-toggle bg-danger-subtle w-100 border-0" data-parent="#accordion" data-bs-toggle="collapse" data-bs-target="#collapse_n" aria-controls="collapse_n">
                                                    <span class="text-center fw-bolder fs-4 text-dark"> @Model.EpProgVM.NewEpisodeProg.Name </span>
                                                    <i class="mt-1 mx-2 text-dark  bi bi-box-arrow-in-down fs-5"></i>
                                                    <span class="fs-6 fw-bold text-dark ms-2"> اجمالي الطلاب | <span class="text-warning fw-bold fs-4 me-2">@Model.EpProgVM.NewEpisodeProg.StudentProgs.Count()</span></span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="collapse_n" class="collapse mt-2" aria-labelledby="header_n" data-bs-parent="#accordionExamplen">
                                        <div class="accordion-body">
                                            <div class="row d-flex justify-content-center text-center">
                                                <div class="col-sm-2 col-4 mb-2">
                                                    <div class="card">
                                                        <div class="card-header py-0   bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.SelectedEpisode_TeacherName_lbl</h6></div>
                                                        <div class="card-body py-0 "><h6 class="card-title">@Model.EpProgVM.NewEpisodeProg.ApplicationUser.FullName</h6></div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-2 col-4 mb-2">
                                                    <div class="card">
                                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.LocationsPage_locationName_LocationsTable</h6></div>
                                                        <div class="card-body py-0"><h6 class="card-title">@Model.EpProgVM.NewEpisodeProg.EpProgLocation.Name</h6></div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-2 col-3 mb-2">
                                                    <div class="card">
                                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.SelectedEpisodes_Students_lbl</h6></div>
                                                        <div class="card-body py-0"><h6 class="card-title">@Model.EpProgVM.NewEpisodeProg.StudentProgs.Count() </h6></div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-2 col-3 mb-2">
                                                    <div class="card">
                                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.ProgsModal_ProgName_lbl</h6></div>
                                                        <div class="card-body py-0"><h6 class="card-title">@Model.EpProgVM.NewEpisodeProg.EpProg.Name</h6></div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-2 col-3 mb-2">
                                                    <div class="card">
                                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.SelectedEpisode_EpisodeAttendType_lbl</h6></div>
                                                        <div class="card-body py-0">
                                                            <h6 class="card-title py-0">@Model.EpProgVM.NewEpisodeProg.AttendType</h6>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-2 col-3 mb-2">
                                                    <div class="card">
                                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.EpisodesModal_EpisodePeriod_lbl</h6></div>
                                                        <div class="card-body py-0">
                                                            <h6 class="card-title py-0">@Model.EpProgVM.NewEpisodeProg.Period</h6>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="card-body py-3  ">
                        <div class="row d-flex justify-content-center text-center">

                            <div class="row">
                                <div class="col-12">
                                    <div class="card mt-3">
                                        <ul class="nav nav-tabs bg-light mb-2" role="tablist">
                                            <li class="nav-item" role="presentation">
                                                <a class="nav-link active fw-bold text-secondary" data-bs-toggle="tab" href="#epstudents" aria-selected="true" role="tab">@ResourceApp_Ar.SelectedEpisodePage_ListStudent_tab</a>
                                            </li>
                                        </ul>
                                        @if (User.IsInRole(Roles.Teacher.ToString()) || User.IsInRole(Roles.TeacherWomen.ToString()))
                                        {
                                            <div id="myTabContent" class="tab-content">
                                                <div class="tab-pane fade active show" id="epstudents" role="tabpanel">
                                                    <!-- /.card-header -->
                                                    <div class="card-body " style="background: #FBF8EF;">
                                                        <form asp-route-id="@Model.EpProgVM.NewEpisodeProg.Id" method="post" id="form_data">
                                                            @if (Model.EpProgVM.TeacherAttendance == null)
                                                            {
                                                                <div class="d-flex align-items-center justify-content-center text-center">
                                                                    <div class="col-sm-4 col-4 ">
                                                                        <div class="card">
                                                                            <div class="card-header bg-success-subtle fw-bold">@ResourceApp_Ar.SelectedEpisode_TeacherAttendIn_card</div>
                                                                            <div class="card-body py-1">
                                                                                <h6 class="card-title  text-success-emphasis"></h6>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-3 col-3 mb-2 mx-2">
                                                                        <button type="submit" asp-action="UpdateLesson" asp-controller="Progs" asp-route-Id="@Model.EpProgVM.NewEpisodeProg.Id" disabled id="finish" class="btn w-100 px-0 btn-danger fs-5"
                                                                                data-mdb-ripple-init data-mdb-ripple-unbound="true">

                                                                            <i class="bi bi-fingerprint fs-2"></i>
                                                                            <br>
                                                                            @ResourceApp_Ar.SelectedEpisodePage_FinishEpisode_btn
                                                                            <span class="position-absolute top-0 start-100 translate-middle badge fs-4 rounded bg-warning">
                                                                                <span id="stcount" value="0"></span> <span class="visually-hidden">activeStudents</span>
                                                                            </span>
                                                                        </button>
                                                                    </div>
                                                                    <div class="col-sm-4 col-4 ">
                                                                        <div class="card">
                                                                            <div class="card-header  bg-dark-subtle fw-bold">@ResourceApp_Ar.SelectedEpisode_TeacherAttendOut_card</div>
                                                                            <div class="card-body py-1 ">
                                                                                <h6 class="card-title text-dark"></h6>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex align-content-center d-flex align-items-center justify-content-center text-center">
                                                                    <div class="col-sm-3 col-4">
                                                                        <div class="card">
                                                                            <div class="card-header bg-success-subtle fw-bold">@ResourceApp_Ar.SelectedEpisode_TeacherAttendIn_card</div>
                                                                            <div class="card-body py-1">
                                                                                <h6 class="card-title text-dark-emphasis">
                                                                                    @Model.EpProgVM.TeacherAttendance.Att_In.ToString("hh:mm")
                                                                                    <br>
                                                                                    @Model.EpProgVM.TeacherAttendance.Att_In.ToString("dd/MM/yyyy")
                                                                                </h6>
                                                                            </div>
                                                                        </div>
                                                                    </div>


                                                                    <div class="col-sm-3 col-3 fs-5 me-2">
                                                                        <button type="submit" asp-action="UpdateLesson" asp-controller="Progs" asp-route-Id="@Model.EpProgVM.NewEpisodeProg.Id" disabled id="finish" class="btn w-100 btn-danger fs-5"
                                                                                data-mdb-ripple-init data-mdb-ripple-unbound="true">
                                                                            <i class=" bi bi-fingerprint fs-2"></i>
                                                                            <br>
                                                                            @ResourceApp_Ar.SelectedEpisodePage_FinishEpisode_btn
                                                                            <span class="position-absolute top-0 start-100 translate-middle badge fs-6 rounded bg-warning">
                                                                                <span id="stcount"></span> <span class="visually-hidden">activeStudents</span>
                                                                            </span>
                                                                        </button>

                                                                        @* <div class="card mx-2">
                                                                            <div class="card-body py-0">
                                                                                <span class="card-title fw-bold fs-5 text-danger" id="timerCount"></span>
                                                                            </div>
                                                                        </div> *@
                                                                    </div>

                                                                    <div class="col-sm-3 col-4 me-2">
                                                                        <div class="card">
                                                                            <div class="card-header  bg-dark-subtle fw-bold">@ResourceApp_Ar.SelectedEpisode_TeacherAttendOut_card</div>
                                                                            <div class="card-body py-1">
                                                                                <h6 class="card-title  text-dark-emphasis">
                                                                                    @Model.EpProgVM.TeacherAttendance.Att_Out.ToString("hh:mm")
                                                                                    <br>
                                                                                    @Model.EpProgVM.TeacherAttendance.Att_Out.ToString("dd/MM/yyyy")
                                                                                </h6>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }

                                                            <div class="mt-2">
                                                                @if (!Model.EpProgVM.StudentProgsVM.StudentProgs.Any())
                                                                {
                                                                    <div class="alert  alert-warning mt-3">
                                                                        <h4 class="alert-heading">No Students!</h4>
                                                                        <p class="mb-0">No Students where added yet.</p>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="row">
                                                                        <div class="col-12">
                                                                            <div class="card">
                                                                                <div class="card-body p-1 d-flex bg-primary-subtle" dir="ltr">
                                                                                    <!-- save temp -->
                                                                                    <div>
                                                                                        @*   <button disabled type="submit" asp-action="AddEvaluatoinOnly" asp-controller="Episodes" asp-route-Id="@Model.NewEpisode.Id" class="btn bg-transparent rounded-3 me-2  border-0" id="saveTemp">
                                                                                            <i class="bi bi-bookmark-check-fill fs-3"></i>
                                                                                        </button> *@
                                                                                    </div>
                                                                                    <!-- select all boxes -->
                                                                                    <div class="form-check form-switch mx-1 mt-2">
                                                                                        <input disabled class="form-check-input  p-3 px-5 " name="select-all" id="select-all" type="checkbox" onchange="ActiveAll(@Model.EpProgVM.StudentProgsVM.StudentProgs.Count())" />
                                                                                    </div>

                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <hr>

                                                                    <div class="row ">
                                                                        <div class="col-sm-12">
                                                                            <div class=" shadow my-2" id="accordionExample">

                                                                                @foreach (var student in Model.EpProgVM.StudentProgsVM.StudentProgs)
                                                                                {
                                                                                    <div><input type="text" hidden id="iseval_@i" asp-for="@student.IsEvaluate" /></div>
                                                                                    if (student.EpisodeProg.EpProg.Plan.Name.Contains("الخطة المفتوحة"))
                                                                                    {

                                                                                        <div><input type="text" hidden id="plancheck_@i" value="op" /></div>
                                                                                        <div><input type="text" hidden id="stId" value="@student.Id" /></div>

                                                                                        <div class="accordion-item  bg-light py-2">
                                                                                            <div class="accordion-header bg-dark d-flex rounded-2 py-1" id="header_@i">
                                                                                                <div class="col-sm-10 col-8 ">
                                                                                                    <button type="button" class="accordion-toggle bg-dark w-100 border-0" data-bs-toggle="collapse" data-bs-target="#collapse_@i" aria-controls="collapse_@i" aria-expanded="false">
                                                                                                        <span class="text-center fw-bolder fs-5 text-white ">@student.Name</span>
                                                                                                        <i class="mt-1 mx-2 text-white  bi bi-box-arrow-in-down"></i>
                                                                                                    </button>
                                                                                                </div>
                                                                                                <div class="col-sm-2 col-4 pb-1  d-flex rounded-4">
                                                                                                    <div class="form-check form-switch">
                                                                                                        <input disabled class="form-check-input p-3 px-4" type="checkbox" id="depature_@i" name="depature" onchange="EvaluateBoxes(@Model.EpProgVM.StudentProgsVM.StudentProgs.Count())">
                                                                                                    </div>
                                                                                                    <!-- save temp -->
                                                                                                    <div>
                                                                                                        <button type="submit" asp-action="AddEvaluatoinOnly" asp-controller="Progs" asp-route-Id="@Model.EpProgVM.NewEpisodeProg.Id" class="btn bg-transparent rounded-3 me-2  border-0" id="saveTemp">
                                                                                                            <i class="bi bi-bookmark-check-fill fs-3" style="color:darkgoldenrod;"></i>
                                                                                                        </button>
                                                                                                    </div>

                                                                                                </div>

                                                                                            </div>
                                                                                            <div class="col-sm-12 mb-2">
                                                                                                <p class="text-center" id="notify_@i" style="background-color : PaleGreen">حاضر</p>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div id="collapse_@i" class="collapse mt-2" aria-labelledby="header_@i" data-bs-parent="#accordionExample">
                                                                                            <div class="accordion-body" id="stuAcc_@i">
                                                                                                <div class="row">
                                                                                                    <div class="col-sm-4 mb-1 mb-sm-1">
                                                                                                        <div class="accordion shadow mb-3 py-0" id="accordionExampleev1_@ev">
                                                                                                            <div class="accordion-item  bg-danger-subtle py-0">
                                                                                                                <div class="accordion-header bg-danger-subtle d-flex py-0" id="header_ev1_@ev">
                                                                                                                    <div class="col-sm-12 col-12">
                                                                                                                        <button class=" collapsed  bg-danger-subtle w-100 border-0 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_ev1_@ev" aria-expanded="true" aria-controls="collapse_ev1_@ev">
                                                                                                                            <span class="text-center fw-bolder fs-6">حالة الحضور</span><i class="mt-1 me-2 bi bi-box-arrow-in-down"></i>
                                                                                                                        </button>

                                                                                                                    </div>
                                                                                                                </div>
                                                                                                            </div>

                                                                                                            <div id="collapse_ev1_@ev" class="accordion-collapse collapsed" aria-labelledby="headerev1_@ev" data-bs-parent="#accordionExampleev1_@ev">
                                                                                                                <div class="accordion-body">
                                                                                                                    <div class="form-group mb-2 ">
                                                                                                                        <div class="card-text">
                                                                                                                            <input type="text" hidden id="OstAtt_@i" asp-for="@Model.EpProgVM.LastEvaluateOfStudentProgs.GetValueOrDefault(student).Ev_Attend" />

                                                                                                                            <fieldset id="Oatt_@i" onchange="OCheckDepature(@i,@Model.EpProgVM.StudentProgsVM.StudentProgs.Count())">
                                                                                                                                <label class="ms-1"><input class="form-check-input" id="Oatt0_@i" type="radio" value="0" name="Oatt_@i" checked onchange="document.getElementById('notify_@i').innerText ='حاضر';document.getElementById('notify_@i').style.backgroundColor ='PaleGreen';"> حاضر </label>
                                                                                                                                <br>
                                                                                                                                <label class="ms-1"><input class="form-check-input" id="Oatt1_@i" type="radio" value="1" name="Oatt_@i" onchange="document.getElementById('notify_@i').innerText ='متأخر';document.getElementById('notify_@i').style.backgroundColor ='#FFF085';"> متأخر </label>
                                                                                                                                <br>
                                                                                                                                <label class="me-2"><input class="form-check-input" id="Oatt2_@i" type="radio" value="2" name="Oatt_@i" onchange="document.getElementById('notify_@i').innerText ='مستأذن';document.getElementById('notify_@i').style.backgroundColor ='LightSalmon';"> مستأذن </label>
                                                                                                                                <br>
                                                                                                                                <label class="me-3"><input class="form-check-input" id="Oatt3_@i" type="radio" value="3" name="Oatt_@i" onchange="document.getElementById('notify_@i').innerText ='غائب بإذن';document.getElementById('notify_@i').style.backgroundColor ='Silver';"> غائب بإذن </label>
                                                                                                                                <br>
                                                                                                                                <label class="ms-2"><input class="form-check-input" id="Oatt4_@i" type="radio" value="4" name="Oatt_@i" onchange="document.getElementById('notify_@i').innerText ='غائب';document.getElementById('notify_@i').style.backgroundColor ='Silver';"> غائب </label>
                                                                                                                                <br>
                                                                                                                            </fieldset>
                                                                                                                        </div>
                                                                                                                        <br>
                                                                                                                        <div>
                                                                                                                            <textarea class="form-control" id="Onotes_@i" rows="4" value="" asp-for="@Model.EpProgVM.EvaluationProgs[i].Notes" placeholder=" ملاحظات"></textarea>
                                                                                                                        </div>
                                                                                                                    </div>
                                                                                                                </div>
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                    <div class="col-sm-4 mb-1 mb-sm-1">
                                                                                                        <div class="accordion shadow mb-3 py-0" id="accordionExampleev2_@ev">
                                                                                                            <div class="accordion-item  bg-danger-subtle py-0">
                                                                                                                <div class="accordion-header bg-danger-subtle d-flex py-0" id="header_ev2_@ev">
                                                                                                                    <div class="col-sm-12 col-12">
                                                                                                                        <button class=" collapsed  bg-danger-subtle w-100 border-0 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_ev2_@ev" aria-expanded="true" aria-controls="collapse_ev2_@ev">
                                                                                                                            <span class="text-center fw-bolder fs-6">حالة المقدار</span><i class="mt-1 me-2 bi bi-box-arrow-in-down"></i>
                                                                                                                        </button>
                                                                                                                    </div>
                                                                                                                </div>
                                                                                                            </div>

                                                                                                            <div id="collapse_ev2_@ev" class="accordion-collapse collapsed" aria-labelledby="headerev2_@ev" data-bs-parent="#accordionExampleev2_@ev">
                                                                                                                <div class="accordion-body">
                                                                                                                    <h5 class="card-title text-warning-emphasis fw-bold"> المقدار السابق</h5>
                                                                                                                    <p class="card-text">
                                                                                                                        <div class="row d-flex">
                                                                                                                            <div class="col-6">
                                                                                                                                <div calss="card">
                                                                                                                                    <div class="card-header fw-bold bg-primary-subtle">من</div>
                                                                                                                                    <div class="card-body p-0 d-flex">
                                                                                                                                        <div class="col-8 text-center">
                                                                                                                                            <input type="text" readonly class="form-control fs-6 text-center fw-bold bg-light" value="@student.LessonData.PrevSave_FromSorh  " />
                                                                                                                                        </div>
                                                                                                                                        <div class="col-4 text-center">
                                                                                                                                            <input type="text" readonly class="form-control fs-6 text-center fw-bold bg-light" value="@student.LessonData.PrevSave_FromAyah " />
                                                                                                                                        </div>
                                                                                                                                    </div>
                                                                                                                                </div>
                                                                                                                            </div>
                                                                                                                            <div class="col-6">
                                                                                                                                <div calss="card">
                                                                                                                                    <div class="card-header fw-bold bg-primary-subtle">إلي</div>
                                                                                                                                    <div class="card-body p-0 d-flex">
                                                                                                                                        <div class="col-8 text-center">
                                                                                                                                            <input type="text" readonly class="form-control fs-6 text-center fw-bold bg-light" value="@student.LessonData.PrevSave_ToSorh" />
                                                                                                                                        </div>
                                                                                                                                        <div class="col-4 text-center">
                                                                                                                                            <input type="text" readonly class="form-control fs-6 text-center fw-bold bg-light" value="@student.LessonData.PrevSave_ToAyah" />
                                                                                                                                        </div>
                                                                                                                                    </div>
                                                                                                                                </div>
                                                                                                                            </div>
                                                                                                                        </div>
                                                                                                                    </p>
                                                                                                                    <hr>
                                                                                                                    <h5 class="card-title text-warning fw-bold">المقدار الحالي</h5>
                                                                                                                    <p class="card-text">
                                                                                                                        @if (student.EpisodeProg.SaveDir == "ctp")
                                                                                                                        {
                                                                                                                            <div class="row d-flex">
                                                                                                                                <div class="col-6">
                                                                                                                                    <div calss="card">
                                                                                                                                        <div class="card-header fw-bold bg-warning-subtle">من</div>
                                                                                                                                        <div class="card-body p-0">
                                                                                                                                            <div class="col-12 text-center">
                                                                                                                                                <input type="text" readonly class="form-control text-center fs-6 fw-bold bg-light" value=" @student.LessonData.Save_FromSorh" />
                                                                                                                                            </div>
