@using ExpressTimezone
@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager
@model MasterViewModel

@{
    ViewData["Title"] = "EpisodeProgs";
    var EpisodeProgsData = Model.EpProgVM.EpisodeProgs;
    int cNo = 0;
    var i = 0;
    var j = 0;
    //var pr = 0;

    var utcTime = DateTime.UtcNow;
    //var pcTime = utcTime.UTCToSystemTime();
    //var saTime = utcTime.UTCToRegionalTime("Asia/Riyadh");
    var currentTime = utcTime.UTCToRegionalTime("Asia/Riyadh").TimeOfDay;

    var epStartTime_Fajr = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.FajrTime).TimeOfDay;
    var epEndTime_Fajr = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.EndFajrTime).TimeOfDay;

    var epStartTime_Sunrise = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.SunriseTime).TimeOfDay;
    var epEndTime_Sunrise = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.EndSunriseTime).TimeOfDay;

    var epStartTime_Zohr = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.ZohrTime).TimeOfDay;
    var epEndTime_Zohr = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.EndZohrTime).TimeOfDay;

    var epStartTime_Asr = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.AsrTime).TimeOfDay;
    var epEndTime_Asr = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.EndAsrTime).TimeOfDay;

    var epStartTime_Mghrb = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.MghrbTime).TimeOfDay;
    var epEndTime_Mghrb = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.EndMghrbTime).TimeOfDay;

    var epStartTime_Isha = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.IshaTime).TimeOfDay;
    var epEndTime_Isha = Convert.ToDateTime(Model.EpProgVM.PrayerTimesAPI.EndIshaTime).TimeOfDay;


}

@if (User.IsInRole(Roles.Admin.ToString()))
    EpisodeProgsData = Model.EpProgVM.EpisodeProgs;
else if (User.IsInRole(Roles.Supervisor.ToString()))
    EpisodeProgsData = Model.EpProgVM.EpisodeProgsForMen;
else if (User.IsInRole(Roles.SupervisorWomen.ToString()))
    EpisodeProgsData = Model.EpProgVM.EpisodeProgsForWomen;
else if (User.IsInRole(Roles.SupervisorCenterMen.ToString()))
    EpisodeProgsData = Model.EpProgVM.EpisodeProgsWithSupervisor;
else if (User.IsInRole(Roles.SupervisorCenterWomen.ToString()))
    EpisodeProgsData = Model.EpProgVM.EpisodeProgsWithSupervisor;
else if (User.IsInRole(Roles.Teacher.ToString()))
    EpisodeProgsData = Model.EpProgVM.EpisodeProgsWithTeacher;
else if (User.IsInRole(Roles.TeacherWomen.ToString()))
    EpisodeProgsData = Model.EpProgVM.EpisodeProgsWithTeacher;


<div class="wrapper" dir="rtl">
    <!--Content-Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6 d-flex">
                    <h1 class="m-0 text-dark ms-5">@ResourceApp_Ar.EpisodeProgsPage_EpisodeProgsMain_lbl</h1>

                    @*  <a onclick="getLocation()" class="btn btn-outline-success rounded-circle border-0 fw-bold" style=" -webkit-transform: rotate(45deg);transform: rotate(45deg);">
                        <i class="fs-1 fw-bold bi bi-arrow-clockwise"></i>
                    </a> *@

                    <input hidden type="text" id="userLat">
                    <input hidden type="text" id="userLng">
                    <br>
                    <input hidden type="text" id="intimeEpLat" value="@Model.EpProgVM.EpisodeProgInTime.EpProgLocation.Latitude">
                    <input hidden type="text" id="intimeEpLng" value="@Model.EpProgVM.EpisodeProgInTime.EpProgLocation.Longitude">
                    <br>
                    <input hidden type="text" id="intimeEpId" value="@Model.EpProgVM.EpisodeProgInTime.Id">


                </div>
            </div>
        </div>
    </div>
    <!--End Content-Header-->
    <!-- Main content -->
    <section class="content" dir="rtl">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header py-2">
                        <!-- Button trigger modal -->
                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.ProgEpisodes.Create).Result.Succeeded)
                        {
                            <button type="button"
                                    class="btn btn-outline-primary rounded-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#exampleModal"
                                    onclick="Rest()"
                                    id="addEpisodeProgBtn">
                                <i class="bi bi-plus-circle-dotted fs-5 ps-2"></i> @ResourceApp_Ar.EpisodesPage_AddEpisode_btn
                            </button>
                        }
                           
                            <div class="btn-group  position-absolute start-0 ms-4 " dir="ltr" role="group" aria-label="Button group with nested dropdown">
                                <button type="button" class="btn btn-primary text-white">
                                    خدمات اخري <i class="bi bi-database-check text-white fs-5 ps-2"></i>
                                </button>
                                <div class="btn-group" role="group">
                                    <button id="btnGroupDrop1" type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></button>
                                    <div class="dropdown-menu" aria-labelledby="btnGroupDrop1">

                                         <a class="dropdown-item text-dark fw-bold" asp-action="StudentsWithEpisodeProg" asp-controller="Progs" >
                                        <i class="bi bi-person-rolodex fs-5 pe-2"></i> @ResourceApp_Ar.ProgEpisodesPage_AssigningStudents_btn
                                        </a>

                                        @*
                                        <a class="dropdown-item text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#AddStudentsEpProg">
                                            <i class="bi bi-person-fill-add fs-5 pe-2"></i> اسنـاد الطلاب للحلقة
                                        </a>
                                        <a class="dropdown-item text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#ListEpTypes">
                                            <i class="bi bi-border-width fs-6 pe-2"></i> @ResourceApp_Ar.EpisodeProgsPage_EpisodeProgTypes_btn
                                        </a>
                                        <a class="dropdown-item text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#AssignTeachersToEpisodeProgs">
                                            <i class="bi bi-microsoft-teams fs-6 pe-2"></i> @ResourceApp_Ar.EpisodeProgsPage_AssigningTeachers_btn
                                        </a> *@

                                    </div>
                                </div>
                            </div>
                        
                    </div>

                    <!-- /.card-header -->

                    <div class="card-body" style="background: #FBF8EF;">

                        <!-- Tab links -->
                        <div class="tab bg-danger-subtle" >
                            <button class="tablinks fw-bold bg-danger-subtle fs-6"  onclick="openCity(event, 'EpisodeProgs')" id="defaultOpen">@ResourceApp_Ar.EpisodesPage_Episode_tab</button>
                            @if (User.IsInRole(Roles.Admin.ToString()))
                            {
                                <button class="tablinks fw-bold bg-danger-subtle fs-6" onclick="openCity(event, 'LogEpisodeProgs')" id="defaultTow">Log EpisodeProgs</button>
                            }
                        </div>
                        <!-- Tab content -->
                        @if (!EpisodeProgsData.Any())
                        {
                            <div class="alert  alert-warning mt-5">
                                <h4 class="alert-heading">No EpisodeProgs!</h4>
                                <p class="mb-0">No EpisodeProgs where added yet.</p>
                            </div>
                        }
                        else
                        {
                            @if (User.IsInRole(Roles.Teacher.ToString()) || User.IsInRole(Roles.TeacherWomen.ToString()))
                            {
                                <div class="align-content-center mt-2 align-items-center justify-content-center row " style="background: #FBF8EF;">

                                    @foreach (var episode in EpisodeProgsData)
                                    {
                                        cNo++;
                                        <div class="col-sm-3  mb-3">
                                            <div class="card  text-center" style="background: #FBF8EF;">

                                                <img class="card-img-top bg-transparent  mx-auto " src="~/images/epproglogo.png" style="height:100px;width:auto" alt="zhcenter">
                                                <div class="card-header bg-dark fs-4 text-white fw-bold">@episode.Name</div>
                                                <div class="card-body w-100  ">

                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.teachersPage_teacherName_teachersTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.ApplicationUser.FullName" />
                                                    </div>
                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.EpisodesPage_episodeTime_EpisodesTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.Period" />
                                                    </div>
                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.EpisodesPage_epLocation_EpisodesTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.EpProgLocation.Name" />
                                                    </div>
                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.EpisodesPage_StudentsCount_EpisodesTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.StudentProgs.Count() " />
                                                    </div>
                                                    <div>
                                                        <input hidden id="epLat_@cNo" type="text" value="@episode.EpProgLocation.Latitude">
                                                        <input hidden id="epLng_@cNo" type="text" value="@episode.EpProgLocation.Longitude">
                                                        <input hidden id="epis_@cNo" type="text" value="@episode.Id">
                                                    </div>

                                                </div>
                                                <div class="card-footer bg-white d-flex ">

                                                    @if (episode.AttendType.Contains("عن بعد"))
                                                    {
                                                        if (episode.IsAvilable)
                                                        {
                                                            if (!episode.Status)
                                                            {
                                                                <a class="btn btn-outline-info" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">@ResourceApp_Ar.EpisodesPage_DetailsBtn_Table</a>
                                                            }
                                                            else
                                                            {
                                                                <a class="btn btn-outline-info " asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">@ResourceApp_Ar.EpisodesPage_DetailsBtn_Table</a>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <input type="button" class="btn btn-outline-dark" disabled asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id" value="@ResourceApp_Ar.EpisodesPage_DetailsBtn_Table" />
                                                        }
                                                    }
                                                    else if (episode.AttendType.Contains("حضوري"))
                                                    {
                                                        #region Dark [لم تبدأ بعد]
                                                        if (episode.Period.Contains(PrayerTimesPeriods.الفجر.ToString()) && (currentTime < epStartTime_Fajr))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الشروق.ToString()) && (currentTime < epStartTime_Sunrise))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الظهر.ToString()) && (currentTime < epStartTime_Zohr))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العصر.ToString()) && currentTime < epStartTime_Asr)
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.المغرب.ToString()) && (currentTime < epStartTime_Mghrb))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5 rounded-3"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العشاء.ToString()) && (currentTime < epStartTime_Isha))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        #endregion
                                                        #region Success [ابدأ الحلقة]
                                                        if (episode.IsAvilable && !episode.Status && !episode.ManualFinished && episode.Period == Model.EpProgVM.EpisodeProgInTime.Period)
                                                        {
                                                            <a class="btn btn-success col btn-sm rounded-3" style="visibility:hidden" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id" id="startepi_">
                                                                <i class="bi bi-fingerprint ps-2 fs-5"></i> @ResourceApp_Ar.EpisodesPage_DetailsBtn_Table
                                                            </a>
                                                        }
                                                        #endregion
                                                        #region Warning [حلقة مستمرة]
                                                        if (!episode.ManualFinished && episode.IsAvilable && episode.Status && episode.Period == Model.EpProgVM.EpisodeProgInTime.Period)
                                                        {
                                                            <a class="btn btn-warning col btn-sm rounded-3" style="visibility:hidden" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id" id="startepi_">
                                                                <i class="bi bi-hourglass-split ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_Continue
                                                            </a>
                                                        }
                                                        #endregion
                                                        #region Danger_Manual [انهاء يدوي]

                                                        if (episode.Period.Contains(PrayerTimesPeriods.الفجر.ToString()) && episode.ManualFinished && currentTime > epStartTime_Fajr)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الشروق.ToString()) && episode.ManualFinished && currentTime > epStartTime_Sunrise)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الظهر.ToString()) && episode.ManualFinished && currentTime > epStartTime_Zohr)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العصر.ToString()) && episode.ManualFinished && currentTime > epStartTime_Asr)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.المغرب.ToString()) && episode.ManualFinished && currentTime > epStartTime_Mghrb)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العشاء.ToString()) && episode.ManualFinished && currentTime > epStartTime_Isha)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }

                                                        #endregion
                                                        #region Danger_Auto [انهاء تلقائي]

                                                        if (episode.Period.Contains(PrayerTimesPeriods.الفجر.ToString()) && currentTime > epEndTime_Fajr && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الشروق.ToString()) && currentTime > epEndTime_Sunrise && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الظهر.ToString()) && currentTime > epEndTime_Zohr && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العصر.ToString()) && currentTime > epEndTime_Asr && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.المغرب.ToString()) && currentTime > epEndTime_Mghrb && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العشاء.ToString()) && currentTime > epEndTime_Isha && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisodeProg" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }

                                                        #endregion
                                                    }
                                                    
                                                    @if (AuthorizationService.AuthorizeAsync(User, Permissions.ProgEpisodes.Edit).Result.Succeeded)
                                                    {
                                                        <a class="btn btn-outline-warning p-2 btn-sm  rounded-3" onclick="Edit('@episode.Id', '@episode.Name','@episode.AttendType','@episode.Description','@episode.EpProgLocationId','@episode.ApplicationUserId','@episode.EpProgLocation.Latitude','@episode.EpProgLocation.Longitude','@episode.EpProgLocation.Type','@episode.Period','@episode.EpProgId','@episode.SaveDir','@episode.StartSurah','@episode.EndSurah')" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                                            <i class="bi bi-pencil-square fs-6 ps-2"></i>@ResourceApp_Ar.Page_EditBtn_Table
                                                        </a>
                                                    }

                                                    @if (AuthorizationService.AuthorizeAsync(User, Permissions.ProgEpisodes.Pause).Result.Succeeded)
                                                    {
                                                        if (episode.PauseState > 0)
                                                        {
                                                            <a id="pauseEpisodeProg" class="btn btn-outline-dark btn-sm rounded-3" onclick="Pause('@episode.Id')">
                                                                <i class="bi bi-pause-circle fs-6 ps-2"></i> @ResourceApp_Ar.Page_PauseBtn_Table
                                                            </a>

                                                            @*  if ((episode?.Status) == false)
                                                                            {
                                                                                <input type="button" id="pauseEpisodeProg" class="btn btn-outline-dark" onclick="Pause('@episode.Id')" value=" @ResourceApp_Ar.Page_PauseBtn_Table" />
                                                                            }
                                                                            else
                                                                            {
                                                                                <input type="button" disabled id="pauseEpisodeProg" class="btn btn-outline-dark" onclick="Pause('@episode.Id')" value=" @ResourceApp_Ar.Page_PauseBtn_Table" />
                                                                            } *@
                                                        }
                                                        else
                                                        {
                                                            <a id="pauseEpisodeProg" class="btn btn-outline-success btn-sm rounded-3" onclick="Resume('@episode.Id')">
                                                                <i class="bi bi-play-circle fs-6 ps-2"></i>  @ResourceApp_Ar.Page_ResumeBtn_Table
                                                            </a>
                                                        }
                                                    }

                                                    @if (AuthorizationService.AuthorizeAsync(User, Permissions.ProgEpisodes.Delete).Result.Succeeded)
                                                    {
                                                        <a class="btn btn-danger p-2 btn-sm rounded-3" onclick="Delete('@episode.Id')">
                                                            <i class="bi bi-trash fs-6 ps-2"></i>@ResourceApp_Ar.Page_DeleteBtn_Table
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!User.IsInRole(Roles.Teacher.ToString()) || !User.IsInRole(Roles.TeacherWomen.ToString()))
                            {
                                <div id="EpisodeProgs" class="tabcontent ps-0 pe-0">
                                    <table id="tableEpisodeProg" class="table table-hover mt-4  ">
                                        <thead>
                                            <tr class="fw-bolder">

                                                <td class="text-center p-0">@ResourceApp_Ar.EpisodesPage_episodeName_EpisodesTable</td>
                                                <td class="text-center p-0">@ResourceApp_Ar.teachersPage_teacherName_teachersTable</td>
                                                <td class="text-center p-0">@ResourceApp_Ar.EpisodesPage_episodeTime_EpisodesTable</td>
                                                <td class="text-center p-0">@ResourceApp_Ar.EpisodesPage_epLocation_EpisodesTable</td>
                                                <td class="align-items-end p-0"></td>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var episode in EpisodeProgsData)
                                            {
                                                cNo++;

                                                <tr>


                                                    <td class="text-center">
                                                        <img src="~/images/epproglogo.png" alt="dis" height="45">
                                                        <br>
                                                        @episode.Name
                                                    </td>
                                                    <td class="text-center">@episode.ApplicationUser.FullName</td>
                                                    <td class="text-center">@episode.Period</td>
                                                    <td class="text-center">@episode.EpProgLocation.Name</td>
                                                    
                                                    <td class="text-center">
                                                        @if (episode.AttendType.Contains("عن بعد"))
                                                        {
