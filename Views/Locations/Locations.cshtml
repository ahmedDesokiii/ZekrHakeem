@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager

@model MasterViewModel

@{
    ViewData["Title"] = "المساجد / الدور";

    var LocationsData = Model.LocationVM.Locations;

    if (User.IsInRole(Roles.Admin.ToString()))
        LocationsData = Model.LocationVM.Locations;
    else if (User.IsInRole(Roles.Supervisor.ToString()))
        LocationsData = Model.LocationVM.LocationsForMen;
    else if (User.IsInRole(Roles.SupervisorWomen.ToString()))
        LocationsData = Model.LocationVM.LocationsForWomen;
    else if (User.IsInRole(Roles.SupervisorCenterMen.ToString()) || User.IsInRole(Roles.SupervisorCenterWomen.ToString()))
        LocationsData = Model.LocationVM.LocationsWithSupervisor;
}

<section class="container-fluid locations-page">
    <div class="row justify-content-center">
        <div class="col-12 col-xxl-10">

            <div class="card locations-card shadow-sm border-0 my-4 overflow-hidden rounded-top-5">

                <!-- Header -->
                
                <div class="card-header border-0 py-3 px-4 rounded-top-5"
                     style="background:linear-gradient(135deg,#FBF8EF,#B1F0F7);">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>
                            <h3 class="fw-bold mb-1 text-dark">
                                <i class="bi bi-geo-alt-fill ms-2"></i>
                                المساجد والدور
                            </h3>

                            <div class="text-muted small">
                                إدارة المساجد والدور التعليمية
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">

                            @if (AuthorizationService.AuthorizeAsync(User, Permissions.Locations.Create).Result.Succeeded)
                            {
                                <button type="button"
                                        class="btn btn-success shadow-sm px-4"
                                        data-bs-toggle="modal"
                                        data-bs-target="#locationModal"
                                        onclick="Rest()">

                                    <i class="bi bi-plus-circle ms-2"></i>
                                    إضافة مسجد / دار
                                </button>
                            }

                        </div>

                    </div>
                </div>

                <!-- Body -->
                <div class="card-body px-3 px-md-4 py-4">
                    @if (!LocationsData.Any())
                    {
                        <div class="alert alert-warning text-center shadow-sm rounded-4">
                            <h5 class="fw-bold mb-2">لا توجد بيانات</h5>
                            <p class="mb-0">لم يتم إضافة أي مسجد أو دار حتى الآن</p>
                        </div>
                    }
                    else
                    {
                        <!-- Search Mobile -->
                        <div class="d-block d-md-none mb-3">
                            <input type="text"
                                   id="locationSearch"
                                   class="form-control shadow-sm"
                                   placeholder="ابحث باسم المسجد أو المركز..." />
                        </div>

                        <!-- Mobile Cards -->
                        <div class="d-block d-md-none"
                             id="locationsCardsContainer"
                             style="max-height:75vh;overflow-y:auto;">

                            @foreach (var location in LocationsData)
                            {
                                <div class="card border-0 shadow-sm mb-3 rounded-4 overflow-hidden location-card"
                                     data-name="@location.Name?.ToLower()"
                                     data-center="@location.LoCenter?.Name?.ToLower()">

                                    <div class="card-header border-0 text-white py-3"
                                         style="background:linear-gradient(135deg,#54C392,#15B392,#0EA5A4);">

                                        <div class="d-flex align-items-center">

                                            <div class="location-icon">
                                                <i class="bi bi-building fs-3"></i>
                                            </div>

                                            <div class="ms-3">
                                                <h5 class="mb-0 fw-bold">
                                                    @location.Name
                                                </h5>

                                                <small class="opacity-75">
                                                    @(location.Type == "mosque" ? "مساجد رجال" : "دور نساء")
                                                </small>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="card-body py-3">

                                        <div class="info-row">
                                            <span class="label">المركز</span>
                                            <span class="value">@location.LoCenter?.Name</span>
                                        </div>

                                        <div class="info-row">
                                            <span class="label">الحي</span>
                                            <span class="value">@location.District?.Name</span>
                                        </div>

                                        <div class="info-row">
                                            <span class="label">الحلقات</span>
                                            <span class="value">@location.Episodes?.Count()</span>
                                        </div>

                                        <div class="info-row">
                                            <span class="label">عدد الطلاب</span>
                                            <span class="value">@location.TotalStudents</span>
                                        </div>

                                    </div>

                                    <div class="card-footer bg-white border-0 py-3">

                                        <div class="d-flex justify-content-center flex-wrap gap-2">

                                            <a class="btn btn-info btn-sm rounded-pill px-3"
                                                   asp-action="SelectedLocation"
                                                   asp-controller="Locations"
                                                   asp-route-id="@location.Id" title="تفاصيل">

                                                <i class="bi bi-eye-fill"></i>
                                            </a>

                                            @if (AuthorizationService.AuthorizeAsync(User, Permissions.Locations.Edit).Result.Succeeded)
                                            {
                                                <button class="btn btn-warning btn-sm rounded-pill px-3 text-white"
                                                        onclick="Edit(
                                                    '@location.Id',
                                                    '@location.Name',
                                                    '@location.Type',
                                                    '@location.Description',
                                                    '@location.LoCenterId',
                                                    '@location.Latitude',
                                                    '@location.Longitude',
                                                    '@location.DistrictId')"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#locationModal" title="تعديل">

                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            }

                                            @if (AuthorizationService.AuthorizeAsync(User, Permissions.Locations.Pause).Result.Succeeded)
                                            {
                                                if (location.PauseState > 0)
                                                {
                                                    <button class="btn btn-dark btn-sm rounded-pill px-3"
                                                            onclick="Pause('@location.Id')" title="ايقاف مؤقت">

                                                        <i class="bi bi-pause-circle"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-success btn-sm rounded-pill px-3"
                                                            onclick="Resume('@location.Id')" title="اعادة تشغيل">

                                                        <i class="bi bi-play-circle"></i>
                                                    </button>
                                                }
                                            }

                                            @if (AuthorizationService.AuthorizeAsync(User, Permissions.Locations.Delete).Result.Succeeded)
                                            {
                                                <button class="btn btn-danger btn-sm rounded-pill px-3"
                                                        onclick="Delete('@location.Id')" title="حذف">

                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                        <!-- Desktop Table -->
                        <div class="d-none d-md-block">

                            <div class="table-responsive rounded-4 overflow-hidden shadow-sm">

                                <table class="table align-middle mb-0 locations-table"
                                       id="tableLocation">

                                    <thead>

                                        <tr>
                                            <th class="text-center py-3"></th>
                                            <th class="text-center py-3">المسجد / الدار</th>
                                            <th class="text-center py-3">المركز</th>
                                            <th class="text-center py-3">الحي</th>
                                            <th class="text-center py-3">الحلقات</th>
                                            <th class="text-center py-3">الطلاب</th>
                                            <th class="text-center py-3">الحالة</th>
                                            <th class="text-center py-3">الإجراءات</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var location in LocationsData)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="table-location-icon">
                                                        <i class="bi bi-geo-alt-fill"></i>
                                                    </div>
                                                </td>
                                                <td class="text-center fw-bold">
                                                    <div class="d-flex align-items-center justify-content-center">
                                                        <div>
                                                            <div>@location.Name</div>

                                                            <small class="text-muted">
                                                                @(location.Type == "mosque" ? "مساجد رجال" : "دور نساء")
                                                            </small>
                                                        </div>

                                                    </div>

                                                </td>

                                                <td class="text-center">
                                                    @location.LoCenter?.Name
                                                </td>

                                                <td class="text-center">
                                                    @location.District?.Name
                                                </td>

                                                <td class="text-center fw-bold">
                                                    @location.Episodes?.Count()
                                                </td>

                                                <td class="text-center fw-bold">
                                                    @location.TotalStudents
                                                </td>

                                                <td class="text-center">

                                                    @if (location.PauseState > 0)
                                                    {
                                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                                            نشط
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger rounded-pill px-3 py-2">
                                                            متوقف
                                                        </span>
                                                    }

                                                </td>

                                                <td class="text-center">

                                                    <div class="d-flex justify-content-center flex-wrap gap-2">

                                                        <a class="btn btn-outline-info btn-sm border-0 fs-4"
                                                               asp-action="SelectedLocation"
                                                               asp-controller="Locations"
                                                               asp-route-id="@location.Id"
                                                                title="تفاصيل">

                                                            <i class="bi bi-eye-fill"></i>
                                                        </a>

                                                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Locations.Edit).Result.Succeeded)
                                                        {
                                                            <button class="btn btn-outline-warning btn-sm border-0 fs-4"
                                                                    onclick="Edit(
                                                                '@location.Id',
                                                                '@location.Name',
                                                                '@location.Type',
                                                                '@location.Description',
                                                                '@location.LoCenterId',
                                                                '@location.Latitude',
                                                                '@location.Longitude',
                                                                '@location.DistrictId')"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#locationModal"
                                                                    title="تعديل">

                                                                <i class="bi bi-pencil-square"></i>
                                                            </button>
                                                        }

                                                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Locations.Pause).Result.Succeeded)
                                                        {
                                                            if (location.PauseState > 0)
                                                            {
                                                                <button class="btn btn-outline-dark btn-sm border-0 fs-4"
                                                                        onclick="Pause('@location.Id')" title=" ايقاف مؤقت">

                                                                    <i class="bi bi-pause-circle"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button class="btn btn-outline-success btn-sm border-0 fs-4"
                                                                        onclick="Resume('@location.Id')" title="اعادة تشغيل">

                                                                    <i class="bi bi-play-circle"></i>
                                                                </button>
                                                            }
                                                        }

                                                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Locations.Delete).Result.Succeeded)
                                                        {
                                                            <button class="btn btn-outline-danger btn-sm border-0 fs-4"
                                                                    onclick="Delete('@location.Id')" title="حذف">

                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }

                                                    </div>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>
</section>

<!-- Modal -->
<div class="modal fade"
     id="locationModal"
     tabindex="-1"
     aria-hidden="true"
     dir="rtl">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 rounded-4 overflow-hidden">

            <div class="modal-header border-0 text-white"
                 style="background:linear-gradient(135deg,#0d6efd,#0AC4E0);">

                <h5 class="modal-title fw-bold" id="title">
                    <i class="bi bi-building ms-2"></i>
                    إضافة مسجد / دار
                </h5>

                <button type="button"
                        class="btn-close btn-close-white position-absolute start-0 mx-3"
                        data-bs-dismiss="modal"></button>

            </div>

            <form asp-action="Save"
                  asp-controller="Locations"
                  method="post">

                <div class="modal-body p-3">
                    <div class="row">
                        <div class="col-md-4 col-12">
                            <input type="hidden"
                                   asp-for="LocationVM.NewLocation.Id"
                                   id="LocationId" />

                            <!-- Name -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    اسم المسجد / الدار
                                </label>

                                <input type="text"
                                       class="form-control"
                                       asp-for="LocationVM.NewLocation.Name"
                                       id="LocationName"
                                       placeholder="أدخل الاسم..." />

                                <span asp-validation-for="LocationVM.NewLocation.Name"
                                      class="text-danger"></span>
                            </div>

                            <!-- Type -->
                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    النوع
                                </label>

                                <select class="form-select"
                                        asp-for="LocationVM.NewLocation.Type"
                                        id="LocationType">

                                    <option disabled selected>
                                        اختر النوع
                                    </option>

                                    <option value="mosque">
                                        مساجد رجال
                                    </option>

                                    <option value="dar">
                                        دور نساء
                                    </option>

                                </select>

                            </div>

                            <!-- Center -->
                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    المركز
                                </label>

                                <select class="form-select"
                                        asp-for="LocationVM.NewLocation.LoCenterId"
                                        id="CenterIdSelect">

                                    <option disabled selected>
                                        اختر المركز
                                    </option>

                                    @foreach (var center in Model.LocationVM.CVM.Centers)
                                    {
                                        <option value="@center.Id">
                                            @center.Name
                                        </option>
                                    }

                                </select>

                            </div>

                            <!-- District -->
                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    الحي
                                </label>

                                <select class="form-select"
                                        asp-for="LocationVM.NewLocation.DistrictId"
                                        id="districtId">

                                    <option disabled selected>
                                        اختر الحي
                                    </option>

                                    @foreach (var district in Model.LocationVM.Districts)
                                    {
                                        <option value="@district.Id">
                                            @district.Name
                                        </option>
                                    }

                                </select>

                            </div>

                            <!-- Description -->
                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    الوصف
                                </label>

                                <textarea class="form-control"
                                          asp-for="LocationVM.NewLocation.Description"
                                          id="description"
                                          rows="4"></textarea>

                            </div>
                        </div>
                        <div class="col-md-8">
                        
                            <!-- Hidden -->
                            <input type="hidden"
                                   asp-for="LocationVM.NewLocation.Latitude"
                                   id="txtLatitude" />

                            <input type="hidden"
                                   asp-for="LocationVM.NewLocation.Longitude"
                                   id="txtLongitude" />

                            <!-- Map -->
                            <!-- قائمة اختيار نوع الخريطة -->
                            <div class="input-groupovd mb-2 d-flex">
                                <label class="input-group-text ms-2" for="mapType">
                                    نوع الخريطة
                                    <img src="~/images/355980.png" class="pe-3" style="height:30px;" />
                                </label>
                                <select id="mapType" class="form-select" onchange="changeMapType(this.value)">
                                    <option value="roadmap">خريطة الشوارع</option>
                                    <option value="satellite">قمر صناعي</option>
                                    <option value="hybrid">هجين</option>
                                    <option value="terrain">تضاريس</option>
                                </select>
                            </div>
                            <div id="map" class="rounded-4 overflow-hidden shadow h-75" ></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 px-3">

                    <button type="submit"
                            class="btn btn-success px-4">

                        <i class="bi bi-check-circle ms-2"></i>
                        حفظ البيانات
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">

                        إلغاء
                    </button>
                    </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @* <script src="~/js/Locations.js"></script> *@

    <script>
        document.getElementById('locationSearch')?.addEventListener('input', function () {

            const query = this.value.toLowerCase();

            document.querySelectorAll('.location-card').forEach(card => {

                const name = card.dataset.name || '';
                const center = card.dataset.center || '';

                card.style.display =
                    name.includes(query) || center.includes(query)
                    ? ''
                    : 'none';

            });

        });
    </script>

}