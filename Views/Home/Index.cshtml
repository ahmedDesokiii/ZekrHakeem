                            <img src="~/images/loclogo.png" alt="dis" height="60">
                            <br>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:25px;color:#328E6E;font-weight:700">
                                عدد المساجد
                            </p>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:30px;color:#328E6E;font-weight:700">
                                @* @Model.total_Locations *@ 50
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 ms-2">
                    <div class="card border-0 bg-transparent">
                        <div class="card-header text-center bg-transparent border-0">
                            <img src="~/images/epproglogo.png" alt="dis" height="60">
                            <br>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:25px;color:#328E6E;font-weight:700">
                                عدد الحلقات
                            </p>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:30px;color:#328E6E;font-weight:700">
                                @* @Model.total_Episodes *@ 50
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 ms-2">
                    <div class="card border-0 bg-transparent">
                        <div class="card-header text-center bg-transparent border-0">
                            <img src="~/images/finishstulogo.png" alt="dis" height="60">
                            <br>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:25px;color:#328E6E;font-weight:700">
                                خاتمي القرآن
                            </p>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:30px;color:#328E6E;font-weight:700">
                                500 +
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-3 col-sm-2 pt-3 pe-0 me-0" dir="rtl">
            <img src="images/About/rev00.png" alt="" style="height:200px;width:auto">
        </div>
    </div>

</section>

