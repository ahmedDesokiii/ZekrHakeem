<section class="section countsZH pt-0 mt-0 " id="countsZH" style="background-color:#B1F0F7">
    <div class="d-flex pt-0 mt-0">
        <div class="col-2 pt-3 ps-0 ms-0">
        </div>
        <div class="col-7 col-sm-8 align-items-center justify-content-center text-center" dir="rtl">
            <p class="homeTitle  shadow" style="font-size:40px;color:#328E6E;font-weight:700">
                الذكر الحكيم في ارقام 
            </p>
            <div class="row">
                <div class="col-sm-2 ms-2">
                    <div class="card border-0 bg-transparent">
                        <div class="card-header text-center bg-transparent border-0">
                            <img  src="~/images/stu.svg" alt="dis" height="60">
                            <br>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:25px;color:#328E6E;font-weight:700">
                                عدد الطلاب
                            </p>
                            <p class="homeTitle align-items-center justify-content-center text-center" style="font-size:30px;color:#328E6E;font-weight:700">
                                @* @Model.total_Students *@ 50
                            </p>
                        </div>
                    </div>
                </div>
