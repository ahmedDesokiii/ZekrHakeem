

@{
    ViewData["Title"] = "Home Page";
}


    <!-- Home Section -->
<section class="home mb-0" id="home">
        <div class="home-content d-flex ">
            <div class="swiper mySwiper rounded-3">
                <div class="swiper-wrapper">
                    
                    <div class="swiper-slide d-flex">
                    <div class="col-1 col-sm-2"></div>
                    <div class="col-10 col-sm-8">
                        <img src="images/home/home003.png" alt="" class="align-items-center justify-content-center w-100 h-auto lh-sm ">
                    </div>
                    <div class="col-1 col-sm-2"></div>

                </div>
                    
                    <div class="swiper-slide d-flex">
                        <div class="col-1 col-sm-2"></div>
                        <div class="col-4 col-sm-4">
                            <img src="images/home/ht01.png" alt="" class=" lh-sm w-auto" style="height:275px">
                        </div>

                        <div class="home-details me-2 col-6 col-sm-4">
                            <div class="home-text" dir="rtl">

                                <p class="homeTitle" style="font-size:40px;color:#328E6E;font-weight:700">كفالة طالب علم </p>
                                <h4 class="homeSubtitle" style="font-size:18px !important">
                                كفالة طالب العلم تدخل في الصدقة الجارية
                                إذا أثمرت علماً نافعاً أو جيلاً من الطلاب يتعلمون وينقلون العلم من بعدهم.
                            </h4>
                                <button class="btn btn-outline-primary align-content-center ">تبرع لكفالة طالب علم </button>
                            </div>
                        </div>
                        <div class="col-1 col-sm-2"></div>
                </div>

                    <div class="swiper-slide d-flex">
                        <div class="col-1 col-sm-2"></div>
                        <div class="col-4 col-sm-4">
                            <img src="images/home/ht003.png" alt="" class=" lh-sm w-auto" style="height:275px">
                        </div>
                        <div class="home-details me-2 col-6 col-sm-4">
                            <div class="home-text" dir="rtl">

                                <p class="homeTitle" style="font-size:40px;color:#328E6E;font-weight:700">كفالة حلقة قرآنية </p>
                                <h4 class="homeSubtitle" style="font-size:18px !important">
                                    ساهم في كفالة حلقة قرآنية فكل من يحفظ أو يقرأ كلام الله سيأتيك أجره
                                    وكل من يتعلم حرفًا ويعلّم به أحدًا سيكون لك مثل أجره
                                </h4>
                                <button class="btn btn-outline-primary align-content-center ">تبرع لكفالة حلقة قرآنية </button>
                            </div>
                        </div>
                        <div class="col-1 col-sm-2"></div>    
                    </div>

                    <div class="swiper-slide d-flex">
                    <div class="col-1 col-sm-2"></div>
                    <div class="col-4 col-sm-4">
                        <img src="images/home/ht02.png" alt="" class=" lh-sm w-auto" style="height:275px">
                    </div>
                    <div class="home-details me-2 col-6 col-sm-4">
                        <div class="home-text" dir="rtl">

                            <p class="homeTitle" style="font-size:40px;color:#328E6E;font-weight:700">حلقة قرآنية للنساء </p>
                            <h4 class="homeSubtitle" style="font-size:18px !important">
                                حلقات تُعنى بتعليم القرآن الكريم للبنات بمختلف الفئات العمرية.
                            </h4>
                            <button class="btn btn-outline-primary align-content-center ">تبرع لكفالة حلقة قرآنية </button>
                        </div>
                    </div>
                    <div class="col-1 col-sm-2"></div>
                </div>

                    <div class="swiper-slide d-flex">
                    <div class="col-1 col-sm-2"></div>
                    <div class="col-4 col-sm-4">
                        <img src="images/home/ht04.png" alt="" class=" lh-sm w-auto" style="height:275px">
                    </div>
                    <div class="home-details me-2 col-6 col-sm-4">
                        <div class="home-text" dir="rtl">

                            <p class="homeTitle" style="font-size:40px;color:#328E6E;font-weight:700">حلقات تعليمية متميزة </p>
                            <h4 class="homeSubtitle" style="font-size:18px !important">
                                فضل حلقات تحفيظ القرآن الكريم عظيم، فهي تقرب المسلم إلى الله وتجعله من أهل القرآن وخاصته
                            </h4>
                            <button class="btn btn-outline-primary align-content-center ">التسجيل بالحلقات </button>
                        </div>
                    </div>
                    <div class="col-1 col-sm-2"></div>
                </div>

                </div>
                <div class="swiper-button-next swiper-navBtn" style="top:35% !important"></div>
                <div class="swiper-button-prev swiper-navBtn" style="top:35% !important"></div>
                <div class="swiper-pagination pt-5"></div>
            </div>
        </div>
    </section>

