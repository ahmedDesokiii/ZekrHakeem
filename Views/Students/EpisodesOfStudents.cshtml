                    <input type="text" class="form-control" asp-for="StudentVM.NewHealth.Id" hidden id="HealthId" />
                    <input type="text" class="form-control" hidden asp-for="StudentVM.NewHealth.Num" id="HealthNum" value="@(Model.StudentVM.HealthConditions.Count())" />
                    <div class="input-group mb-2">
                        <span class="input-group-text">@ResourceApp_Ar.StudentHealthModal_HealthName_lbl</span>
                        <input type="text" class="form-control" asp-for="StudentVM.NewHealth.Name" id="HealthName" placeholder="@ResourceApp_Ar.StudentHealthModal_HealthName_txt" />

                        <span asp-validation-for="StudentVM.NewHealth.Name" class="text-danger"></span>
                    </div>

                    <div class="modal-footer mt-2" style="padding:0 15px 15px 0">
                        <input type="submit" class="btn btn-success" value="@ResourceApp_Ar.Modal_Save_btn" id="btnSaveStHealth" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@ResourceApp_Ar.Modal_Cancle_btn</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>

        $(document).ready(function(){
            GetVersesBySurah_CTP();
            GetVersesBySurah_PTC();
        })
        $("#surahId_ctp").change(function(){
            GetVersesBySurah_CTP();

        });
         var GetVersesBySurah_CTP = function(){
          $.ajax({
                url: '@Url.Action("GetVersesBySurah", "Students")',
                type : 'GET',
                data:{
                    surahId:$('#surahId_ctp').val(),
                },
                success: function(data){
                    $('#verseId_ctp').find('option').remove()
                    $(data).each(
                        function(index , item){
                            $("#verseId_ctp").append('<option value = "'+item.Id+'">'+item.num + '</option>')
                        }
                    )
                }
          })
        }


        $("#surahId_ptc").change(function(){
            GetVersesBySurah_PTC();

