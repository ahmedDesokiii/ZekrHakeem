@section Scripts {
    <script>

        $(document).ready(function(){
            GetVersesBySurah();
        })
        $("#surahId").change(function(){
            GetVersesBySurah();

        });
        var GetVersesBySurah = function(){
          $.ajax({
                url: '@Url.Action("GetVersesBySurah", "Students")',
                type : 'GET',
                data:{
                    surahId:$('#surahId').val(),
                },
                success: function(data){
                    $('#verseId').find('option').remove()
                    $(data).each(
                        function(index , item){
                            $("#verseId").append('<option value = "'+item.Id+'">'+item.num + '</option>')
                        }
                    )
                }
          })
        }

    </script>
    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        if (Context.Session.GetString(Helper.MsgType) == Helper.Success)
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'success'
                });
            </script>

        }
        else
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'error'
                });
            </script>
        }
        Context.Session.SetString(Helper.MsgType, "");
    }
