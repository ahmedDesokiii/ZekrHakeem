@using ExpressTimezone
@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager
@model MasterViewModel

@{
    ViewData["Title"] = "Episodes Of Students";
    // List<Student> StudentsData = null;
    // List<Episode> EpisodesData = null;
    var StudentsData = Model.EpisodeVM.StudentsVM.Students;
    var EpisodesData = Model.EpisodeVM.StudentsVM.EVM.Episodes;
    int cNo = 0;
    int limi = 0;
    int l = 0;
}

@if (User.IsInRole(Roles.Admin.ToString()))
    EpisodesData = Model.EpisodeVM.StudentsVM.EVM.Episodes;
else if (User.IsInRole(Roles.Supervisor.ToString()))
    EpisodesData = Model.EpisodeVM.StudentsVM.EVM.EpisodesForMen;
else if (User.IsInRole(Roles.SupervisorWomen.ToString()))
    EpisodesData = Model.EpisodeVM.StudentsVM.EVM.EpisodesForWomen;
else if (User.IsInRole(Roles.SupervisorCenterMen.ToString()) || User.IsInRole(Roles.SupervisorCenterWomen.ToString()))
    EpisodesData = Model.EpisodeVM.StudentsVM.EVM.EpisodesWithSupervisor;
else if (User.IsInRole(Roles.Teacher.ToString()) || User.IsInRole(Roles.TeacherWomen.ToString()))
    EpisodesData = Model.EpisodeVM.StudentsVM.EVM.EpisodesWithTeacher;


<div class="wrapper" dir="rtl">
    <!--Content-Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6 d-flex">
                    <h1 class="m-0 text-dark ms-5">@ResourceApp_Ar.StudentsPage_StudentsMain_lbl | <span class="text-info">@Model.EpisodeVM.NewEpisode.Name</span></h1>
                </div>
            </div>
        </div>
    </div>
    <!--End Content-Header-->
    <!-- Main content -->
    <section class="content" dir="rtl">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header ">
                        <div class="card-header d-flex">
                            <div class="card-tools ">
                                <!-- Button trigger modal -->
                                @if (AuthorizationService.AuthorizeAsync(User, Permissions.Students.Create).Result.Succeeded)
                                {
                                    <button type="button"
                                            class="btn btn-outline-primary rounded-3" data-bs-toggle="modal" data-bs-target="#exampleModalst" onclick="Rest()">
                                        <i class="bi bi-plus-circle-dotted fs-5 ps-2"></i>   @ResourceApp_Ar.StudentsPage_AddStudent_btn 
                                    </button>
                                }
                                
                            </div>
                        </div>
                        <!-- /.card-header -->

                        <div class="card-body  " style="background: #FBF8EF;">
                            <!-- Tab links -->
                            <div class="tab" style="background: #CBF7DC;">
                                @if (!User.IsInRole(Roles.Parent.ToString()))
                                {
                                    <button class="tablinks fs-6 fw-bold" style="background: #CBF7DC;" onclick="openCity(event, 'Students')" id="defaultOpen">
                                        @ResourceApp_Ar.SelectedEpisodeStudentsPage_Studentslist_tab | <span class="text-info">@Model.EpisodeVM.NewEpisode.Name</span>
                                    </button>
                                }
                                @if (User.IsInRole(Roles.Admin.ToString()))
                                {
                                    <button class="tablinks fs-6 fw-bold" onclick="openCity(event, 'LogStudents')" id="defaultTow">Log Students</button>
                                }
                            </div>
                            <!-- Tab content -->
                            @if (!StudentsData.Any())
                            {
                                <div class="alert  alert-warning mt-5">
                                    <h4 class="alert-heading">No Students Of Episodes!</h4>
                                    <p class="mb-0">No Students Of Episodes where added yet.</p>
                                </div>
                            }
                            else
                            {
                                <div id="Students" class="tabcontent">
                                    <table id="tableStudents" class="table table-hover mt-4 ">
                                        <thead>
                                            <tr class="fw-bolder">
                                                <td></td>
                                                <td></td>
                                                <td class="text-center">@ResourceApp_Ar.StudentsPage_studentName_StudentsTable</td>
                                                <td class="text-center">@ResourceApp_Ar.PlansPage_PlanName_PlansTable</td>
                                                <td></td>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var student in StudentsData)
                                            {
                                                cNo++;
                                                <tr>
                                                    <td class="text-center">@cNo</td>
                                                    <td class="text-center"><img src="~/images/stu.svg" alt="stu" width="50" height="50"></td>
                                                    <td class="text-center">@student.Name</td>
                                                    <td class="text-center">@student.PlanData.Name</td>
                                                    <td class="text-center">
                                                        <a class="btn btn-success btn-sm rounded-3" asp-controller="Students" asp-action="SelectedStudent" asp-route-Id="@student.Id">
                                                            <i class="bi bi-person-vcard fs-6 ps-2"></i> @ResourceApp_Ar.Page_DetailsBtn_Table
                                                        </a>
                                                        <br>
                                                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Students.Edit).Result.Succeeded)
                                                        {
                                                            <a class="btn btn-outline-warning btn-sm rounded-3" onclick=" Edit('@student.Id',
                                                                                                                                                                    '@student.Name',
                                                                                                                                                                    '@student.Category',
                                                                                                                                                                    '@student.IdentityNumber',
                                                                                                                                                                    '@student.ParentIdentityNumber',
                                                                                                                                                                    '@student.ParentPhoneNumber',
                                                                                                                                                                    '@student.NationalityId',
                                                                                                                                                                    '@student.HealthConditionId',
                                                                                                                                                                    '@student.Gender',
                                                                                                                                                                    '@student.EducationType',
                                                                                                                                                                    '@student.StEpisodeId',
                                                                                                                                                                    '@student.StEpisode.LimitStudents',
                                                                                                                                                                    '@student.StEpisode.Students.Count()',
                                                                                                                                                                    '@student.LessonData.LevelData.PlanDataId',
                                                                                                                                                                    '@student.LessonDataId',
                                                                                                                                                                    '@student.BirthDate',
                                                                                                                                                                    '@student.ProfilePicture',
                                                                                                                                                                    '@student.Adress',
                                                                                                                                                                    '@student.Notes',
                                                                                                                                                                    '@student.SaveDirection',
                                                                                                                                                                    '@student.VerseId',
                                                                                                                                                                    '@student.SurahId'


                                                                                                                                                                    )" data-bs-toggle="modal" data-bs-target="#exampleModalst" >
                                                                <i class="bi bi-pencil-square fs-6 ps-2"></i>  @ResourceApp_Ar.Page_EditBtn_Table
                                                            </a>
                                                        }
                                                        <br>
                                                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Students.Delete).Result.Succeeded)
                                                        {
                                                            <a  class="btn btn-danger btn-sm rounded-3" onclick="Delete('@student.Id')" >
                                                                <i class="bi bi-trash fs-6 ps-2"></i> @ResourceApp_Ar.Page_DeleteBtn_Table
                                                            </a>
                                                        }


                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (AuthorizationService.AuthorizeAsync(User, Permissions.Students.DeleteLog).Result.Succeeded)
                            {
                                <div id="LogStudents" class="tabcontent">
                                    <table id="tableLogStudent" class="table table-bordered table-hover">
                                        <thead>
                                            <tr class="bg-primary fw-bolder text-white">
                                                <td>#</td>
                                                <td>Student Name</td>
                                                <td>ActionName</td>
                                                <td>Date</td>
                                                <td>UserName</td>
                                                <td>Events</td>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.EpisodeVM.StudentsVM.LogStudents)
                                            {
                                                <tr>
                                                    <td>#</td>
                                                    <td>@item.Student.Name</td>
                                                    <td>@item.Action</td>
                                                    <td>@item.Date</td>
                                                    <td>@userManager.FindByIdAsync(item.UserId.ToString()).Result?.FullName</td>

                                                    <td>

                                                        <input type="button" class="btn btn-danger p-2 btn-sm" onclick="DeleteLog('@item.Id')" value="Delete" />


                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                             
                         </div>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                    <!-- /.card -->
                </div>
                <!-- /.col -->
            </div>
            <!-- /.row -->
    </section>
    <!-- /.content -->
</div>


<!-- Modal Student -->
<div class="modal fade" id="exampleModalst" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog card card-success card-outline">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h4 class="modal-title" id="title">@ResourceApp_Ar.StudentsModal_AddNewStudent_lbl</h4>
                <a href="#" class="btn-close ms-1" data-bs-dismiss="modal" aria-label="Close"></a>
            </div>
            <div class="modal-body">
                <form asp-action="Save" asp-controller="Students" method="post" asp-route-Id="@Model.EpisodeVM.NewEpisode.Id" enctype="multipart/form-data">
                    <div class="form-group mb-2">
                        <img id="stPhoto" alt="profile" class="rounded-circle mx-auto d-block bg-light" style="height:100px;width:100px;object-fit:contain" src="~/images/stu.svg" />
                        @* <img class="cover-preview d-none" alt="Cover" /> *@
                    </div>

                    <div><input type="text" hidden class="input-group" asp-for="@Model.EpisodeVM.SelectStudent.Id" id="stId"></div>

                    <div class="accordion shadow mb-3 py-0" id="accordionExamplez">
                        <div class="accordion-item  bg-danger-subtle py-0">
                            <div class="accordion-header bg-danger-subtle d-flex py-0" id="header_z">
                                <div class="col-sm-12 col-12">
                                    <button class=" collapsed  bg-danger-subtle w-100 border-0 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_z" aria-expanded="true" aria-controls="collapse_z">
                                        <span class="text-center fw-bolder fs-6">البيانات الشخصية للطالب</span><i class="mt-1 me-2 bi bi-box-arrow-in-down"></i>
                                    </button>

                                </div>
                            </div>
                        </div>

                        <div id="collapse_z" class="accordion-collapse collapse" aria-labelledby="header_z" data-bs-parent="#accordionExample0">
                            <div class="accordion-body">
                                <div class="form-group mb-2 ">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <span class="input-group-text bg-info-subtle ps-2">@ResourceApp_Ar.StudentsModel_StudentName_lbl</span>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <input type="text" class="form-control text-center" asp-for="@Model.EpisodeVM.SelectStudent.Name" id="stName" style="border-left:solid 3px red" placeholder="@ResourceApp_Ar.StudentsModel_StudentName_txt" />
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.Name" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" for="stCategory">@ResourceApp_Ar.StudentsModel_StudentCategory_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <select class="form-select text-center" id="stCategory" asp-for="@Model.EpisodeVM.SelectStudent.Category" onchange="SelectCategory()" style="border-left:solid 3px red">
                                                <option selected disabled value="">@ResourceApp_Ar.StudentsModel_StudentCategory_select</option>
                                                <option value="resident">مقيم - مواطن </option>
                                                <option value="visitor">زائر </option>
                                            </select>
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.Category" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <span class="input-group-text ps-2 bg-info-subtle">@ResourceApp_Ar.StudentsModel_StudentIdentityNum_lbl</span>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <input type="text" readonly class="form-control text-center" asp-for="@Model.EpisodeVM.SelectStudent.IdentityNumber" id="stIdentitynum" placeholder="@ResourceApp_Ar.StudentsModel_StudentIdentityNum_txt" style="border-left:solid 3px red" />
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.IdentityNumber" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <span class="input-group-text ps-2 bg-info-subtle">@ResourceApp_Ar.StudentsModel_ParentIdentityNum_lbl</span>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <input type="text" class="form-control text-center" readonly asp-for="@Model.EpisodeVM.SelectStudent.ParentIdentityNumber" style="border-left:solid 3px red" id="stParentIdentitynum" placeholder="@ResourceApp_Ar.StudentsModel_ParentIdentityNum_txt" />
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.ParentIdentityNumber" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <span class="input-group-text ps-2 bg-info-subtle">@ResourceApp_Ar.StudentsModel_ParentPhoneNum_lbl</span>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <input type="text" class="form-control text-center" asp-for="@Model.EpisodeVM.SelectStudent.ParentPhoneNumber" style="border-left:solid 3px red" id="stParentPhonenum" placeholder="@ResourceApp_Ar.StudentsModel_ParentPhoneNum_txt" />
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.ParentPhoneNumber" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" for="stNationalityId">@ResourceApp_Ar.StudentsModel_StudentNationality_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <select class="form-select text-center" asp-items="@Model.EpisodeVM.StudentsVM.AvilableNationalities" id="stNationalityId" asp-for="@Model.EpisodeVM.SelectStudent.NationalityId" onchange="" style="border-left:solid 3px red">
                                                <option selected disabled value="">@ResourceApp_Ar.StudentsModel_StudentNationality_select</option>
                                            </select>
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.NationalityId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" for="stHealthId">@ResourceApp_Ar.StudentsModel_StudentHealth_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <select class="form-select text-center" asp-items="@Model.EpisodeVM.StudentsVM.AvilableHealthConditions" id="stHealthId" asp-for="@Model.EpisodeVM.SelectStudent.HealthConditionId" onchange="" style="border-left:solid 3px red">
                                            </select>
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.HealthConditionId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" for="stGender">@ResourceApp_Ar.StudentsModel_StudentGender_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <select class="form-select text-center" id="stGender" asp-for="@Model.EpisodeVM.SelectStudent.Gender" onchange="" style="border-left:solid 3px red">
                                                @*  <option selected disabled value="">@ResourceApp_Ar.StudentsModel_StudentGender_select</option> *@
                                                <option value="male">ذكر </option>
                                                <option value="female">انثي </option>
                                            </select>
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.Gender" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-2 ">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <span class="input-group-text ps-2 bg-info-subtle">@ResourceApp_Ar.StudentsModel_StudentBirthDate_lbl</span>
                                        </div>
                                        <div class="col-sm-8 col-8 d-flex">
                                            <input type="text" id="stBD" readonly class="form-control text-center" style="width:100px" asp-for="@Model.EpisodeVM.SelectStudent.BirthDate" />
                                            <label class="cal" for="txtHijriDate">
                                                <span class="fs-3 d-flex">
                                                    <i class="bi bi-calendar mx-2"></i>
                                                    <input type="button" id="txtHijriDate" name="selectedDate" class="form-control text-center" style="width:100px" onclick="document.getElementById('stBD').style.visibility='hidden';" />
                                                </span>
                                            </label>

                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.BirthDate" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="accordion shadow mb-3 py-0" id="accordionExample">
                        <div class="accordion-item  bg-danger-subtle py-0">
                            <div class="accordion-header bg-danger-subtle d-flex py-0" id="header_one">
                                <div class="col-sm-12 col-12">
                                    <button class=" collapsed  bg-danger-subtle w-100 border-0 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_one" aria-expanded="false" aria-controls="collapse_one">
                                        <span class="text-center fw-bolder fs-6"> البيانات التعليمية</span><i class="mt-1 me-2 bi bi-box-arrow-in-down"></i>
                                    </button>

                                </div>
                            </div>
                        </div>

                        <div id="collapse_one" class="accordion-collapse collapse" aria-labelledby="header_one" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" for="stEducationType">@ResourceApp_Ar.StudentsModel_EducationType_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <select class="form-select text-center" id="stEducationType" asp-for="@Model.EpisodeVM.SelectStudent.EducationType" onchange="" style="border-left:solid 3px red">
                                                <option selected disabled value="">@ResourceApp_Ar.StudentsModel_EducationType_select</option>
                                                <option value="تحفيظ">تحفيظ </option>
                                                <option value="عام">عام </option>
                                            </select>
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.EducationType" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                
                                    <div class="form-group">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" for="stEpisodeId">@ResourceApp_Ar.StudentsModel_StEpisode_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <select class="form-select text-center" id="stEpisodeId" asp-for="@Model.EpisodeVM.SelectStudent.StEpisodeId" onchange="GetLimitStudent(@EpisodesData.Count())" style="border-left:solid 3px red">
                                                <option selected disabled value="">@ResourceApp_Ar.StudentsModel_StEpisode_select</option>
                                                @foreach (var episode in EpisodesData)
                                                {
                                                    <option value="@episode.Id">@episode.Name</option>
                                                }
                                            </select>
                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.StEpisodeId" class="text-danger"></span>
                                        </div>

                                        @foreach (var episode in EpisodesData)
                                        {
                                            <input id="eplimit_@limi" hidden value="@episode.Id" limit="@episode.LimitStudents" epin="@episode.Students.Count()" />
                                            limi++;
                                        }
                                    </div>
                                    <div class="form-group mt-2 mb-1">
                                        <div class="row">
                                            <div class="col-sm-4 col-2"></div>
                                            <div class="col-sm-4 col-4">
                                                <label class="input-group-text bg-dark-subtle" for="">مقاعد متبقية </label>
                                            </div>
                                            <div class="col-sm-4 col-6 d-flex">
                                                <input type="text" class="input-group-text ms-1" style="width:50px" readonly id="selectin" />
                                                <small class="form-text text-muted"> من </small>
                                                <input type="text" class="input-group-text me-1" style="width:50px" readonly id="selectlimit" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group mt-1 mb-0">
                                        <div class="row">
                                            <div class="col-sm-4 col-4"></div>
                                            <div class="col-sm-8 col-8">
                                                <input class="text-danger  bg-transparent text-center fw-bolder border-0" id="stateLimit" disabled value="" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                               
                                

                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" for="stPlanId">@ResourceApp_Ar.StudentsModel_StPlan_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <select class="form-select text-center" id="stPlanId" value="" onchange="SelectPlan()" style="border-left:solid 3px red" asp-for="@Model.EpisodeVM.SelectStudent.PlanDataId">
                                                <option selected disabled value="">@ResourceApp_Ar.StudentsModel_StPlan_select</option>
                                                @foreach (var plan in Model.EpisodeVM.StudentsVM.PlansData)
                                                {
                                                    <option value="@plan.Id">@plan.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <input type="text" id="sdir" class="form-control text-center" value="" asp-for="@Model.EpisodeVM.SelectStudent.SaveDirection" hidden />
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle" id="lblLevel" for="stLevelId" style="visibility:hidden;">>@ResourceApp_Ar.StudentsModel_StLevel_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8 d-flex">
                                            <select class="form-select text-center px-2" id="saveDir" onchange="GetSurah_Verse()" style="border-left:solid 3px red;visibility:hidden">
                                                <option selected disabled id="selectedLbl" value="">@ResourceApp_Ar.StudentsModel_Dir_select</option>
                                                <option id="saveDire_ctp" value="ctp">من البقرة للناس</option>
                                                <option id="saveDire_ptc" value="ptc">من الناس للبقرة</option>
                                            </select>
                                            <select class="form-select text-center px-2" id="stLevelId" onchange="" asp-for="@Model.EpisodeVM.SelectStudent.LessonDataId" style="border-left:solid 3px red;visibility:hidden">
                                                <option selected disabled id="selectedLbl" value="">@ResourceApp_Ar.StudentsModel_StLesson_select</option>
                                                @foreach (var level in Model.EpisodeVM.StudentsVM.LevelsData.Levels)
                                                {
                                                    <optgroup id="selectedLevel" value="@level.Id" label="@level.Name">
                                                        @foreach (var lesson in level.LessonsData)
                                                        {
                                                            <option id="lesson_@l" value="@lesson.Id">@lesson.Save_FromSorh | @lesson.Save_FromAyah</option>
                                                            l++;
                                                        }
                                                    </optgroup>
                                                }
                                            </select>

                                            <span asp-validation-for="@Model.EpisodeVM.SelectStudent.LessonDataId" class="text-danger"></span>
                                        </div>

                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-4">
                                            <label class="input-group-text bg-info-subtle " id="lblLesson" style="visibility:hidden" for="stLessonId">@ResourceApp_Ar.StudentsModel_StSorah_lbl</label>
                                        </div>
                                        <div class="col-sm-8 col-8">
                                            <div class="d-flex">
