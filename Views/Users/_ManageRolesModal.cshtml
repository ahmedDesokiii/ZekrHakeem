@model MasterViewModel

<div class="modal fade shadow" id="manageRolesModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered scrolled">
        <div class="modal-content" style="border-radius:14px;">

            <!-- Header -->
            <div class="modal-header text-white rounded-top-3"
                 style="border-radius:14px;background: linear-gradient(135deg,#0d6efd,#0AC4E0);">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-collection-fill ms-2"></i>
                    إدارة مجموعات المستخدم
                </h5>

                <a href="#" class="btn-close btn-close-white position-absolute start-0 mx-3"
                   data-bs-dismiss="modal" aria-label="Close"></a>
            </div>
                <form id="manageRolesForm" method="post" asp-controller="Users" asp-action="ManageRoles" novalidate>

                    <!-- Body -->
                <div class="modal-body bg-white align-items-center justify-content-center mt-3 rounded-4" dir="rtl">
                            @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="UserRolesVM.UserId" />

                                <div class="alert alert-light border mb-3 rounded-3">

                                    <div class="fw-bold text-primary fs-5">
                                        <i class="bi bi-person-circle me-1"></i>
                                        @Model.UserRolesVM.FullName
                                    </div>

                                    <div class="text-muted small">
                                        UserName: @Model.UserRolesVM.UserName
                                    </div>

                                </div>

                                <!-- Roles -->
                                <div class="card border-0 shadow px-0">
                                    <div class="card-header rounded-3 fw-bold fs-5"
                                         style="background-image: linear-gradient(to bottom right, #FBF8EF, #B1F0F7);">
                                            <i class="bi bi-collection fs-4 ms-2"></i>
                                        المجموعات
                                    </div>
                                    <div class="card-body pb-0">
                                       @for (int i = 0; i < Model.UserRolesVM.Roles.Count; i++)
                                        {
                                            <div class="form-check form-switch mb-2">
                                                <input type="hidden" name="UserRolesVM.Roles[@i].RoleId" value="@Model.UserRolesVM.Roles[i].RoleId" />
                                                <input type="hidden" name="UserRolesVM.Roles[@i].DisplayValue" value="@Model.UserRolesVM.Roles[i].DisplayValue" />

                                                <!-- Checkbox يرسل true عند التحديد -->
                                                <input type="checkbox" name="UserRolesVM.Roles[@i].IsSelected" value="true"
                                                        class="form-check-input" @(Model.UserRolesVM.Roles[i].IsSelected ? "checked" : "") />

                                                <!-- Hidden لضمان إرسال false إذا لم يتم التحديد -->
                                                <input type="hidden" name="UserRolesVM.Roles[@i].IsSelected" value="false" />

                                                <label class="form-check-label fw-semibold">
                                                    @Model.UserRolesVM.Roles[i].DisplayValue
                                                </label>
                                            </div>
                                        }

                                        <span asp-validation-for="UserRolesVM.Roles" class="text-danger small"></span>
                                    </div>
                                </div>

                            </div>

               
                <!-- Footer -->
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between flex-wrap gap-2 p-3 p-md-4">

                    <button type="submit"
                            class="btn btn-success px-4 shadow-sm" id="saveRolesBtn">

                        <i class="bi bi-check-lg ms-1"></i>
                        حفظ البيانات
                        <span class="btn-loading d-none"><span class="spinner-border spinner-border-sm"></span> جاري الحفظ...</span>
                    </button>


                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4 shadow-sm">

                        <i class="bi bi-x-lg ms-1"></i>
                        الغـاء

                    </a>

                </div>

                </form>
            </div>
        </div>
    </div>

<style>
    #manageRolesModal .modal-dialog {
        transform: scale(0.7);
        opacity: 0;
        transition: all 0.25s ease;
    }

    #manageRolesModal.show .modal-dialog {
        transform: scale(1);
        opacity: 1;
    }

    .updated-row {
        animation: highlightFade 2s ease;
    }
    
</style>

<script>
       $("#manageRolesForm").submit(function (e) {
        e.preventDefault();
        var btn = $("#saveRolesBtn");
        btn.prop("disabled", true);
        btn.find(".btn-text").addClass("d-none");
        btn.find(".btn-loading").removeClass("d-none");

        $.ajax({
            url: '/Users/ManageRoles',
            type: 'POST',
            data: $(this).serialize(),
            success: function(res){
                if(res.success){
                    // إغلاق المودال
                    var modalEl = document.getElementById('manageRolesModal');
                    var modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();

                    // رسالة نجاح
                    showToast("success", res.message);

                    // Refresh الجدول بدون إعادة تحميل الصفحة
                    if ($.fn.DataTable.isDataTable('#usersTable')) {
                        var row = $('#usersTable').find('tr[data-userid="'+res.userId+'"]');
                        $('#usersTable').DataTable().ajax.reload(null, false);

                        // Highlight الصف المحدث
                        row.addClass('updated-row');
                        setTimeout(() => row.removeClass('updated-row'), 2000);
                    } else {
                        location.reload();
                    }
                }
            },
            error: function(){ showToast("error","حدث خطأ أثناء الحفظ"); },
            complete: function(){
                btn.prop("disabled", false);
                btn.find(".btn-text").removeClass("d-none");
                btn.find(".btn-loading").addClass("d-none");
            }
        });
    });


    function refreshUsersTable() {
        if ($.fn.DataTable.isDataTable('#usersTable')) {
            $('#usersTable').DataTable().ajax.reload(null, false);
        } else {
            location.reload();
        }
    }
</script>

<partial name="_ValidationScriptsPartial" />
