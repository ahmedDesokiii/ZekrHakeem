@model MasterViewModel
@{
    ViewData["Title"] = "Edit User profile";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="EditUser" method="post">
            <h2>Modify User Data.</h2>

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="@Model.ProfileFormVM.Id">
            <div class="form-floating mb-3">
                <input asp-for="@Model.ProfileFormVM.FullName" class="form-control" aria-required="true" placeholder="full name" />
                <label asp-for="@Model.ProfileFormVM.FullName">Full Name</label>
                <span asp-validation-for="@Model.ProfileFormVM.FullName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="@Model.ProfileFormVM.IdentityNum" class="form-control" aria-required="true" placeholder="Identity number" />
                <label asp-for="@Model.ProfileFormVM.IdentityNum">Identity Number</label>
                <span asp-validation-for="@Model.ProfileFormVM.IdentityNum" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="@Model.ProfileFormVM.PhoneNumber" class="form-control" aria-required="true" placeholder="phone number" />
                <label asp-for="@Model.ProfileFormVM.PhoneNumber">Phone Number</label>
                <span asp-validation-for="@Model.ProfileFormVM.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="@Model.ProfileFormVM.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="@Model.ProfileFormVM.Email">Email</label>
                <span asp-validation-for="@Model.ProfileFormVM.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="@Model.ProfileFormVM.UserName" class="form-control" aria-required="true" placeholder="name" />
                <label asp-for="@Model.ProfileFormVM.UserName">User Name</label>
                <span asp-validation-for="@Model.ProfileFormVM.UserName" class="text-danger"></span>
            </div>

           

            <button type="submit" class="w-100 btn btn-lg btn-primary mt-4">Save</button>

        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
