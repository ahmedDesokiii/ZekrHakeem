@model MasterViewModel

<div class="modal fade shadow " id="userModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-xl modal-dialog-centered scrolled">
        <div class="modal-content" style="border-radius:14px;">

            <!-- Header -->
            <div class="modal-header text-white"
                 style="border-radius:14px;background: linear-gradient(135deg,#0d6efd,#0AC4E0);">
                <span class="fs-4 fw-bold">
                    <i class="bi bi-person-circle ms-2"></i>
                    @(Model.AddUserVM.Id == null ? "إضافة مستخدم جديد" : "تعديل بيانات المستخدم")
                </span>
                <a href="#" class="btn-close btn-close-white position-absolute start-0 mx-3"
                   data-bs-dismiss="modal" aria-label="Close"></a>
            </div>

            <div class="modal-body bg-white d-flex align-items-center justify-content-center mt-3 rounded-4" dir="rtl">
                <form asp-controller="Users" id="userForm"
                      asp-action="Save"
                      method="post"
                      novalidate>

                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AddUserVM.Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger small"></div>
                        <div class="row mx-auto">
                            <!-- ===== User Info ===== -->
                            <div class="card border-0 col-md-6 col-lg-6 col-12 shadow px-0 mb-2">
                            <div class="card-header rounded-3 fw-bold fs-5" style="background-image: linear-gradient(to bottom right, #FBF8EF, #B1F0F7);">
                                    <i class="bi bi-person-lines-fill fs-4 ms-2"></i>
                                    بيانات المستخدم
                                </div>

                            <div class="card-body pb-4" style="border-radius:14px;">
                                    <div class="row g-3">
                                        <!-- FullName-->
                                        <div class="input-group">
                                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;الاسم الكامل&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                                            <input id="FullName" asp-for="AddUserVM.FullName" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="ادخل الاسم الكامل للمستخدم" type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-left-radius : 20px ;">
                                        </div>
                                        <span asp-validation-for="AddUserVM.FullName" class="text-danger my-0"></span>

                                        <!-- PhoneNumber-->
                                        <div class="input-group mt-1">
                                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;رقم التليفون&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                                            <input id="PhoneNumber" asp-for="AddUserVM.PhoneNumber" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="ادخل رقم تليفون المستخدم" type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-left-radius : 20px ;">
                                        </div>
                                        <span asp-validation-for="AddUserVM.PhoneNumber" class="text-danger my-0"></span>
                                        <!-- Gender -->
                                        <div class="input-group mt-1">
                                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3">
                                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;النوع&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                            </span>

                                            <select asp-for="AddUserVM.Gender"
                                                    class="form-select text-center"
                                                    style="border-top-left-radius:20px;">
                                                <option value="">-- اختر النوع --</option>
                                                <option value="Male">ذكر</option>
                                                <option value="Female">أنثى</option>
                                            </select>
                                        </div>
                                        <span asp-validation-for="AddUserVM.Gender" class="text-danger my-0"></span>
                                        <!-- IdentityNum-->
                                        <div class="input-group mt-1">
                                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;الرقم القومي&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                                            <input id="IdentityNum" asp-for="AddUserVM.IdentityNum" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="ادخل الرقم القومي للمستخدم" type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-left-radius : 20px ;">
                                        </div>
                                        <span asp-validation-for="AddUserVM.IdentityNum" class="text-danger my-0"></span>

                                        <!-- Email-->
                                        <div class="input-group mt-1">
                                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;البريد الالكتروني&nbsp;&nbsp;&nbsp;</span>
                                            <input id="Email" asp-for="AddUserVM.Email" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="example@domail.com" type="email" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-left-radius : 20px ;">
                                        </div>
                                        <span asp-validation-for="AddUserVM.Email" class="text-danger my-0"></span>
                                        <!-- UserName -->
                                        <div class="input-group mt-1">
                                            <span class="input-group-text bg-info-subtle fw-bold rounded-end-3">
                                                &nbsp;&nbsp;&nbsp;اسم المستخدم&nbsp;&nbsp;&nbsp;
                                            </span>
                                            <input asp-for="AddUserVM.UserName"
                                               id="UserName"
                                                   class="form-control text-center"
                                                   placeholder="ادخل اسم المستخدم"
                                                   style="border-top-left-radius:20px;" />
                                        </div>
                                        <span asp-validation-for="AddUserVM.UserName"class="text-danger my-0"></span>
                                        @* Password يظهر في الإضافة فقط *@
                                        @if (Model.AddUserVM.Id == null)
                                        {
                                            <!-- Password-->
                                            <div class="input-group mt-1">
                                                <span class="input-group-text bg-info-subtle fw-bold rounded-end-3" id="inputGroup-sizing-default ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;كلمة المرور&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
                                                <input id="Password" asp-for="AddUserVM.Password" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="ادخل رقم كلمة المرور" type="password" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-left-radius : 20px ;">
                                            </div>
                                            <span asp-validation-for="AddUserVM.Password" class="text-danger my-0"></span>
                                            <!-- Password-->
                                            <div class="input-group mt-1">
                                                <span class="input-group-text bg-info-subtle fw-bold rounded-end-3" id="inputGroup-sizing-default ">&nbsp;اعادة كلمة المرور &nbsp;</span>
                                                    <input id="ConfirmPassword" asp-for="AddUserVM.ConfirmPassword" class="form-control text-center" autocomplete="on" aria-required="true" placeholder="ادخل رقم كلمة المرور" type="password" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-left-radius : 20px ;">
                                            </div>
                                            <span asp-validation-for="AddUserVM.ConfirmPassword" class="text-danger my-0"></span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-1 col-lg-1"></div>
                            <!-- ===== Roles ===== -->
                            <div class="card border-0 col-md-4 col-lg-4 col-12 shadow px-0">
                            <div class="card-header rounded-3 fw-bold fs-5" style="background-image: linear-gradient(to bottom right, #FBF8EF, #B1F0F7);">
                                <i class="bi bi-collection-fill fs-4 ms-2"></i>
                                    المجموعات
                                </div>

                                <div class="card-body pb-0">
                                    @for (int i = 0; i < Model.AddUserVM.Roles.Count; i++)
                                    {
                                        <div class=" ">
                                            <div class="form-check form-switch mb-2">
                                                <input type="hidden" asp-for="AddUserVM.Roles[i].RoleId" />
                                                <input type="hidden" asp-for="AddUserVM.Roles[i].DisplayValue" />

                                                <input asp-for="AddUserVM.Roles[i].IsSelected"
                                                       class="form-check-input" />

                                                <label class="form-check-label fw-semibold">
                                                    @Model.AddUserVM.Roles[i].DisplayValue
                                                </label>
                                            </div>
                                        </div>
                                    }
                                    <span asp-validation-for="AddUserVM.Roles"
                                          class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    
                       
                    <!-- Footer -->
                    <div class="card-footer bg-white border-0 d-flex justify-content-between flex-wrap gap-2 p-3 p-md-4">

                        <button type="submit"
                                class="btn btn-success px-4 shadow-sm" id="saveRolesBtn">

                            <i class="bi bi-check-lg ms-1"></i>
                            حفظ البيانات
                            <span class="btn-loading d-none"><span class="spinner-border spinner-border-sm"></span> جاري الحفظ...</span>
                        </button>


                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4 shadow-sm">

                            <i class="bi bi-x-lg ms-1"></i>
                            الغـاء

                        </a>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



<partial name="_ValidationScriptsPartial" />
