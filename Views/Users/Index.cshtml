@model MasterViewModel

@{
    ViewData["Title"] = "Users";
    int cNo = 0;
}

<div class="wrapper">
    <!--Content-Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">Users</h1>
                </div>
            </div>
        </div>
    </div>
    <!--End Content-Header-->
    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-start">
                        <div class="card-tools ">
                            <!-- Button trigger modal -->

                           @*  <button type="button" style="margin-left:20px" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                                Add User
                            </button> *@
                            <a class="btn btn-outline-primary" asp-action="AddUser" asp-controller="Users">Add User</a>
                        </div>
                    </div>
                    <!-- /.card-header -->

                    <div class="card-body">
                        <!-- Tab links -->
                        <div class="tab">
                            <button class="tablinks" onclick="openCity(event, 'Users')" id="defaultOpen">Users</button>
                        </div>
                        <!-- Tab content -->
                        @if (!Model.UserVM.Any())
                        {
                            <div class="alert  alert-warning mt-5">
                                <h4 class="alert-heading">No Users!</h4>
                                <p class="mb-0">No users where added yet.</p>
                            </div>
                        }
                        else
                        {
                            <div id="Users" class="tabcontent">
                                <table class="table table-hover mt-4" id="tableUser">
                                    <thead>
                                        <tr class="bg-primary text-white ">
                                            <th></th>
                                            <th>Full Name</th>
                                            @*  <th>Identity Number</th>
                                            <th>Phone Number</th>
                                            <th>User Name</th>
                                            <th>Email</th> *@
                                            <th>Roles</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.UserVM)
                                        {
                                            cNo++;
                                            <tr>
                                                <td style="text-align:center">@cNo</td>
                                                <td>@user.FullName</td>
                                                @*  <td>@user.IdentityNum</td>
                                                <td>@user.PhoneNumber</td>
                                                <td>@user.UserName</td>
                                                <td>@user.Email</td> *@
                                                <td>@string.Join(" , ", user.Roles.ToList())</td>
                                                <td>
                                                    <a class="btn btn-warning" asp-controller="Users" asp-action="ManageRoles" asp-route-userId="@user.Id">Roles</a>
                                                    <a class="btn btn-info" asp-controller="Users" asp-action="EditUser" asp-route-userId="@user.Id">Edit</a>
                                                    <a href="javascript:del();" class="btn btn-danger js-delete" data-id="@user.Id">Delete</a>

                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
    <!-- /.content -->
</div>



@section Scripts {
    <script>
        $(document).ready(function del () {
            $('.js-delete')on('click', function del () {
                var btn = $(this);
                bootbox.confirm({
                    message: "Are you sure that you need to delete this user ?",
                    buttons: {
                        confirm: {
                            label: 'Yes',
                            className: 'btn-success'
                        },
                        cancel: {
                            label: 'No',
                            className: 'btn-danger'
                        }
                    },
                    callback: function (result) {
                        console.log('This was logged in the callback: ' + result);
                    }
                });
                // var result = confirm("Are you sure that you need to delete this user ?")
                // if (result) { 
                //     console.log(btn.data('id'));
                // }
            });
        });
    </script>

