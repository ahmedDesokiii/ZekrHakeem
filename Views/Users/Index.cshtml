@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<section class="zh-page">
    <div class="zh-container">

        <!-- Hero -->
        <div class="zh-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="zh-crumb"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left"></i><span>الإدارة</span></div>
                <h1><i class="bi bi-people-fill ms-2"></i>إدارة المستخدمين</h1>
                <p>أضف المستخدمين، وزّعهم على المجموعات، وتحكم في صلاحياتهم لحظيًا.</p>
                <span class="zh-live-pill mt-3 off" id="liveState"><span class="zh-pulse-dot"></span><span>جارٍ الاتصال…</span></span>
            </div>
            <div class="zh-hero-actions">
                <a class="zh-btn zh-btn-glass" asp-controller="Roles" asp-action="Index" data-cap="Roles.View" hidden><i class="bi bi-shield-lock"></i> المجموعات</a>
                <button class="zh-btn zh-btn-glass" id="btnExport" type="button"><i class="bi bi-file-earmark-excel"></i> تصدير</button>
                <button class="zh-btn zh-btn-gold" id="btnAddUser" type="button" data-cap="Users.Create" hidden><i class="bi bi-person-plus-fill"></i> مستخدم جديد</button>
            </div>
        </div>

        <!-- Stats -->
        <div class="zh-stats" id="stats">
            <div class="zh-card zh-stat" data-status="" style="--c:#0F5E4F"><div class="zh-stat-icon"><i class="bi bi-people-fill"></i></div><div class="zh-stat-value" data-k="total">0</div><div class="zh-stat-label">كل المستخدمين</div></div>
            <div class="zh-card zh-stat" data-status="online" style="--c:#15B392"><div class="zh-stat-icon"><i class="bi bi-broadcast"></i></div><div class="zh-stat-value" data-k="online">0</div><div class="zh-stat-label"><span class="zh-pulse-dot ms-1"></span> متصل الآن</div></div>
            <div class="zh-card zh-stat" data-status="active" style="--c:#1D7AA8"><div class="zh-stat-icon"><i class="bi bi-person-check-fill"></i></div><div class="zh-stat-value" data-k="active">0</div><div class="zh-stat-label">حسابات مفعلة</div></div>
            <div class="zh-card zh-stat" data-status="inactive" style="--c:#D64545"><div class="zh-stat-icon"><i class="bi bi-person-slash"></i></div><div class="zh-stat-value" data-k="inactive">0</div><div class="zh-stat-label">حسابات موقوفة</div></div>
            <div class="zh-card zh-stat" data-status="unconfirmed" style="--c:#E5A023"><div class="zh-stat-icon"><i class="bi bi-envelope-exclamation-fill"></i></div><div class="zh-stat-value" data-k="unconfirmed">0</div><div class="zh-stat-label">بريد غير مؤكد</div></div>
            <div class="zh-card zh-stat" data-status="" data-sort="created" style="--c:#C9A227"><div class="zh-stat-icon"><i class="bi bi-stars"></i></div><div class="zh-stat-value" data-k="newThisMonth">0</div><div class="zh-stat-label">جدد هذا الشهر</div></div>
        </div>

        <!-- Role distribution -->
        <div class="zh-chips mb-3" id="roleFilters"></div>

        <!-- Toolbar -->
        <div class="zh-card zh-toolbar">
            <div class="zh-search">
                <i class="bi bi-search"></i>
                <input class="zh-input" id="q" type="search" autocomplete="off" placeholder="ابحث بالاسم، اسم المستخدم، البريد، الجوال أو الهوية…" />
                <kbd class="zh-hide-mobile">/</kbd>
            </div>
            <select class="zh-select" id="fRole" style="max-width:210px"><option value="">كل المجموعات</option></select>
            <select class="zh-select zh-hide-mobile" id="fGender" style="max-width:140px">
                <option value="">الكل</option><option value="male">ذكور</option><option value="female">إناث</option>
            </select>
            <select class="zh-select" id="fSort" style="max-width:190px">
                <option value="name">ترتيب: الاسم</option>
                <option value="username">ترتيب: اسم المستخدم</option>
                <option value="created|desc">الأحدث إضافة</option>
                <option value="lastLogin|desc">آخر دخول</option>
            </select>
            <div class="zh-segment zh-hide-mobile" id="viewToggle">
                <button type="button" data-view="cards" class="active" title="بطاقات"><i class="bi bi-grid-3x2-gap-fill"></i></button>
                <button type="button" data-view="table" title="جدول"><i class="bi bi-list-ul"></i></button>
            </div>
        </div>

        <!-- Results -->
        <div id="results"></div>

        <div class="zh-pager">
            <div class="zh-muted fw-bold" id="pageInfo"></div>
            <div class="d-flex align-items-center gap-2">
                <select class="zh-select" id="pageSize" style="width:auto">
                    <option value="12">12</option><option value="24">24</option><option value="48">48</option><option value="96">96</option>
                </select>
                <div class="pages" id="pages"></div>
            </div>
        </div>
    </div>
</section>

<!-- ======================= Drawers ======================= -->
<div class="zh-drawer-backdrop" id="drawerBackdrop"></div>

<!-- User details -->
<aside class="zh-drawer wide" id="userDrawer" aria-hidden="true">
    <div class="zh-drawer-head">
        <h3>ملف المستخدم</h3>
        <button class="zh-btn zh-btn-ghost zh-btn-icon" data-close><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="zh-drawer-body zh-scroll" id="userDrawerBody"></div>
    <div class="zh-drawer-foot" id="userDrawerFoot"></div>
</aside>

<!-- Add / Edit user -->
<aside class="zh-drawer" id="formDrawer" aria-hidden="true">
    <div class="zh-drawer-head">
        <h3 id="formTitle">مستخدم جديد</h3>
        <button class="zh-btn zh-btn-ghost zh-btn-icon" data-close><i class="bi bi-x-lg"></i></button>
    </div>
    <form class="zh-drawer-body zh-scroll" id="userForm" autocomplete="off" novalidate>
        <input type="hidden" name="id" />
        <div id="formErrors"></div>

        <h6 class="fw-bold zh-muted mb-3"><i class="bi bi-person-vcard ms-1"></i> البيانات الأساسية</h6>
        <div class="zh-field">
            <label class="zh-label">الاسم الكامل <span class="req">*</span></label>
            <input class="zh-input" name="fullName" required minlength="3" maxlength="200" />
        </div>
        <div class="row g-3">
            <div class="col-sm-6 zh-field mb-0">
                <label class="zh-label">اسم المستخدم <span class="req">*</span></label>
                <input class="zh-input zh-ltr" name="userName" required minlength="3" />
                <div class="zh-hint">حروف إنجليزية وأرقام بدون مسافات</div>
            </div>
            <div class="col-sm-6 zh-field mb-0">
                <label class="zh-label">رقم الهوية <span class="req">*</span></label>
                <input class="zh-input zh-ltr" name="identityNum" required maxlength="30" />
            </div>
            <div class="col-sm-6 zh-field mb-0">
                <label class="zh-label">البريد الإلكتروني <span class="req">*</span></label>
                <input class="zh-input zh-ltr" name="email" type="email" required />
            </div>
            <div class="col-sm-6 zh-field mb-0">
                <label class="zh-label">الجوال</label>
                <input class="zh-input zh-ltr" name="phoneNumber" type="tel" />
            </div>
            <div class="col-sm-6 zh-field mb-0">
                <label class="zh-label">النوع</label>
                <div class="zh-segment w-100" id="genderSeg">
                    <button type="button" class="flex-fill" data-g="male"><i class="bi bi-gender-male"></i> ذكر</button>
                    <button type="button" class="flex-fill" data-g="female"><i class="bi bi-gender-female"></i> أنثى</button>
                </div>
                <input type="hidden" name="gender" />
            </div>
            <div class="col-sm-6 zh-field mb-0">
                <label class="zh-label">الجنسية</label>
                <input class="zh-input" name="nationality" />
            </div>
        </div>

        <h6 class="fw-bold zh-muted mt-4 mb-3"><i class="bi bi-key ms-1"></i> الدخول والأمان</h6>
        <div class="zh-field">
            <label class="zh-label" id="pwLabel">كلمة المرور <span class="req">*</span></label>
            <div class="d-flex gap-2">
                <div class="zh-input-group flex-grow-1">
                    <input class="zh-input zh-ltr" name="password" type="password" autocomplete="new-password" />
                    <button type="button" class="zh-input-action" data-toggle-pw title="إظهار"><i class="bi bi-eye"></i></button>
                </div>
                <button type="button" class="zh-btn zh-btn-light" id="btnGenPw" title="توليد كلمة مرور قوية"><i class="bi bi-magic"></i></button>
            </div>
            <div class="zh-strength" id="pwStrength"><span></span><span></span><span></span><span></span></div>
            <div class="zh-hint" id="pwHint">6 خانات على الأقل: حرف كبير وصغير ورقم ورمز</div>
        </div>
        <label class="zh-switch mb-3">
            <input type="checkbox" name="isActive" checked />
            <span class="track"></span>
            <span>الحساب مفعل ويمكنه تسجيل الدخول</span>
        </label>

        <div id="formRolesBlock">
            <h6 class="fw-bold zh-muted mt-3 mb-3"><i class="bi bi-shield-check ms-1"></i> المجموعات</h6>
            <div class="zh-role-pick" id="formRoles"></div>
        </div>

        <h6 class="fw-bold zh-muted mt-4 mb-3"><i class="bi bi-card-text ms-1"></i> معلومات إضافية</h6>
        <div class="zh-field">
            <label class="zh-label">العنوان</label>
            <input class="zh-input" name="adress" />
        </div>
        <div class="zh-field">
            <label class="zh-label">ملاحظات</label>
            <textarea class="zh-textarea" name="notes" rows="2"></textarea>
        </div>
    </form>
    <div class="zh-drawer-foot">
        <button class="zh-btn zh-btn-light" data-close type="button">إلغاء</button>
        <button class="zh-btn zh-btn-primary" id="btnSaveUser" type="button"><i class="bi bi-check2-circle"></i> حفظ</button>
    </div>
</aside>

<div class="zh-savebar" id="permSavebar">
    <span><i class="bi bi-pencil-square ms-1"></i> لديك <b id="permChangedCount">0</b> تعديلات غير محفوظة</span>
    <button class="zh-btn zh-btn-light zh-btn-sm" id="permDiscard" type="button">تراجع</button>
    <button class="zh-btn zh-btn-gold zh-btn-sm" id="permSave" type="button"><i class="bi bi-check2"></i> حفظ</button>
</div>

@section Scripts {
    <script>
        window.ZH_USERS = {
            openUser: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["OpenUser"] as string)),
            openTab: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["OpenTab"] as string)),
            exportUrl: '@Url.Action("Export", "Users")',
            meId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.FindFirstValue(ClaimTypes.NameIdentifier)))
        };
    </script>
    <script src="~/js/zh-admin-common.js" asp-append-version="true"></script>
    <script src="~/js/zh-users-admin.js" asp-append-version="true"></script>
}
