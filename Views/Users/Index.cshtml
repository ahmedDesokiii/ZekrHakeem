@section Scripts {
    <script src="~/js/Users.js"></script>
    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        if (Context.Session.GetString(Helper.MsgType) == Helper.Success)
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'success'
                });
            </script>

        }
        else
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'error'
                });
            </script>
        }
        Context.Session.SetString(Helper.MsgType, "");
    }
}
*@


@model MasterViewModel
@{
    ViewData["Title"] = "المستخدمين";
}

<section class="container-fluid users-page ">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <div class="card users-card shadow-sm mt-4">

                <!-- Header -->
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2" style="background-image: linear-gradient(to bottom right, #FBF8EF, #B1F0F7);">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-people-fill me-1"></i> المستخدمين
                    </h4>

                    <a asp-action="AddUser" asp-controller="Users"
                       class="btn btn-success d-flex align-items-center gap-1 rounded-3" >
                        <i class="bi bi-plus-circle"></i>
                        إضافة مستخدم
                    </a>
                </div>

                <!-- Body -->
                <div class="card-body px-3 px-md-4 px-xl-5">

                    @if (!Model.UserVM.Any())
                    {
                        <div class="alert alert-warning m-3 text-center">
                            <h5>لا يوجد مستخدمين</h5>
                            <p class="mb-0">لم يتم إضافة مستخدمين حتى الآن</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive text-center">
                            <table id="tableUser"
                                   class="table table-hover align-middle users-table nowrap">
                                <thead>
                                    <tr>
                                        <th>الاسم</th>
                                        <th>اسم المستخدم</th>
                                        <th class="d-none d-md-table-cell">التليفون</th>
                                        <th class="d-none d-lg-table-cell">المجموعات</th>
                                        <th class="text-center">إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.UserVM)
                                    {
                                        <tr>
                                            <td data-label="الاسم">@user.FullName</td>
                                            <td data-label="اسم المستخدم">@user.UserName</td>
                                            <td data-label="التليفون" class="d-none d-md-table-cell">@user.PhoneNumber</td>
                                            <td data-label="المجموعات" class="d-none d-lg-table-cell">
                                                @string.Join(" , ", user.Roles)
                                            </td>
                                            <td class="text-center actions">
                                                <a class="btn fw-bold btn-outline-dark bg-transparent border-0 text-center p-0 mx-1 fs-5" title="مجموعات" asp-controller="Users" asp-action="ManageRoles" asp-route-userId="@user.Id"><i class="bi bi-view-stacked"></i></a>
                                                <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="تعديل" asp-controller="Users" asp-action="EditUser" asp-route-userId="@user.Id"><i class="bi bi-pencil-square"></i></a>
                                                <a class="btn fw-bold btn-outline-dark bg-transparent  border-0 p-0 mx-1 fs-5" title="حـذف" asp-controller="Users" asp-action="DeleteUser" asp-route-Id="@user.Id"><i class="bi bi-trash3-fill"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</section>
