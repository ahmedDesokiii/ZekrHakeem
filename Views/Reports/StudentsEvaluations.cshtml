                                <td class="text-center  p-2">
                                    <span class="input-group-text bg-dark text-white fs-6 fw-bold ">بداية من</span>
                                    <input type="date" id="startDate" name="start" class="form-control text-center bg-light fs-6 fw-bold" asp-for="@Model.ReportVM.StartDate">
                                </td>
                                <td class="text-center p-2">
                                    <span class="input-group-text bg-dark text-white fs-6 fw-bold ">نهاية إلي</span>
                                    <input type="date" id="endDate" name="end" class="form-control text-center bg-light fs-6 fw-bold" asp-for="@Model.ReportVM.EndDate">
                                </td>
                            </tr>
                            <tr class="text-center p-2">
                                <td class="text-center p-2" colspan="2">

                                    <div class="text-center text-lg-start  ">
                                        <button id="evsubmit" type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-lg text-white w-100"
                                                style="background-color:#328E6E;">
                                            عرض تقييمات الطلاب
                                        </button>
                                    </div>

                                </td>
                            </tr>

                        </tbody>
                    </table>

                </div>
            </div>
            <div class="col-sm-4 me-3">
