@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager
@model MasterViewModel
@{
    ViewData["Title"] = "Students Last Lessons";
    int cNo = 0;
    var StudentData = Model.ReportVM.AllStudents;
    var NextLessonStudentData = Model.ReportVM.NextLessonData_AllStudent;
    @if (User.IsInRole(Roles.Admin.ToString()))
    {
        StudentData = Model.ReportVM.AllStudents;
        NextLessonStudentData = Model.ReportVM.NextLessonData_AllStudent;
    }
    else if (User.IsInRole(Roles.Supervisor.ToString()))
    {
        StudentData = Model.ReportVM.AllStudentsMen;
        NextLessonStudentData = Model.ReportVM.NextLessonData_AllStudentMen;
    }
    else if (User.IsInRole(Roles.SupervisorWomen.ToString()))
    {
        StudentData = Model.ReportVM.AllStudentsWomen;
        NextLessonStudentData = Model.ReportVM.NextLessonData_AllStudentWomen;
    }
    else if (User.IsInRole(Roles.Teacher.ToString()))
    {
        StudentData = Model.ReportVM.AllStudentsWithTeacher;
        NextLessonStudentData = Model.ReportVM.NextLessonData_AllStudentWithTeacher;
    }
    else if (User.IsInRole(Roles.TeacherWomen.ToString()))
    {
        StudentData = Model.ReportVM.AllStudentsWithTeacher;
        NextLessonStudentData = Model.ReportVM.NextLessonData_AllStudentWithTeacher;

    }
}
<div class="card w-100 border-0">
    <div class="card-header shadow text-center bg-dark rounded-top-3 text-white py-1"> <h3 class="fw-bold">  الدروس المطلوبة من الطلاب </h3></div>

    <div class="row  align-items-center align-content-center">
        <div class="col-sm-6 col-6">
            <div id="demo-output" class="rounded-4"></div>
        </div>

        <div class="col-sm-6 col-6">
            <div id="demo-output2" class="rounded-4"></div>
        </div>
    </div>


    <hr>
    <div class="card-body border-0" dir="rtl">
        @if (!StudentData.Any())
        {
            <div class="alert  alert-warning mt-5">
                <h4 class="alert-heading">No Students!</h4>
                <p class="mb-0">No Students where added yet.</p>
            </div>
        }
        else
        {
            <table id="exampleLessonsTeacher" class="table table-hover table-bordered justify-content-center align-items-center text-center align-content-center border-primary-subtle " >
                <thead>
                    <tr class="text-center p-2">
                        <td class="text-center bg-danger-subtle fw-bold" style="font-size:15px" rowspan="2"></td>
                        <td class="text-center bg-danger-subtle fw-bold" style="font-size:15px" rowspan="2">
                            الطالب
                            <hr class="py-0 my-0">
                            الخطة
                        </td>
                        <td class="text-center bg-danger-subtle fw-bold" style="font-size:15px" colspan="2"> الحفظ</td>
                        <td class="text-center bg-danger-subtle fw-bold" style="font-size:15px" colspan="2"> المراجعة</td>
                        <td class="text-center bg-danger-subtle fw-bold" style="font-size:15px" colspan="2"> الربط</td>
                        <td class="text-center bg-danger-subtle fw-bold" style="font-size:15px" rowspan="2">
                            الحلقة

                        </td>
                    </tr>

                    <tr class="text-center p-1 fw-bold ">
                        <td class="text-center p-1 bg-danger-subtle " style="font-size:13px">
                            من سورة
                            <hr class="py-0 my-0">
                            آية
                        </td>

                        <td class="text-center p-1 bg-danger-subtle " style="font-size:13px">
                            إلي سورة
                            <hr class="py-0 my-0">
                            آية
                        </td>

                        <td class="text-center p-1 bg-danger-subtle " style="font-size:13px">
                            من سورة
                            <hr class="py-0 my-0">
                            آية
                        </td>

                        <td class="text-center p-1 bg-danger-subtle " style="font-size:13px">
                            إلي سورة
                            <hr class="py-0 my-0">
                            آية
                        </td>


                        <td class="text-center p-1 bg-danger-subtle " style="font-size:13px">
                            من سورة
                            <hr class="py-0 my-0">
                            آية
                        </td>

                        <td class="text-center p-1 bg-danger-subtle " style="font-size:13px">
                            إلي سورة
                            <hr class="py-0 my-0">
                            آية
                        </td>

                    </tr>


                </thead>
                <tbody>

                    @foreach (var stu in StudentData)
                    {
                        #region Checked Student Plan
                        string SaveSurahNameFrom = ""; int? SaveAyahNumFrom = 0;
                        string RevSurahNameFrom = ""; int? RevAyahNumFrom = 0;
                        string RabtSurahNameFrom = ""; int? RabtAyahNumFrom = 0;
                        string SaveSurahNameTo = ""; int? SaveAyahNumTo = 0;
                        string RevSurahNameTo = ""; int? RevAyahNumTo = 0;
                        string RabtSurahNameTo = ""; int? RabtAyahNumTo = 0;

                        if (stu.PlanData.Name.Contains("الذكر الحكيم"))
                        {
                            if (stu.Evaluations.OrderByDescending(x => x.Ev_Date).First().Ev_Save >= 5 && stu.Evaluations.OrderByDescending(x => x.Ev_Date).First().Ev_Rev >= 5 && stu.Evaluations.OrderByDescending(x => x.Ev_Date).First().Ev_Rabt >= 5)
                            {
                                SaveSurahNameFrom = NextLessonStudentData.GetValueOrDefault(stu).Save_FromSorh;
                                RevSurahNameFrom = NextLessonStudentData.GetValueOrDefault(stu).Rev_FromSorh;
                                RabtSurahNameFrom = NextLessonStudentData.GetValueOrDefault(stu).Rabt_FromSorh;
                                SaveAyahNumFrom = NextLessonStudentData.GetValueOrDefault(stu).Save_FromAyah;
                                RevAyahNumFrom = NextLessonStudentData.GetValueOrDefault(stu).Rev_FromAyah;
                                RabtAyahNumFrom = NextLessonStudentData.GetValueOrDefault(stu).Rabt_FromAyah;

                                SaveSurahNameTo = NextLessonStudentData.GetValueOrDefault(stu).Save_ToSorh;
                                RevSurahNameTo = NextLessonStudentData.GetValueOrDefault(stu).Rev_ToSorh;
                                RabtSurahNameTo = NextLessonStudentData.GetValueOrDefault(stu).Rabt_ToSorh;
                                SaveAyahNumTo = NextLessonStudentData.GetValueOrDefault(stu).Save_ToAyah;
                                RevAyahNumTo = NextLessonStudentData.GetValueOrDefault(stu).Rev_ToAyah;
                                RabtAyahNumTo = NextLessonStudentData.GetValueOrDefault(stu).Rabt_ToAyah;
                            }
                            else
                            {
                                SaveSurahNameFrom = stu.LessonData.Save_FromSorh;
                                RevSurahNameFrom = stu.LessonData.Rev_FromSorh;
                                RabtSurahNameFrom = stu.LessonData.Rabt_FromSorh;
                                SaveAyahNumFrom = stu.LessonData.Save_FromAyah;
                                RevAyahNumFrom = stu.LessonData.Rev_FromAyah;
                                RabtAyahNumFrom = stu.LessonData.Rabt_FromAyah;

                                SaveSurahNameTo = stu.LessonData.Save_ToSorh;
                                RevSurahNameTo = stu.LessonData.Rev_ToSorh;
                                RabtSurahNameTo = stu.LessonData.Rabt_ToSorh;
                                SaveAyahNumTo = stu.LessonData.Save_ToAyah;
                                RevAyahNumTo = stu.LessonData.Rev_ToAyah;
                                RabtAyahNumTo = stu.LessonData.Rabt_ToAyah;
                            }

                        }
                        else if (stu.PlanData.Name.Contains("الخطة العامة"))
                        {
                            SaveSurahNameFrom = stu.LessonData.Save_FromSorh;
                            RevSurahNameFrom = stu.LessonData.Rev_FromSorh;
                            SaveAyahNumFrom = stu.LessonData.Save_FromAyah;
                            RevAyahNumFrom = stu.LessonData.Rev_FromAyah;

                            SaveSurahNameTo = stu.LessonData.Save_ToSorh;
                            RevSurahNameTo = stu.LessonData.Rev_ToSorh;
                            SaveAyahNumTo = stu.LessonData.Save_ToAyah;
                            RevAyahNumTo = stu.LessonData.Rev_ToAyah;


                            RabtSurahNameFrom = null;
                            RabtAyahNumFrom = null;
                            RabtSurahNameTo = null;
                            RabtAyahNumTo = null;
                        }
                        else if (stu.PlanData.Name.Contains("الخطة المفتوحة"))
                        {
                            SaveSurahNameFrom = stu.LessonData.Save_FromSorh;
                            SaveAyahNumFrom = stu.LessonData.Save_FromAyah;
                            SaveSurahNameTo = stu.LessonData.Save_ToSorh;
                            SaveAyahNumTo = stu.LessonData.Save_ToAyah;

                            RevSurahNameFrom = null;
                            RevAyahNumFrom = null;
                            RevSurahNameTo = null;
                            RevAyahNumTo = null;

                            RabtSurahNameFrom = null;
                            RabtAyahNumFrom = null;
                            RabtSurahNameTo = null;
                            RabtAyahNumTo = null;
                        }
                        #endregion

                        cNo++;
                        <tr class="text-center p-0">

                                    <td class="p-0 text-center">@cNo</td>
                                    <td class="p-0 text-center">
                                        <a target="_blank" class="link-underline-light fw-bold fs-6" asp-controller="Students" asp-action="SelectedStudent" asp-route-Id="@stu.Id">
                                            @stu.Name
                                        </a>
                                        <br class="py-0 my-0 w-75 px-0 mx-auto">
                                            <span style="font-size:13px">@stu.PlanData.Name</span>
                                    </td>

                                    <td class="p-0 text-center" style="font-size:13px">
                                @SaveSurahNameFrom
                                <br class=" my-0 py-0 mx-auto w-75">
                                @SaveAyahNumFrom
                                    </td>
                                    <td class="p-0 text-center" style="font-size:13px">
                                @SaveSurahNameTo
                                <br class=" my-0 py-0 px-0 mx-auto w-75">
                                @SaveAyahNumTo
                                    </td>

                                    <td class="p-0 text-center" style="font-size:13px">
                                @RevSurahNameFrom
                                <br class=" my-0 py-0 mx-auto w-75">
                                @RevAyahNumFrom
                                    </td>
                                    <td class="p-0 text-center" style="font-size:13px">
                                @RevSurahNameTo
                                <br class=" my-0 py-0 px-0 mx-auto w-75">
                                @RevAyahNumTo
                                    </td>

                                    <td class="p-0 text-center" style="font-size:13px">
                                @RabtSurahNameFrom
                                <br class=" my-0 py-0 mx-auto w-75">
                                @RabtAyahNumFrom
                                    </td>
                                    <td class="p-0 text-center" style="font-size:13px">
                                @RabtSurahNameTo
                                <br class=" my-0 py-0 px-0 mx-auto w-75">
                                @RabtAyahNumTo
                                    </td>
                            <td class="p-0 text-center">
                                <span style="font-size:13px">@stu.StEpisode.Name</span>
                            </td>
                            </tr>
                    }

                    </tbody>

                    <tfoot>
                        <tr>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586">اجمالي البيانات</th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>
                            <th class="text-center  fw-bold fs-6" style="background-color:#FFD586"></th>


                        </tr>
                    </tfoot>

                </table>

        }
    </div>
</div>


<script src="~/js/ReportsLessonsStudentsTeacher.js"></script>
