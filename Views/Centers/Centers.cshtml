@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager
@inject RoleManager<IdentityRole> roleManager

@model MasterViewModel

@{
    ViewData["Title"] = "المركز التعليمية";
    var CentersData = Model.CenterVM.Centers;
    var SupervisorsCenterData = Model.CenterVM.SupervisorsMenCenter;
}

@if (User.IsInRole(Roles.Admin.ToString()))
{
    CentersData = Model.CenterVM.Centers;
    SupervisorsCenterData = Model.CenterVM.SupervisorsMenCenter.Concat(Model.CenterVM.SupervisorsWomenCenter);
}
else if (User.IsInRole(Roles.Supervisor.ToString()))
{
    CentersData = Model.CenterVM.CentersForMen;
    SupervisorsCenterData = Model.CenterVM.SupervisorsMenCenter;
}
else if (User.IsInRole(Roles.SupervisorWomen.ToString()))
{
    CentersData = Model.CenterVM.CentersForWomen;
    SupervisorsCenterData = Model.CenterVM.SupervisorsWomenCenter;
}

<section class="container-fluid centers-page">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <div class="card centers-card shadow-sm my-4">

                <!-- Header -->
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2" 
                    style="background-image: linear-gradient(to bottom right, #FBF8EF, #B1F0F7);">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-building ms-2"></i>  المراكز التعليمية
                    </h4>

                    @if (AuthorizationService.AuthorizeAsync(User, Permissions.Centers.Create).Result.Succeeded)
                    {
                        <button class="btn btn-success" onclick="openCenterModal('@Url.Action("Save", "Centers")'); Rest();">
                            <i class="bi bi-plus-circle ms-2"></i> إضافة مركز
                        </button>
                    }
                </div>

                <!-- Body -->
                <div class="card-body px-4">

                    @if (!CentersData.Any())
                    {
                        <div class="alert alert-warning text-center">
                            <h5>لا يوجد مراكز</h5>
                            <p class="mb-0">لم يتم إضافة مراكز حتى الآن</p>
                        </div>
                    }
                    else
                    {
                        <!-- Mobile Search -->
                        <div class="d-block d-md-none mb-2">
                            <input type="text" id="centerSearch" class="form-control shadow-sm" placeholder="ابحث هنا..." />
                        </div>

                        <!-- Mobile Cards -->
                        <div class="d-block d-md-none" id="centersCardsContainer" style="max-height:70vh; overflow-y:auto;">
                            @foreach (var center in CentersData)
                            {
                                <div class="card center-card mb-3 shadow-sm" data-name="@center.Name.ToLower()" data-supervisor="@center.ApplicationUserId.ToLower()">
                                    <div class="card-header text-white d-flex align-items-center" style="background: linear-gradient(135deg,#D8E983,#54C392,#15B392);">
                                        <i class="bi bi-building fs-4 ms-2"></i>
                                        <h6 class="fw-bold mb-0 text-truncate">@center.Name</h6>
                                    </div>
                                    <div class="card-body py-2">
                                        <div class="data-row d-flex justify-content-between">
                                            <span class="data-label">نوع المركز</span>
                                            <span class="fw-bold">@center.Type</span>
                                        </div>
                                        <div class="data-row d-flex justify-content-between">
                                            <span class="data-label">المسؤول</span>
                                            <span class="fw-bold">@userManager.FindByIdAsync(center.ApplicationUserId)?.Result?.FullName</span>
                                        </div>
                                        <div class="data-row d-flex justify-content-between">
                                            <span class="data-label">عدد المساجد</span>
                                            <span class="fw-bold">@center.Locations.Count()</span>
                                        </div>
                                    </div>
                                    <div class="card-footer d-flex justify-content-around">
                                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Centers.Edit).Result.Succeeded)
                                                {
                                                    <button class="btn fw-bold btn-outline-dark py-0 bg-transparent text-dark border-0 mx-1 fs-4" onclick="Edit('@center.Id','@center.Name','@center.Type','@center.Description','@center.ApplicationUserId')" data-bs-toggle="modal" data-bs-target="#centerModal">
                                                        <i class="bi bi-pencil-square fs-4"></i>
                                                    </button>
                                                }
                                                @if (AuthorizationService.AuthorizeAsync(User, Permissions.Centers.Pause).Result.Succeeded)
                                                {
                                                    if (center.PauseState > 0)
                                                    {
                                                        <button class="btn fw-bold btn-outline-dark py-0 bg-transparent text-dark border-0 mx-1 fs-4" onclick="Pause('@center.Id')">
                                                            <i class="bi bi-pause-circle fs-4"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn fw-bold btn-outline-success py-0 bg-transparent text-success border-0 mx-1 fs-4" onclick="Resume('@center.Id')">
                                                            <i class="bi bi-play-circle fs-4"></i>
                                                        </button>
                                                    }
                                                }
                                                @if (AuthorizationService.AuthorizeAsync(User, Permissions.Centers.Delete).Result.Succeeded)
                                                {
                                                    <button class="btn fw-bold btn-outline-dark py-0 bg-transparent text-dark border-0 mx-1 fs-4" onclick="Delete('@center.Id')">
                                                        <i class="bi bi-trash fs-4"></i>
                                                    </button>
                                                }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Desktop Table -->
                        <div class="d-none d-md-block table-responsive">
                            <table class="table table-bordered table-hover centers-table align-middle" id="tableCenter">
                                <thead class="bg-primary text-white">
                                    <tr>
                                         <th class="text-center text-white py-2 fs-5" style="background-color:#758A93; color:#fff; border-bottom:1px solid #5f7178;">الاسم</th>
                                         <th class="text-center text-white py-2 fs-5" style="background-color:#758A93; color:#fff; border-bottom:1px solid #5f7178;">نوع المركز</th>
                                        <th class="text-center text-white py-2 fs-5" style="background-color:#758A93; color:#fff; border-bottom:1px solid #5f7178;">مسؤول المركز</th>
                                        <th class="text-center text-white py-2 fs-5" style="background-color:#758A93; color:#fff; border-bottom:1px solid #5f7178;">عدد المساجد</th>
                                        <th class="text-center text-white py-2 fs-5" style="background-color:#758A93; color:#fff; border-bottom:1px solid #5f7178;">اجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var center in CentersData)
                                    {
                                        <tr>
                                            <td class="text-center">@center.Name</td>
                                            <td class="text-center">@center.Type</td>
                                            <td class="text-center">@userManager.FindByIdAsync(center.ApplicationUserId)?.Result?.FullName</td>
                                            <td class="text-center">@center.Locations.Count()</td>
                                            <td class="text-center">
                                                @if (AuthorizationService.AuthorizeAsync(User, Permissions.Centers.Edit).Result.Succeeded)
                                                {
                                                    <button class="btn fw-bold btn-outline-dark py-0 bg-transparent text-dark border-0 mx-1 fs-4" title="تعديل" onclick="Edit('@center.Id','@center.Name','@center.Type','@center.Description','@center.ApplicationUserId')" data-bs-toggle="modal" data-bs-target="#centerModal">
                                                        <i class="bi bi-pencil-square fs-4"></i>
                                                    </button>
                                                }
                                                @if (AuthorizationService.AuthorizeAsync(User, Permissions.Centers.Pause).Result.Succeeded)
                                                {
                                                    if (center.PauseState > 0)
                                                    {
                                                        <button class="btn fw-bold btn-outline-dark py-0 bg-transparent text-dark border-0 mx-1 fs-4" title="ايقاف" onclick="Pause('@center.Id')">
                                                            <i class="bi bi-pause-circle fs-4"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn fw-bold btn-outline-success py-0 bg-transparent text-success border-0 mx-1 fs-4" title="تشغيل" onclick="Resume('@center.Id')">
                                                            <i class="bi bi-play-circle fs-4"></i>
                                                        </button>
                                                    }
                                                }
                                                @if (AuthorizationService.AuthorizeAsync(User, Permissions.Centers.Delete).Result.Succeeded)
                                                {
                                                    <button class="btn fw-bold btn-outline-dark py-0 bg-transparent text-dark border-0 mx-1 fs-4" onclick="Delete('@center.Id')">
                                                        <i class="bi bi-trash fs-4"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</section>

<!-- Center Modal -->
<div class="modal fade shadow" id="centerModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered scrolled">
        <div class="modal-content" style="border-radius:14px;">

            <!-- Header -->
            <div class="modal-header text-white rounded-top-3"
                 style="border-radius:14px;background: linear-gradient(135deg,#0d6efd,#0AC4E0);">

                <h5 class="modal-title fw-bold" id="titleModal">
                    <i class="bi bi-building ms-2"></i>
                    @(Model.CenterVM.NewCenter.Id == null ? "إضافة مركز جديد" : "تعديل بيانات المركز")
                </h5>

               <a href="#" class="btn-close btn-close-white position-absolute start-0 mx-3"
                   data-bs-dismiss="modal" aria-label="Close"></a>

            </div>

            <!-- Body -->
            <form asp-action="Save" asp-controller="Centers" method="post" id="centerForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body bg-white align-items-center justify-content-center mt-3 rounded-4">

                    <input type="hidden" asp-for="CenterVM.NewCenter.Id" id="CenterId" />

                    <div class="form-group mb-3">
                            <label class="form-label fw-bold" for="CenterType">اسم المركز</label>
                        <input type="text" class="form-control" asp-for="CenterVM.NewCenter.Name" id="CenterName" placeholder="... أدخل اسم المركز" required />
                        <span asp-validation-for="CenterVM.NewCenter.Name" class="text-danger"></span>
                    </div>

                    @if (User.IsInRole(Roles.Admin.ToString()))
                    {
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold" for="CenterType">نوع المركز</label>
                            <select class="form-select" asp-for="CenterVM.NewCenter.Type" id="CenterType">
                                <option selected disabled>حدد نوع المركز</option>
                                <option value="men">مراكز رجال</option>
                                <option value="women">مراكز نساء</option>
                            </select>
                            <span asp-validation-for="CenterVM.NewCenter.Type" class="text-danger"></span>
                        </div>
                    }
                    else if (User.IsInRole(Roles.Supervisor.ToString()))
                    {
                        <input type="hidden" asp-for="CenterVM.NewCenter.Type" value="men" id="CenterType" />
                    }
                    else if (User.IsInRole(Roles.SupervisorWomen.ToString()))
                    {
                        <input type="hidden" asp-for="CenterVM.NewCenter.Type" value="women" id="CenterType" />
                    }

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold" for="Super">المسؤول</label>
                        <select class="form-select" asp-for="CenterVM.NewCenter.ApplicationUserId" asp-items="SupervisorsCenterData" id="Super" required>
                            <option selected disabled>حدد المسؤول</option>
                        </select>
                        <span asp-validation-for="CenterVM.NewCenter.ApplicationUserId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                         <label class="form-label fw-bold" for="">وصف المركز</label>
                        <textarea class="form-control" asp-for="CenterVM.NewCenter.Description" id="description" rows="4" placeholder="أدخل وصف المركز"></textarea>
                        <span asp-validation-for="CenterVM.NewCenter.Description" class="text-danger"></span>
                    </div>

                </div>

                <!-- Footer -->
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between flex-wrap gap-2 p-3 p-md-4">
                    <button type="submit" class="btn btn-success px-4 shadow-sm" id="btnSave">
                        <i class="bi bi-check-lg ms-1"></i> حفظ البيانات
                        <span class="btn-loading d-none">
                            <span class="spinner-border spinner-border-sm"></span> جاري الحفظ...
                        </span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg ms-1"></i> الغـاء
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Scripts -->
@section Scripts {
    <script src="~/js/Centers.js"></script>

    <script>
        // Search function for mobile cards
        document.getElementById('centerSearch')?.addEventListener('input', function () {
            const query = this.value.toLowerCase();
            const cards = document.querySelectorAll('#centersCardsContainer .center-card');

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || '';
                const supervisor = card.getAttribute('data-supervisor') || '';

                if (name.includes(query) || supervisor.includes(query)) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });

        function openCenterModal(url) {
            // Optional: AJAX modal load if needed
            const modal = new bootstrap.Modal(document.getElementById('centerModal'));
            modal.show();
        }

        function Rest() {
            document.getElementById('CenterName').value = '';
            document.getElementById('CenterType').value = '';
            document.getElementById('Super').selectedIndex = 0;
        }
    </script>

    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        if (Context.Session.GetString(Helper.MsgType) == Helper.Success)
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'success'
                });
            </script>
        }
        else
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'error'
                });
            </script>
        }
        Context.Session.SetString(Helper.MsgType, "");
    }

    <script>

        let lbTitleEditCenter = '@Html.Raw(ResourceApp_Ar.CentersModal_EditCenter_lbl)';
        let lbEdit = '@Html.Raw(ResourceApp_Ar.Modal_SaveEdit_btn)';
        let lbAddNewCenter = '@Html.Raw(@ResourceApp_Ar.CentersModal_AddNewCenter_lbl)';
        let lbbtnSave = '@Html.Raw(ResourceApp_Ar.Modal_Save_btn)';

        let lbTitleMsgDelete = '@Html.Raw("حذف المركز")';
        let lbTitleMsgPause = '@Html.Raw("إيقاف مؤقت للمركز !")';
        let lbTitleMsgResume = '@Html.Raw("اعادة تشغيل المركز")';
        let lbTitleMsgDeleteLog = '@Html.Raw("Delete CenterLog")';
        let lbTextMsgDelete = '@Html.Raw("هل تريد حذف المركز وكل الحلقات التابعة للمركز ؟ ")';
        let lbTextMsgPause = '@Html.Raw("سوف يتم ايقاف مؤقت لكل الحلقات التابعة للمركز ؟")';
        let lbTextMsgResume = '@Html.Raw("سوف يتم اعادة تشغيل لكل الحلقات التابعة للمركز ؟")';
        let lbTextMsgDeleteLog = '@Html.Raw("Are you sure to delete Center log ?")';
        let lbconfirmButtonText = '@Html.Raw("نعم , إحذف")';
        let lbconfirmButtonTextPause = '@Html.Raw("نعم , ايقاف مؤقت")';
        let lbconfirmButtonTextResume = '@Html.Raw("نعم , اعادة تشعيل")';
        let lbcancelButtonText = '@Html.Raw(ResourceApp_Ar.Modal_Cancle_btn)';

        let lbTitleDeletedOk = '@Html.Raw("تم الحذف")';
        let lbTitlePausedOk = '@Html.Raw("تم الإيقاف المؤقت")';
        let lbTitleResumedOk = '@Html.Raw("تم اعادة التشغيل")';
        let lbMsgDeletedOkCenter = '@Html.Raw("تم حذف المركز وما يحتويه من حلقات !")';
        let lbMsgPausedOkCenter = '@Html.Raw("تم الايقاف المؤقت للمركز وجميع الحلقات التابعة له !")';
        let lbMsgResumedOkCenter = '@Html.Raw("تم تشغيل المركز و الحلقات التابعة له")';
        let lbMsgDeletedOkCenterLog = '@Html.Raw("CenterLog is delete")';
        let lbSuccess = '@Html.Raw(Helper.Success)';

    </script>
   }
