@model MasterViewModel
@{
    ViewData["Title"] = "Lessons Of Plan";
}
<div class="wrapper" dir="rtl">
    <!--Content-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12">
                    <div class="card">
                        <div class="card-header">

                            <div class="row d-flex justify-content-center text-center">
                                <div class="col-sm-3 col-6 mb-2">
                                    <div class="card">
                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.SelectedPlanPage_MainHeader_PlanName_card</h6></div>
                                        <div class="card-body py-0"><h6 class="card-title">@Model.LevelVM.NewLevel.PlanData.Name</h6></div>
                                    </div>
                                </div>


                                <div class="col-sm-3 col-6">
                                    <div class="card">
                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.SelectedLevelPlanPage_MainHeader_LevelName_card</h6></div>
                                        <div class="card-body py-0"><h6 class="card-title">@Model.LevelVM.NewLevel.Name</h6></div>
                                    </div>
                                </div>
                                <div class="col-sm-3 col-6">
                                    <div class="card">
                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.SelectedPlanPage_SmallHeader_LessonsOfLevel_card</h6></div>
                                        <div class="card-body py-0"><h6 class="card-title">@Model.LevelVM.LessonsOfLevel.LessonsData.Count()</h6></div>
                                    </div>
                                </div>
                                <div class="col-sm-3 col-6">
                                    <div class="card">
                                        <div class="card-header py-0 bg-dark-subtle fw-bold"><h6>@ResourceApp_Ar.SelectedPlanPage_SmallHeader_StudentsLevel_card</h6></div>
                                        <div class="card-body py-0"><h6 class="card-title">@Model.LevelVM.StudentsOfLevel.Students.Count()</h6></div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="card-body  ">

                            <div class="row d-flex justify-content-center text-center">
                                <h2> دروس المستوي </h2>
                                @foreach (var lesson in Model.LevelVM.LessonsOfLevel.LessonsData)
                                {
                                    @if (lesson.Id != 0)
                                    {
                                        <div class="col-sm-3 col-12 mb-2">
                                            <div class="card">
                                                <div class="card-header bg-dark text-white fw-bold"><h6>درس | @lesson.Id</h6></div>
                                                <div class="card-body">
                                                    <span class="input-group-text bg-primary-subtle fw-bold">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_LessonSave_lbl</span>
                                                    <div class="d-flex">
                                                        <div class="input-group mb-1">
                                                            <span class="input-group-text ">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_Lesson_Start_lbl</span>
                                                            <input type="text" class="form-control bg-white" readonly value="@lesson.Save_FromSorh | @lesson.Save_FromAyah" />
                                                        </div>
                                                        <div class="input-group mb-1">
                                                            <span class="input-group-text ">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_Lesson_End_lbl</span>
                                                            <input type="text" class="form-control bg-white" readonly value="@lesson.Save_ToSorh | @lesson.Save_ToAyah" />
                                                        </div>
                                                    </div>
                                                    <span class="input-group-text bg-primary-subtle fw-bold">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_LessonRabt_lbl</span>
                                                    <div class="d-flex">
                                                        <div class="input-group mb-1">
                                                            <span class="input-group-text ">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_Lesson_Start_lbl</span>
                                                            <input type="text" class="form-control bg-white" readonly value="@lesson.Rabt_FromSorh | @lesson.Rabt_FromAyah" />
                                                        </div>
                                                        <div class="input-group mb-1">
                                                            <span class="input-group-text ">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_Lesson_End_lbl</span>
                                                            <input type="text" class="form-control bg-white" readonly value="@lesson.Rabt_ToSorh | @lesson.Rabt_ToAyah" />
                                                        </div>
                                                    </div>
                                                    <span class="input-group-text bg-primary-subtle fw-bold">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_LessonRev_lbl</span>
                                                    <div class="d-flex">
                                                        <div class="input-group mb-1">
                                                            <span class="input-group-text ">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_Lesson_Start_lbl</span>
                                                            <input type="text" class="form-control bg-white" readonly value="@lesson.Rev_FromSorh | @lesson.Rev_FromAyah" />
                                                        </div>
                                                        <div class="input-group mb-1">
                                                            <span class="input-group-text ">@ResourceApp_Ar.SelectedLevelPlanPage_SmallBody_Lesson_End_lbl</span>
                                                            <input type="text" class="form-control bg-white" readonly value="@lesson.Rev_ToSorh | @lesson.Rev_ToAyah" />
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="card-footer">
                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-danger-subtle fw-bold">@ResourceApp_Ar.SelectedPlanPage_SmallHeader_StudentsLevel_card</span>
                                                                <input type="text" class="form-control bg-white" readonly value="@lesson.Students.Count()" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                   

                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--End Content-->
    </div>
</div>

<script src="~/js/SelectedCenter.js"></script> 