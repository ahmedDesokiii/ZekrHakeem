@using ExpressTimezone
@inject IAuthorizationService AuthorizationService
@inject UserManager<ApplicationUser> userManager
@model MasterViewModel

@{
    ViewData["Title"] = "Episodes";
    var LocationsData = Model.EpisodeVM.LVM.Locations;
    var EpisodesData = Model.EpisodeVM.Episodes;
    int cNo = 0;
    var i = 0;
    var j = 0;

    var utcTime = DateTime.UtcNow;
    var currentTime = utcTime.UTCToRegionalTime("Asia/Riyadh").TimeOfDay;
    var epStartTime_Fajr = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.FajrTime).TimeOfDay;
    var epEndTime_Fajr = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.EndFajrTime).TimeOfDay;
    var epStartTime_Sunrise = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.SunriseTime).TimeOfDay;
    var epEndTime_Sunrise = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.EndSunriseTime).TimeOfDay;
    var epStartTime_Zohr = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.ZohrTime).TimeOfDay;
    var epEndTime_Zohr = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.EndZohrTime).TimeOfDay;
    var epStartTime_Asr = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.AsrTime).TimeOfDay;
    var epEndTime_Asr = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.EndAsrTime).TimeOfDay;
    var epStartTime_Mghrb = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.MghrbTime).TimeOfDay;
    var epEndTime_Mghrb = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.EndMghrbTime).TimeOfDay;
    var epStartTime_Isha = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.IshaTime).TimeOfDay;
    var epEndTime_Isha = Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI.EndIshaTime).TimeOfDay;
}

@if (User.IsInRole(Roles.Admin.ToString()))
{
    EpisodesData = Model.EpisodeVM.Episodes;
    LocationsData = Model.EpisodeVM.LVM.Locations;
}
else if (User.IsInRole(Roles.Supervisor.ToString()))
{
    EpisodesData = Model.EpisodeVM.EpisodesForMen;
    LocationsData = Model.EpisodeVM.LVM.LocationsForMen;
}

else if (User.IsInRole(Roles.SupervisorWomen.ToString()))
{
    EpisodesData = Model.EpisodeVM.EpisodesForWomen;
    LocationsData = Model.EpisodeVM.LVM.LocationsForWomen;
}

else if (User.IsInRole(Roles.SupervisorCenterMen.ToString()))
{
    EpisodesData = Model.EpisodeVM.EpisodesWithSupervisor;
    LocationsData = Model.EpisodeVM.LVM.LocationsWithSupervisor;
}

else if (User.IsInRole(Roles.SupervisorCenterWomen.ToString()))
{
    EpisodesData = Model.EpisodeVM.EpisodesWithSupervisor;
    LocationsData = Model.EpisodeVM.LVM.LocationsWithSupervisor;
}

else if (User.IsInRole(Roles.Teacher.ToString()))
{
    EpisodesData = Model.EpisodeVM.EpisodesWithTeacher;
}

else if (User.IsInRole(Roles.TeacherWomen.ToString()))
{
    EpisodesData = Model.EpisodeVM.EpisodesWithTeacher;

}


<div class="wrapper" dir="rtl">
    <!--Content-Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6 d-flex">
                    <h1 class="m-0 text-dark ms-5">@ResourceApp_Ar.EpisodesPage_EpisodesMain_lbl</h1>
                    <input hidden type="text" id="userLat">
                    <input hidden type="text" id="userLng">
                    <br>
                    <input hidden type="text" id="intimeEpLat" value="@Model.EpisodeVM.EpisodeInTime.EpLocation.Latitude">
                    <input hidden type="text" id="intimeEpLng" value="@Model.EpisodeVM.EpisodeInTime.EpLocation.Longitude">
                    <br>
                    <input hidden type="text" id="intimeEpId" value="@Model.EpisodeVM.EpisodeInTime.Id">
                </div>
            </div>
        </div>
    </div>
    <!--End Content-Header-->
    <!-- Main content -->
    <section class="content" dir="rtl">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header ">
                        <!-- Button trigger modal -->
                        @if (AuthorizationService.AuthorizeAsync(User, Permissions.Episodes.Create).Result.Succeeded)
                        {
                            <button type="button"
                                    class="btn btn-outline-primary rounded-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#exampleModal"
                                    onclick="Rest()"
                                    id="addEpisodeBtn">
                                <i class="bi bi-plus-circle-dotted fs-5 ps-2"></i> @ResourceApp_Ar.EpisodesPage_AddEpisode_btn
                            </button>
                        }

                        @if (User.IsInRole(Roles.Admin.ToString()) || User.IsInRole(Roles.Supervisor.ToString()) || User.IsInRole(Roles.SupervisorWomen.ToString()))
                        {
                            <div class="btn-group  position-absolute start-0 ms-4" dir="ltr" role="group" aria-label="Button group with nested dropdown">
                                <button type="button" class="btn btn-primary text-white">
                                    خدمات اخري <i class="bi bi-database-check text-white fs-5 ps-2"></i>
                                </button>
                                <div class="btn-group" role="group">
                                    <button id="btnGroupDrop1" type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></button>
                                    <div class="dropdown-menu" aria-labelledby="btnGroupDrop1">

                                        <a class="dropdown-item text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#prayerTimes">
                                            <i class="bi bi-watch fs-6 pe-2"></i> @ResourceApp_Ar.EpisodesPage_PrayerTimes_btn
                                        </a>
                                        <a class="dropdown-item text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#ListEpTypes">
                                            <i class="bi bi-border-width fs-6 pe-2"></i> @ResourceApp_Ar.EpisodesPage_EpisodeTypes_btn
                                        </a>
                                        @*  <a class="dropdown-item text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#AssignTeachersToEpisodes">
                                            <i class="bi bi-microsoft-teams fs-6 pe-2"></i> @ResourceApp_Ar.EpisodesPage_AssigningTeachers_btn
                                                </a> *@

                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- /.card-header -->

                    <div class="card-body" style="background: #FBF8EF;">

                        <!-- Tab links -->
                        <div class="tab" style="background: #CBF7DC;">
                            <button class="tablinks fw-bold fs-6" style="background: #CBF7DC;" onclick="openCity(event, 'Episodes')" id="defaultOpen">@ResourceApp_Ar.EpisodesPage_Episode_tab</button>
                            @if (User.IsInRole(Roles.Admin.ToString()))
                            {
                                <button class="tablinks fw-bold fs-6" style="background: #CBF7DC;" onclick="openCity(event, 'LogEpisodes')" id="defaultTow">Log Episodes</button>
                            }
                        </div>
                        <!-- Tab content -->
                        @if (!EpisodesData.Any())
                        {
                            <div class="alert  alert-warning mt-5">
                                <h4 class="alert-heading">No Episodes!</h4>
                                <p class="mb-0">No Episodes where added yet.</p>
                            </div>
                        }
                        else
                        {
                            @if (User.IsInRole(Roles.Teacher.ToString()) || User.IsInRole(Roles.TeacherWomen.ToString()))
                            {
                                <div class="align-content-center mt-2 align-items-center justify-content-center row " style="background: #FBF8EF;">

                                    @foreach (var episode in EpisodesData)
                                    {
                                        cNo++;
                                        <div class="col-sm-3  mb-3">
                                            <div class="card  text-center" style="background: #FBF8EF;">

                                                <img class="card-img-top bg-white" src="~/images/ep.svg" style="height:100px;width:auto" alt="zhcenter">
                                                <div class="card-header bg-dark fs-4 text-white fw-bold">@episode.Name</div>
                                                <div class="card-body w-100  ">

                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.teachersPage_teacherName_teachersTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.ApplicationUser.FullName" />
                                                    </div>
                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.EpisodesPage_episodeTime_EpisodesTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.Period" />
                                                    </div>
                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.EpisodesPage_epLocation_EpisodesTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.EpLocation.Name" />
                                                    </div>
                                                    <div class="input-group mb-1">
                                                        <span class="input-group-text bg-primary-subtle">@ResourceApp_Ar.EpisodesPage_StudentsCount_EpisodesTable</span>
                                                        <input type="text" class="form-control" readonly value="@episode.Students.Count() | @episode.LimitStudents " />
                                                    </div>
                                                    <div>
                                                        <input hidden id="epLat_@cNo" type="text" value="@episode.EpLocation.Latitude">
                                                        <input hidden id="epLng_@cNo" type="text" value="@episode.EpLocation.Longitude">
                                                        <input hidden id="epis_@cNo" type="text" value="@episode.Id">
                                                    </div>

                                                </div>
                                                <div class="card-footer bg-white d-flex ">

                                                    @if (episode.AttendType.Contains("عن بعد"))
                                                    {
                                                        if (episode.IsAvilable && !episode.Status && !episode.ManualFinished)
                                                        {
                                                            <a class="btn text-dark btn-sm col rounded-3" style="background-image: linear-gradient(to bottom right, #FBF8EF, #3F7D58);" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-file-slides ps-2 fs-4"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_Table
                                                            </a>
                                                        }
                                                        else if (episode.IsAvilable && episode.Status && !episode.ManualFinished)
                                                        {
                                                            <a class="btn text-dark btn-sm col rounded-3" style="background-image: linear-gradient(to bottom right, #FBF8EF, #FFB200 );" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-file-slides ps-2 fs-4"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_Continue
                                                            </a>
                                                        }
                                                        else if (episode.IsAvilable && episode.ManualFinished)
                                                        {
                                                            <a class="btn text-dark btn-sm col rounded-3 disabled" style="background-image: linear-gradient(to bottom right, #FBF8EF, #CB0404 );" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-file-slides ps-2 fs-4"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <input type="button" class="btn btn-outline-dark" disabled asp-action="SelectedEpisode" asp-route-Id="@episode.Id" value="@ResourceApp_Ar.EpisodesPage_DetailsBtn_Table" />
                                                        }
                                                    }
                                                    else if (episode.AttendType.Contains("حضوري"))
                                                    {
                                                        #region Dark [لم تبدأ بعد]
                                                        if (episode.Period.Contains(PrayerTimesPeriods.الفجر.ToString()) && (currentTime < epStartTime_Fajr))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الشروق.ToString()) && (currentTime < epStartTime_Sunrise))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الظهر.ToString()) && (currentTime < epStartTime_Zohr))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العصر.ToString()) && currentTime < epStartTime_Asr)
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.المغرب.ToString()) && (currentTime < epStartTime_Mghrb))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5 rounded-3"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العشاء.ToString()) && (currentTime < epStartTime_Isha))
                                                        {
                                                            <a class="btn btn-outline-info disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-dash-circle-dotted ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_NotStart
                                                            </a>
                                                        }
                                                        #endregion
                                                        #region Success [ابدأ الحلقة]
                                                        if (episode.IsAvilable && !episode.Status && !episode.ManualFinished && episode.Period == Model.EpisodeVM.EpisodeInTime.Period)
                                                        {
                                                            <a class="btn btn-success col btn-sm rounded-3" style="visibility:hidden" asp-action="SelectedEpisode" asp-controller="Episodes" asp-route-Id="@episode.Id" id="startepi_">
                                                                <i class="bi bi-fingerprint ps-2 fs-5"></i> @ResourceApp_Ar.EpisodesPage_DetailsBtn_Table
                                                            </a>
                                                        }
                                                        #endregion
                                                        #region Warning [حلقة مستمرة]
                                                        if (!episode.ManualFinished && episode.IsAvilable && episode.Status && episode.Period == Model.EpisodeVM.EpisodeInTime.Period)
                                                        {   
                                                            <a class="btn btn-warning col btn-sm rounded-3" style="visibility:hidden" asp-action="SelectedEpisode" asp-controller="Episodes" asp-route-Id="@episode.Id" id="startepi_">
                                                                <i class="bi bi-hourglass-split ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_Continue
                                                            </a>
                                                        }
                                                        #endregion
                                                        #region Danger_Manual [انهاء يدوي]

                                                        if (episode.Period.Contains(PrayerTimesPeriods.الفجر.ToString()) && episode.ManualFinished && currentTime > epStartTime_Fajr)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الشروق.ToString()) && episode.ManualFinished && currentTime > epStartTime_Sunrise)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الظهر.ToString()) && episode.ManualFinished && currentTime > epStartTime_Zohr)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العصر.ToString()) && episode.ManualFinished && currentTime > epStartTime_Asr)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.المغرب.ToString()) && episode.ManualFinished && currentTime > epStartTime_Mghrb)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العشاء.ToString()) && episode.ManualFinished && currentTime > epStartTime_Isha)
                                                        {
                                                            <a class="btn btn-danger disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_ManualFinish
                                                            </a>
                                                        }

                                                        #endregion
                                                        #region Danger_Auto [انهاء تلقائي]

                                                        if (episode.Period.Contains(PrayerTimesPeriods.الفجر.ToString()) && currentTime > epEndTime_Fajr && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الشروق.ToString()) && currentTime > epEndTime_Sunrise && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.الظهر.ToString()) && currentTime > epEndTime_Zohr && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العصر.ToString()) && currentTime > epEndTime_Asr && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.المغرب.ToString()) && currentTime > epEndTime_Mghrb && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }
                                                        else if (episode.Period.Contains(PrayerTimesPeriods.العشاء.ToString()) && currentTime > epEndTime_Isha && !episode.ManualFinished)
                                                        {
                                                            <a class="btn btn-outline-danger  disabled col btn-sm rounded-3" asp-action="SelectedEpisode" asp-route-Id="@episode.Id">
                                                                <i class="bi bi-ban-fill ps-2 fs-5"></i>@ResourceApp_Ar.EpisodesPage_DetailsBtn_AutoFinish
                                                            </a>
                                                        }

                                                        #endregion
                                                    }
                                                    
                                                    @if (AuthorizationService.AuthorizeAsync(User, Permissions.Episodes.Edit).Result.Succeeded)
                                                    {
                                                        <a class="btn btn-outline-warning p-2 btn-sm  rounded-3" onclick="Edit('@episode.Id', '@episode.Name','@episode.EpisodeTypeId','@episode.LimitStudents','@episode.Status','@episode.AttendType','@episode.Description','@episode.EpLocationId','@episode.ApplicationUserId','@episode.EpLocation.Latitude','@episode.EpLocation.Longitude','@episode.EpLocation.Type','@episode.Period')" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                                            <i class="bi bi-pencil-square fs-6 ps-2"></i>@ResourceApp_Ar.Page_EditBtn_Table
                                                        </a>
                                                    }

                                                    @if (AuthorizationService.AuthorizeAsync(User, Permissions.Episodes.Pause).Result.Succeeded)
                                                    {
                                                        if (episode.PauseState > 0)
                                                        {
                                                            <a id="pauseEpisode" class="btn btn-outline-dark btn-sm rounded-3" onclick="Pause('@episode.Id')">
                                                                <i class="bi bi-pause-circle fs-6 ps-2"></i> @ResourceApp_Ar.Page_PauseBtn_Table
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a id="pauseEpisode" class="btn btn-outline-success btn-sm rounded-3" onclick="Resume('@episode.Id')">
                                                                <i class="bi bi-play-circle fs-6 ps-2"></i>  @ResourceApp_Ar.Page_ResumeBtn_Table
                                                            </a>
                                                        }
                                                    }

                                                    @if (AuthorizationService.AuthorizeAsync(User, Permissions.Episodes.Delete).Result.Succeeded)
                                                    {
                                                        <a class="btn btn-danger p-2 btn-sm rounded-3" onclick="Delete('@episode.Id')">
                                                            <i class="bi bi-trash fs-6 ps-2"></i>@ResourceApp_Ar.Page_DeleteBtn_Table
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!User.IsInRole(Roles.Teacher.ToString()) || !User.IsInRole(Roles.TeacherWomen.ToString()))
                            {
                                <div id="Episodes" class="tabcontent ps-0 pe-0">
                                    <table id="tableEpisode" class="table-hover display w-100 p-2 table-bordered border-primary-subtle">
                                        <thead>
                                            <tr class="fw-bold">
                                                <td class="text-center bg-dark fs-5 text-white fw-bold py-2 px-0"></td>
                                                <td class="text-center bg-dark fs-5 text-white fw-bold py-2 px-0">@ResourceApp_Ar.EpisodesPage_episodeName_EpisodesTable<br>[@ResourceApp_Ar.teachersPage_teacherName_teachersTable]</td>
                                                
                                                <td class="text-center bg-dark fs-5 text-white fw-bold py-2 px-0">@ResourceApp_Ar.EpisodesPage_epLocation_EpisodesTable<br>[موعد الحلقة]</td>
                                                <td class="text-center bg-dark fs-5 text-white fw-bold py-2 px-0"></td>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var episode in EpisodesData)
                                            {
                                                cNo++;

                                                <tr>
                                                    <td class="text-center p-1 fw-bold"><img src="~/images/ep.svg" alt="dis" height="35"><br>@cNo </td>
                                                    <td class="text-center p-1">
                                                        <span class="fs-6 fw-bold">@episode.Name</span>
                                                        <br>
                                                        @episode.Students.Count() <span class="text-danger fw-bold">|</span> @episode.LimitStudents
                                                        <br>
