    <section class="content" dir="rtl">
        <input type="text" id="totStus" hidden readonly value="@Model.EpisodeVM.StudentsVM.Students.Count" />
        @if (Model.EpisodeVM.NewEpisode.Period == null)
        { }
        else if (Model.EpisodeVM.NewEpisode.Period.Contains(PrayerTimesPeriods.الفجر.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI?.EndFajrTime)" />
        }
        else if (Model.EpisodeVM.NewEpisode.Period.Contains(PrayerTimesPeriods.الظهر.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI?.EndZohrTime)" />
        }
        else if (Model.EpisodeVM.NewEpisode.Period.Contains(PrayerTimesPeriods.العصر.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI?.EndAsrTime)" />
        }
        else if (Model.EpisodeVM.NewEpisode.Period.Contains(PrayerTimesPeriods.المغرب.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI?.EndMghrbTime)" />
        }
        else if (Model.EpisodeVM.NewEpisode.Period.Contains(PrayerTimesPeriods.العشاء.ToString()))
        {
            <input Id="epEndTime" hidden type="text" value="@Convert.ToDateTime(Model.EpisodeVM.PrayerTimesAPI?.EndIshaTime)" />
        }

        <div class="d-flex">
            @if (!User.IsInRole(Roles.Teacher.ToString()) || !User.IsInRole(Roles.TeacherWomen.ToString()))
            {
                @if (Model?.EpisodeVM.NewEpisode?.Status == true)
                {
