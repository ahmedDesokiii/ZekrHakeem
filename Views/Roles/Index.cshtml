@{
    ViewData["Title"] = "المجموعات والصلاحيات";
}

<section class="zh-page">
    <div class="zh-container">
        <div class="zh-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="zh-crumb"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left"></i><span>الإدارة</span></div>
                <h1><i class="bi bi-shield-lock-fill ms-2"></i>المجموعات والصلاحيات</h1>
                <p>كل مجموعة تحدد ما يستطيع أعضاؤها رؤيته وفعله. أي تعديل يُطبّق فورًا على المستخدمين المتصلين.</p>
                <span class="zh-live-pill mt-3 off" id="liveState"><span class="zh-pulse-dot"></span><span>جارٍ الاتصال…</span></span>
            </div>
            <div class="zh-hero-actions">
                <a class="zh-btn zh-btn-glass" asp-controller="Users" asp-action="Index" data-cap="Users.View" hidden><i class="bi bi-people"></i> المستخدمين</a>
                <button class="zh-btn zh-btn-gold" id="btnAddRole" type="button" data-cap="Roles.Create" hidden><i class="bi bi-plus-circle-fill"></i> مجموعة جديدة</button>
            </div>
        </div>

        <div class="zh-card zh-toolbar">
            <div class="zh-search">
                <i class="bi bi-search"></i>
                <input class="zh-input" id="q" type="search" placeholder="ابحث عن مجموعة…" />
            </div>
            <div class="zh-muted fw-bold" id="rolesSummary"></div>
        </div>

        <div class="zh-grid" id="roles" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))"></div>
    </div>
</section>

<div class="zh-drawer-backdrop" id="drawerBackdrop"></div>

<!-- Role form -->
<aside class="zh-drawer" id="roleDrawer" aria-hidden="true">
    <div class="zh-drawer-head">
        <h3 id="roleFormTitle">مجموعة جديدة</h3>
        <button class="zh-btn zh-btn-ghost zh-btn-icon" data-close><i class="bi bi-x-lg"></i></button>
    </div>
    <form class="zh-drawer-body zh-scroll" id="roleForm" autocomplete="off">
        <input type="hidden" name="id" />
        <div id="roleErrors"></div>

        <div class="zh-card zh-role-card mb-4" id="rolePreview" style="--c:#15B392;animation:none">
            <div class="d-flex align-items-center gap-3"><span class="ri"><i class="bi bi-people-fill"></i></span>
                <div><h4 data-p="name">اسم المجموعة</h4><code data-p="code">RoleName</code></div></div>
        </div>

        <div class="zh-field">
            <label class="zh-label">الاسم بالعربية <span class="req">*</span></label>
            <input class="zh-input" name="nameAr" maxlength="150" placeholder="مثال: مدير مركز" />
        </div>
        <div class="zh-field">
            <label class="zh-label">الاسم البرمجي (إنجليزي) <span class="req">*</span></label>
            <input class="zh-input zh-ltr" name="name" maxlength="100" placeholder="CenterManager" />
            <div class="zh-hint">يُستخدم داخل النظام — حروف إنجليزية وأرقام بدون مسافات.</div>
        </div>
        <div class="zh-field">
            <label class="zh-label">الوصف</label>
            <textarea class="zh-textarea" name="description" rows="2" maxlength="400"></textarea>
        </div>
        <div class="zh-field">
            <label class="zh-label">اللون</label>
            <div class="zh-color-pick" id="colorPick"></div>
        </div>
        <div class="zh-field">
            <label class="zh-label">الأيقونة</label>
            <div class="zh-icon-pick" id="iconPick"></div>
        </div>
        <div class="zh-field" id="copyFromBlock">
            <label class="zh-label">نسخ الصلاحيات من مجموعة</label>
            <select class="zh-select" name="copyFromRoleId"><option value="">— بدون —</option></select>
        </div>
        <label class="zh-switch">
            <input type="checkbox" name="isDefaultForRegistration" />
            <span class="track"></span>
            <span>المجموعة الافتراضية للمستخدمين الجدد عند التسجيل</span>
        </label>
    </form>
    <div class="zh-drawer-foot">
        <button class="zh-btn zh-btn-light" data-close type="button">إلغاء</button>
        <button class="zh-btn zh-btn-primary" id="btnSaveRole" type="button"><i class="bi bi-check2-circle"></i> حفظ</button>
    </div>
</aside>

<!-- Role members -->
<aside class="zh-drawer" id="membersDrawer" aria-hidden="true">
    <div class="zh-drawer-head">
        <h3 id="membersTitle">أعضاء المجموعة</h3>
        <button class="zh-btn zh-btn-ghost zh-btn-icon" data-close><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="zh-drawer-body zh-scroll" id="membersBody"></div>
</aside>

@section Scripts {
    <script>window.ZH_ROLES = { permissionsUrl: '@Url.Action("Permissions", "Roles")', usersUrl: '@Url.Action("Index", "Users")' };</script>
    <script src="~/js/zh-admin-common.js" asp-append-version="true"></script>
    <script src="~/js/zh-roles-admin.js" asp-append-version="true"></script>
}
