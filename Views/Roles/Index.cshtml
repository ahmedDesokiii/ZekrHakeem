@model MasterViewModel

@{
    ViewData["Title"] = "Roles";
    int cNo = 0;
}

<div class="wrapper">
    <!--Content-Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">Roles</h1>
                </div>
            </div>
        </div>
    </div>
    <!--End Content-Header-->
    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-start">
                        <div class="card-tools ">
                            <!-- Button trigger modal -->
                           
                                <button type="button" style="margin-left:20px"class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                                    Add Role
                                </button>

                        </div>
                    </div>
                    <!-- /.card-header -->

                    <div class="card-body">
                        <!-- Tab links -->
                        <div class="tab">
                            <button class="tablinks" onclick="openCity(event, 'Roles')" id="defaultOpen">Roles</button>
                        </div>
                        <!-- Tab content -->
                        @if (!Model.RoleVM.Any())
                        {
                            <div class="alert  alert-warning mt-5">
                                <h4 class="alert-heading">No Roles!</h4>
                                <p class="mb-0">No roles where added yet.</p>
                            </div>
                        }
                        else
                        {
                            <div id="Roles" class="tabcontent">
                                <table class="table table-hover mt-4" id="tableRole">
                                    <thead>
                                        <tr class="bg-primary text-white ">
                                            <th></th>
                                            <th>Role Name</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var role in Model.RoleVM)
                                        {
                                            cNo++;
                                            <tr>
                                                <td style="text-align:center">@cNo</td>
                                                <td>@role.Name</td>

                                                <td>
                                                    <a class="btn btn-warning" asp-action="ManagePermissions" asp-route-roleId="@role.Id">Permissions</a>
                                                    <input type="button" class="btn btn-info" onclick="Edit('@role.Id', '@role.Name',)" value="Edit" data-bs-toggle="modal" data-bs-target="#exampleModal" />
                                                    <input type="button" class="btn btn-danger" onclick="Delete('@role.Id')" value="Delete" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
    <!-- /.content -->
</div>



<partial name="AddRole" model="new RoleFormViewModel()" />

@section Scripts {
    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        if (Context.Session.GetString(Helper.MsgType) == Helper.Success)
        {
            <script>
                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'success'
                    
                });
            </script>

        }
        else
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'warning'
                    
                });
            </script>
        }
        Context.Session.SetString(Helper.MsgType, "");
    }

    <script src="~/js/Roles.js"></script>


    <script>

        let lbTitleEdit = '@Html.Raw("Edit Role")';
        let lbEdit = '@Html.Raw("Save Changes")';
        let lbAddNewRole = '@Html.Raw("Add New Role")';
        let lbbtnSave = '@Html.Raw("Add Role")';

        let lbTitleMsgDelete = '@Html.Raw("Delete")';
        let lbTextMsgDelete = '@Html.Raw($"Are you sure delete role ? ")';
        let lbconfirmButtonText = '@Html.Raw("Yes , Delete it")';
        let lbcancelButtonText = '@Html.Raw("Cancle")';

        let lbTitleDeletedOk = '@Html.Raw("Done")';
        let lbMsgDeletedOkRole = '@Html.Raw("Role Deleted Successfully")';
        let lbSuccess = '@Html.Raw(Helper.Success)';

    </script>
}