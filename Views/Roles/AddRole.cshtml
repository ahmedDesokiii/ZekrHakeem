@model RoleFormViewModel


<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog card card-success card-outline">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="title"></h5>
                <a href="#" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></a>
            </div>
            <div class="modal-body">
                <form asp-action="AddRole" asp-controller="Roles" method="post">
                    <div class="form-group mb-3">
                        <input type="text" hidden class="form-control" asp-for="RoleId" id="roleId" />
                        <input  class="form-control" asp-for="Name" id="roleName" placeholder="Role name ..."/>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="modal-footer" style="padding:0 15px 15px 0">
                        <input type="submit" class="btn btn-success" value="Save changes" id="btnSave" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

