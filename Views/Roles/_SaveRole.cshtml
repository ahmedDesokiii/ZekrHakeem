@model MasterViewModel

<div class="modal fade shadow" id="exampleModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered scrolled">
        <div class="modal-content" style="border-radius:14px;">

            <!-- Header -->
            <div class="modal-header text-white rounded-top-3"
                 style="border-radius:14px;background: linear-gradient(135deg,#0d6efd,#0AC4E0);">

                <h5 class="modal-title fw-bold" id="modalTitle">
                    <i class="bi bi-box-fill ms-2"></i>
                    @(Model.AddRoleVM.RoleId == null ? " إضافة مجموعة جديدة" : "تعديل بيانات المجموعة")
                </h5>

                <a href="#"
                   class="btn-close btn-close-white position-absolute start-0 mx-3"
                   data-bs-dismiss="modal"></a>

            </div>

            <form asp-action="AddRole"
                  asp-controller="Roles"
                  method="post"
                  id="roleForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <!-- Body -->
                <div class="modal-body bg-white align-items-center justify-content-center mt-3 rounded-4">

                    <div class="form-group mb-3">

                        <input type="hidden"
                               class="form-control"
                               asp-for="AddRoleVM.RoleId"
                               id="roleId" />

                        <label class="form-label fw-bold" for="CenterType">اسم المجموعة</label>
                        <input class="form-control"
                               asp-for="AddRoleVM.Name"
                               id="roleName"
                               placeholder=" ... أدخل اسم المجموعة" />

                        <span asp-validation-for="AddRoleVM.Name"
                              class="text-danger"></span>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between flex-wrap gap-2 p-3 p-md-4">

                    <button type="submit"
                            class="btn btn-success px-4 shadow-sm"
                            id="btnSave">

                        <i class="bi bi-check-lg ms-1"></i>
                        حفظ البيانات

                        <span class="btn-loading d-none">
                            <span class="spinner-border spinner-border-sm"></span>
                            جاري الحفظ...
                        </span>

                    </button>


                    <button type="button"
                            class="btn btn-outline-secondary px-4 shadow-sm"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-lg ms-1"></i>
                        الغـاء

                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
